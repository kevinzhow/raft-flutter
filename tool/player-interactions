#!/usr/bin/env python3
"""Host runner of the Android player interaction suite.

  tool/player-interactions --serial emulator-5600 --media /tmp/player-streaming/media --out /tmp/player-streaming/run1 [--build] [--only <name part>]

Starts tool/video-parity-range-server on the media directory, `adb reverse`s its port to the device, builds (with
--build) and drives apps/raft_flutter/integration_test/player_interactions_test.dart on the isolated app
`app.raft.raft_flutter.linkperf` (never the real app), and does for the test what a test on the device cannot:
Android's back key and back swipe, screen recordings of the close animation, the system save dialog. See
docs/media-playback.md. Kills only the processes it started.
"""
import argparse, json, os, re, shutil, signal, subprocess, sys, threading, time, urllib.request
import xml.etree.ElementTree as ET
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
APP = ROOT / 'apps/raft_flutter'
TARGET = 'integration_test/player_interactions_test.dart'
APK = APP / 'build/app/outputs/flutter-apk/app-profile.apk'
PACKAGE = 'app.raft.raft_flutter.linkperf'


# Every file of --media that a scenario asks for (the test checks the same list at its start).
REQUIRED_MEDIA = (['portrait.mp4', 'landscape.mp4', 'hevc1080.mp4', 'hevc4k.mp4', 'long.mp4', 'corrupt.mp4',
                   'portrait-hlg.mp4', 'long-hlg.mp4', 'tone.wav'] + [f'photo{n}.jpg' for n in range(1, 13)])


class Host:
    def __init__(self, serial, port, out, record='on'):
        self.serial, self.port, self.out = serial, port, out
        # 'on' records the screen; 'off' skips recordings (the encoder costs the emulator frames, so a run that measures
        # frame by frame turns it off); 'WxH' records at that size (a cheaper encode).
        self.record = record
        self.recorder = None
        self.recording = None
        self.stop = False
        self.log = open(out / 'host.log', 'a')
        self.started = False  # the first command came: the app runs a scenario
        self.watched, self.away = 0.0, None

    def adb(self, *args, check=True, **kw):
        return subprocess.run(['adb', '-s', self.serial, *args], capture_output=True, text=True, check=check, **kw)

    def say(self, text):
        self.log.write(f'{time.strftime("%H:%M:%S")} {text}\n'); self.log.flush()

    def url(self, path):
        return f'http://127.0.0.1:{self.port}{path}'

    def get(self, path):
        with urllib.request.urlopen(self.url(path), timeout=5) as r:
            return json.load(r)

    def size(self):
        out = self.adb('shell', 'wm', 'size').stdout
        m = re.search(r'(\d+)x(\d+)', out.splitlines()[-1])
        return int(m[1]), int(m[2])

    def record_start(self, name):
        if self.record == 'off':
            return 'recording-off'
        remote = f'/sdcard/pi-{name}.mp4'
        self.recording = (name, remote)
        size = ['--size', self.record] if re.fullmatch(r'\d+x\d+', self.record) else []
        self.recorder = subprocess.Popen(['adb', '-s', self.serial, 'shell', 'screenrecord', '--time-limit', '25',
                                          '--bit-rate', '8000000', *size, remote], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(0.8)
        return 'recording'

    def record_stop(self):
        if not self.recording:
            return 'none'
        name, remote = self.recording
        self.recording = None
        # Stops only the recorder of this device (a process on the emulator, not on the host).
        self.adb('shell', 'pkill', '-INT', 'screenrecord', check=False)
        if self.recorder:
            try:
                self.recorder.wait(timeout=10)
            except subprocess.TimeoutExpired:
                self.recorder.kill()
            self.recorder = None
        time.sleep(0.5)
        target = self.out / f'{name}.mp4'
        self.adb('pull', remote, str(target), check=False)
        self.adb('shell', 'rm', '-f', remote, check=False)
        return f'pulled:{target.name}'

    def swipe_back(self):
        w, h = self.size()
        # From the left screen edge towards the middle: the system back gesture.
        self.adb('shell', 'input', 'swipe', '2', str(h // 2), str(int(w * .6)), str(h // 2), '350')
        return 'swiped'

    def tap(self, x, y, count=1):
        """A real touch tap through Android's input stack (physical pixels); count 2 is a double tap."""
        one = f'input tap {x} {y}'
        self.adb('shell', '; '.join([one] * count))
        return f'tapped:{x},{y}x{count}'

    def touch_device(self):
        """The kernel input node of the emulator's multi-touch screen (`getevent -pl`: virtio_input_multi_touch_1)."""
        out = self.adb('shell', 'getevent', '-pl').stdout
        for block in out.split('add device')[1:]:
            if 'virtio_input_multi_touch_1' in block:
                m = re.search(r'(/dev/input/event\d+)', block)
                if m:
                    return m[1]
        raise RuntimeError('no multi-touch input device')

    def pinch(self, variant, cx, cy, ratio):
        """Two real fingers through the kernel input stack: `struct input_event`s (multi-touch protocol B) written to the
        emulator's touch device node, the same write `sendevent` does, but all through ONE process so the frames keep their
        pace (one `sendevent` process per event takes ~100 ms on the emulator, which is slow enough to turn a drift into a
        long press). No Flutter-side events. Positions are device pixels; dp offsets use the display ratio. Variants:
          simultaneous  both fingers land in one frame at +-20 dp and spread 60 dp each, evenly.
          late-drift    finger A lands, drifts 6 dp left (inside the 8 dp touch slop), the second lands 80 ms later; A then does
                        most of the work (-40 dp, B +12 dp).
          late-committed  as late-drift but A drifts 12 dp (past the touch slop): the page drag has already won, so no zoom is
                        expected; the pager must settle on a page and answer the next swipe.
          asymmetric    A lands, B 60 ms later; A stays still, B moves 40 dp outward.
          vertical      A lands, B 60 ms later (above / below the centre); B moves 60 dp down."""
        import struct
        w, h = self.size()
        dev = self.touch_device()
        dp = lambda v: v * ratio
        frames = []  # (ms to wait before the frame, [(type, code, value), ...])
        cur = []
        def put(t, c, v):
            cur.append((t, c, v))
        def sync(wait=0):
            nonlocal cur
            put(0, 0, 0)
            frames.append((wait, cur))
            cur = []
        def finger(slot, tid, x, y, down=False):
            put(3, 47, slot)  # ABS_MT_SLOT
            if down:
                put(3, 57, tid)  # ABS_MT_TRACKING_ID
                put(3, 58, 400)  # ABS_MT_PRESSURE
                put(3, 48, 6)    # ABS_MT_TOUCH_MAJOR
            put(3, 53, int(x * 32767 / w))
            put(3, 54, int(y * 32767 / h))
        def lift(slot):
            put(3, 47, slot)
            put(3, 57, 0xFFFFFFFF)
        if variant != 'vertical':
            a0, b0 = (cx - dp(20), cy), (cx + dp(20), cy)
        else:
            a0, b0 = (cx, cy - dp(20)), (cx, cy + dp(20))
        pos = {0: list(a0), 1: list(b0)}
        STEP = 8  # ms between move frames, like a 120 Hz panel
        def glide(plan, steps):
            """plan: {slot: (dx, dy)} total over `steps` frames."""
            for _ in range(steps):
                for slot, (dx, dy) in plan.items():
                    pos[slot][0] += dx / steps; pos[slot][1] += dy / steps
                    finger(slot, 0, *pos[slot])
                sync(STEP)
        if variant == 'simultaneous':
            finger(0, 1, *a0, down=True); finger(1, 2, *b0, down=True); put(1, 330, 1); sync()
            glide({0: (-dp(60), 0), 1: (dp(60), 0)}, 12)
        elif variant in ('late-drift', 'late-committed'):
            finger(0, 1, *a0, down=True); put(1, 330, 1); sync()
            glide({0: (-dp(6 if variant == 'late-drift' else 12), 0)}, 4)
            finger(1, 2, *b0, down=True); sync(80)
            glide({0: (-dp(40), 0), 1: (dp(12), 0)}, 10)
        elif variant == 'asymmetric':
            finger(0, 1, *a0, down=True); put(1, 330, 1); sync()
            finger(1, 2, *b0, down=True); sync(60)
            glide({1: (dp(40), 0)}, 10)
        elif variant == 'vertical':
            finger(0, 1, *a0, down=True); put(1, 330, 1); sync()
            finger(1, 2, *b0, down=True); sync(60)
            glide({1: (0, dp(60))}, 10)
        else:
            return f'error:unknown pinch variant {variant}'
        lift(0); sync(40)
        lift(1); put(1, 330, 0); sync(STEP)
        (self.out / f'pinch-{variant}.events.txt').write_text(
            '\n'.join(f'+{wait}ms ' + ' '.join(f'{t}:{c}:{v}' for t, c, v in evs) for wait, evs in frames) + '\n')
        proc = subprocess.Popen(['adb', '-s', self.serial, 'exec-in', f'cat > {dev}'], stdin=subprocess.PIPE,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        started = time.time()
        try:
            for wait, evs in frames:
                time.sleep(wait / 1000)
                proc.stdin.write(b''.join(struct.pack('<qqHHI', 0, 0, t, c, v) for t, c, v in evs))
                proc.stdin.flush()
        finally:
            proc.stdin.close()
            proc.wait(timeout=10)
        return f'pinched:{variant}:{time.time() - started:.2f}s'

    def swipe(self, x1, y1, x2, y2, ms):
        """One real finger through Android's input stack (`input swipe`, physical pixels)."""
        self.adb('shell', 'input', 'swipe', str(x1), str(y1), str(x2), str(y2), str(ms))
        return 'swiped'

    def rotate(self, quarter):
        """Locks the display to portrait (0) or landscape (1) like turning the phone."""
        self.adb('shell', 'settings', 'put', 'system', 'accelerometer_rotation', '0')
        self.adb('shell', 'settings', 'put', 'system', 'user_rotation', str(quarter))
        time.sleep(1.5)
        return f'rotated:{quarter}'

    def save_dialog(self, name):
        """Taps Save in the system document picker, then reports the size of the saved file."""
        deadline = time.time() + 45
        pushed = False
        while time.time() < deadline:
            self.adb('shell', 'uiautomator', 'dump', '/sdcard/pi-ui.xml', check=False)
            xml = self.adb('shell', 'cat', '/sdcard/pi-ui.xml', check=False).stdout
            try:
                tree = ET.fromstring(xml)
            except ET.ParseError:
                time.sleep(0.5); continue
            for node in tree.iter('node'):
                rid, text = node.get('resource-id', ''), node.get('text', '')
                if rid == 'android:id/button1' or (node.get('clickable') == 'true' and text.upper() == 'SAVE'):
                    m = re.findall(r'\d+', node.get('bounds', ''))
                    x, y = (int(m[0]) + int(m[2])) // 2, (int(m[1]) + int(m[3])) // 2
                    self.adb('shell', 'input', 'tap', str(x), str(y))
                    pushed = True
                    break
            if pushed:
                break
            time.sleep(0.5)
        if not pushed:
            return 'no-dialog'
        for _ in range(60):
            out = self.adb('shell', 'stat', '-c', '%s', f'/sdcard/Download/{name}', check=False).stdout.strip()
            if out.isdigit() and int(out) > 0:
                time.sleep(1)
                out = self.adb('shell', 'stat', '-c', '%s', f'/sdcard/Download/{name}', check=False).stdout.strip()
                self.adb('shell', 'rm', '-f', f'/sdcard/Download/{name}', check=False)
                return f'saved:{out}'
            time.sleep(0.5)
        return 'not-saved'

    def shot(self, name):
        """A screenshot of the device (what a person sees), saved next to the logs."""
        data = subprocess.run(['adb', '-s', self.serial, 'exec-out', 'screencap', '-p'], capture_output=True).stdout
        (self.out / f'{name}.png').write_bytes(data)
        return f'shot:{name}.png'

    def bars(self):
        """Whether the status and navigation bars are visible, read from `dumpsys window displays`.

        The display's insets state follows what the focused app window asked for (the source `visible` flag is false while the
        app hides a bar). The viewer never hides them: the scenarios assert both stay shown. The dump is kept next to the logs."""
        text = self.adb('shell', 'dumpsys', 'window', 'displays', check=False).stdout
        (self.out / 'bars-last.txt').write_text(text)
        found = {}
        for kind in ('statusBars', 'navigationBars'):
            m = re.search(r'InsetsSource id=\S+ type=' + kind + r' frame=\S+ visible=(true|false)', text)
            if not m:
                return 'bars:unknown'
            found[kind] = 'shown' if m[1] == 'true' else 'hidden'
        return f'bars:status={found["statusBars"]},nav={found["navigationBars"]}'

    def meminfo(self, label):
        """Saves `dumpsys meminfo` of the isolated app and returns the numbers that matter (KB)."""
        text = self.adb('shell', 'dumpsys', 'meminfo', PACKAGE, check=False).stdout
        (self.out / f'meminfo-{label}.txt').write_text(text)
        def grab(pattern):
            m = re.search(pattern, text)
            return m.group(1) if m else '?'
        # The decoders of the emulator run in media processes of their own: their RSS shows what the app's meminfo cannot.
        ps = self.adb('shell', 'ps', '-A', '-o', 'RSS,NAME', check=False).stdout
        media = sum(int(m.group(1)) for m in re.finditer(r'^\s*(\d+)\s+\S*(?:media\.swcodec|media\.codec|mediaserver|android\.hardware\.media|mediaextractor)\S*\s*$', ps, re.M))
        return ';'.join([
            'mediaprocs_rss=' + str(media),
            'pss=' + grab(r'TOTAL PSS:\s+(\d+)'),
            'dalvik_alloc=' + grab(r'Dalvik Heap\s+(?:\d+\s+){6}(\d+)'),
            'graphics=' + grab(r'Graphics:\s+(\d+)'),
            'native=' + grab(r'Native Heap:\s+(\d+)'),
            'gl=' + grab(r'GL mtrack:\s+(\d+)'),
            'egl=' + grab(r'EGL mtrack:\s+(\d+)'),
        ])

    def audio(self):
        """How many players of the isolated app are `started` in `dumpsys audio` (audible playback)."""
        pid = self.adb('shell', 'pidof', PACKAGE, check=False).stdout.strip().split()
        if not pid:
            return 'started=0 pid=none'
        text = self.adb('shell', 'dumpsys', 'audio', check=False).stdout
        started = [l for l in text.splitlines() if 'AudioPlaybackConfiguration' in l and re.search(r'u/pid:\d+/' + pid[0] + r'\b', l) and 'state:started' in l]
        return f'started={len(started)} pid={pid[0]}'

    def background(self, seconds):
        """The app goes to the background (home), stays there, and comes back to the front."""
        # Another app in front (Settings), then Back: the same task and process come back.
        self.adb('shell', 'am', 'start', '-a', 'android.settings.SETTINGS')
        time.sleep(seconds)
        self.adb('shell', 'input', 'keyevent', 'KEYCODE_BACK')
        time.sleep(1.5)
        return f'backgrounded:{seconds}'

    def focused(self):
        out = self.adb('shell', 'dumpsys window | grep -E "mCurrentFocus"', check=False).stdout
        return PACKAGE in out

    def clean(self):
        """The device as every scenario starts it: no recording running, no system dialog, the app in front.

        An earlier scenario that failed halfway can leave any of those behind, and the next one would fail on them."""
        notes = []
        if self.recording:
            notes.append(self.record_stop())
        self.adb('shell', 'am', 'force-stop', 'com.google.android.documentsui', check=False)
        if not self.focused():
            self.adb('shell', 'monkey', '-p', PACKAGE, '-c', 'android.intent.category.LAUNCHER', '1', check=False)
            notes.append('foregrounded')
            deadline = time.time() + 15
            while time.time() < deadline and not self.focused():
                time.sleep(0.3)
            time.sleep(1)
            if not self.focused():
                return 'clean-error:the app is not in front'
        return 'clean' + (':' + ','.join(notes) if notes else '')

    def watchdog(self):
        """Brings the app back when it has been out of the front for 6 s with no command running.

        A key or gesture that takes the app away (Back on its last route) stops its frames, and a scenario waiting for
        one never gets its own timeout: the suite would hang. In front again the scenario fails on its timeout and
        the next one starts clean. Only the host commands that send the app away on purpose (`background:`, the save
        dialog) run inside `run`, never at the same time as this check."""
        now = time.time()
        if now - self.watched < 2:
            return
        self.watched = now
        if self.focused():
            self.away = None
        elif self.away is None:
            self.away = now
        elif now - self.away > 6:
            self.say('watchdog: the app was out of the front for 6 s with no command running; bringing it back')
            self.adb('shell', 'monkey', '-p', PACKAGE, '-c', 'android.intent.category.LAUNCHER', '1', check=False)
            self.away = None

    def run(self):
        while not self.stop:
            try:
                state = self.get('/__cmd?poll')
            except Exception:
                time.sleep(0.3); continue
            command = state.get('pending')
            if not command:
                if self.started:
                    self.watchdog()
                time.sleep(0.1); continue
            self.started = True
            self.say(f'command {command}')
            try:
                if command.startswith('record-start:'):
                    result = self.record_start(command.split(':', 1)[1])
                elif command == 'record-stop':
                    result = self.record_stop()
                elif command == 'back':
                    self.adb('shell', 'input', 'keyevent', 'KEYCODE_BACK'); result = 'back'
                elif command.startswith('tap:') or command.startswith('double-tap:'):
                    kind, at = command.split(':', 1)
                    x, y = (int(float(v)) for v in at.split(','))
                    result = self.tap(x, y, 2 if kind == 'double-tap' else 1)
                elif command.startswith('swipe:'):
                    x1, y1, x2, y2, ms = (int(float(v)) for v in command.split(':', 1)[1].split(','))
                    result = self.swipe(x1, y1, x2, y2, ms)
                elif command.startswith('pinch:'):
                    _, variant, at = command.split(':', 2)
                    cx, cy, ratio = (float(v) for v in at.split(','))
                    result = self.pinch(variant, cx, cy, ratio)
                elif command.startswith('rotate:'):
                    result = self.rotate(int(command.split(':', 1)[1]))
                elif command == 'swipe-back':
                    result = self.swipe_back()
                elif command.startswith('shot:'):
                    result = self.shot(command.split(':', 1)[1])
                elif command == 'bars':
                    result = self.bars()
                elif command.startswith('meminfo:'):
                    result = self.meminfo(command.split(':', 1)[1])
                elif command == 'audio':
                    result = self.audio()
                elif command.startswith('background:'):
                    result = self.background(float(command.split(':', 1)[1]))
                elif command == 'clean':
                    result = self.clean()
                elif command.startswith('save-dialog:'):
                    result = self.save_dialog(command.split(':', 1)[1])
                else:
                    result = f'unknown:{command}'
            except Exception as error:  # reported to the test, which fails on it
                result = f'error:{error}'
            self.say(f'  -> {result}')
            self.get('/__cmd?ack=' + urllib.request.quote(result))


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--serial', required=True, help='the emulator or device to drive (never the real app)')
    ap.add_argument('--media', required=True, type=Path, help='directory with every file of REQUIRED_MEDIA (the clips and photo1..12.jpg)')
    ap.add_argument('--out', required=True, type=Path)
    ap.add_argument('--port', type=int, default=8791)
    ap.add_argument('--build', action='store_true', help='build the profile APK first (isolated app id .linkperf)')
    ap.add_argument('--only', default='', help='run the scenarios whose name contains this text (baked into the build)')
    ap.add_argument('--define', action='append', default=[], help='extra --dart-define (NAME=value), e.g. VP_BACKGROUND=true')
    ap.add_argument('--record', default='on', help="screen recordings: 'on' (default), 'off', or a size like 720x1600 (a cheaper encode)")
    ap.add_argument('--no-host', action='store_true', help='skip the host-driven steps (back key, recordings, save dialog)')
    args = ap.parse_args()
    args.out.mkdir(parents=True, exist_ok=True)
    defines = [f'--dart-define=VP_BASE=http://127.0.0.1:{args.port}', f'--dart-define=VP_HOST={str(not args.no_host).lower()}']
    defines += [f'--dart-define={d}' for d in args.define]
    if args.only:
        defines.append(f'--dart-define=VP_ONLY={args.only}')
    if args.build:
        build = [str(ROOT / 'tool/flutter'), 'build', 'apk', '--profile', '--target-platform', 'android-x64',
                 '--android-project-arg=raftApplicationIdSuffix=.linkperf', '-t', TARGET, *defines]
        with (args.out / 'build.log').open('w') as log:
            if subprocess.run(build, cwd=APP, stdout=log, stderr=subprocess.STDOUT).returncode:
                sys.exit(f'build failed; see {args.out / "build.log"}')
    missing = [f for f in REQUIRED_MEDIA if not (args.media / f).is_file()]
    if missing:
        message = f'{args.media} has no {", ".join(missing)}: scenarios that use them fail on a 404'
        if not args.only:
            sys.exit(message + ' (a full run needs the complete directory)')
        print('warning: ' + message, file=sys.stderr)
    if not APK.exists():
        sys.exit(f'{APK} missing; run with --build')
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    child = None
    server = subprocess.Popen([sys.executable, str(ROOT / 'tool/video-parity-range-server'), str(args.media), str(args.port)],
                              stderr=(args.out / 'server.log').open('w'))
    host = Host(args.serial, args.port, args.out, args.record)
    thread = None
    try:
        time.sleep(1)
        subprocess.run(['adb', '-s', args.serial, 'reverse', f'tcp:{args.port}', f'tcp:{args.port}'], check=True)
        # A system dialog left by an earlier run (the save picker) keeps the app from coming to the front.
        for cleanup in (['am', 'force-stop', 'com.google.android.documentsui'], ['am', 'force-stop', PACKAGE],
                        ['input', 'keyevent', 'KEYCODE_HOME']):
            subprocess.run(['adb', '-s', args.serial, 'shell', *cleanup], check=False)
        subprocess.run(['adb', '-s', args.serial, 'logcat', '-c'], check=True)
        thread = threading.Thread(target=host.run, daemon=True)
        thread.start()
        drive = [str(ROOT / 'tool/flutter'), 'drive', '--profile', '-d', args.serial, '--no-pub', '--keep-app-running',
                 '--driver=test_driver/integration_test.dart', f'--target={TARGET}', f'--use-application-binary={APK}', *defines]
        code = 1
        with (args.out / 'suite.log').open('w') as log:
            child = subprocess.Popen(drive, cwd=APP, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
            finished = None
            while child.poll() is None:
                time.sleep(2)
                text = (args.out / 'suite.log').read_text(errors='replace')
                # The drive tool can stay alive after the driver reported (adb logcat child): stop it then.
                if 'Leaving the application running' in text or 'All tests passed' in text:
                    finished = finished or time.time()
                    if time.time() - finished > 8:
                        os.killpg(child.pid, signal.SIGTERM)
                        break
            child.wait()
            text = (args.out / 'suite.log').read_text(errors='replace')
            code = 0 if 'All tests passed' in text and 'Some tests failed' not in text else 1
        print((args.out / 'suite.log').read_text()[-4000:])
        sys.exit(code)
    finally:
        host.stop = True
        if child is not None and child.poll() is None:
            os.killpg(child.pid, signal.SIGTERM)
        if thread:
            thread.join(timeout=3)
        with (args.out / 'logcat.txt').open('w') as log:
            subprocess.run(['adb', '-s', args.serial, 'logcat', '-d', '-v', 'time'], stdout=log)
        subprocess.run(['adb', '-s', args.serial, 'reverse', '--remove', f'tcp:{args.port}'], check=False)
        server.send_signal(signal.SIGTERM)

if __name__ == '__main__':
    main()
