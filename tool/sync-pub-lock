#!/usr/bin/env python3
"""Re-run `pub get --enforce-lockfile` where a pubspec.lock differs between two revisions.

  tool/sync-pub-lock OLD NEW

Called by the git hooks in tool/git-hooks (post-merge, post-checkout,
post-rewrite) so a pull, rebase or branch switch does not leave stale
`.dart_tool` resolution behind (the root workspace, tool/raft_lints and the
bindings generator each have their own pubspec.lock). Silent when no lock
changed. Never fails: prints one line per package, with a clear WARNING and the
command to run by hand when pub get fails; the exit status is always 0.
"""
import os
import pathlib
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
LOCK = 'pubspec.lock'


def changed_lock_dirs(root, old, new):
    """Repo-relative directories whose pubspec.lock differs between old and new ('' = repo root)."""
    out = subprocess.run(['git', '-C', str(root), 'diff', '--name-only', '--diff-filter=d', '-z', old, new, '--', f'*{LOCK}'],
                         capture_output=True, text=True)
    if out.returncode != 0:  # unknown revision, e.g. the all-zero old rev of `git worktree add` / clone
        return []
    names = [name for name in out.stdout.split('\0') if name and pathlib.PurePosixPath(name).name == LOCK]
    parents = {str(pathlib.PurePosixPath(name).parent) for name in names}
    return sorted('' if parent == '.' else parent for parent in parents)


def pub_get(root, directory):
    """Runs pub get --enforce-lockfile in directory; returns (ok, detail)."""
    command = ([sys.executable] if os.name == 'nt' else []) + [str(root / 'tool/flutter'), 'pub', 'get', '--enforce-lockfile']
    cwd = root / directory
    if not (cwd / 'pubspec.yaml').is_file():
        return True, 'no pubspec.yaml, skipped'
    try:
        # git hooks export GIT_DIR / GIT_INDEX_FILE / ...; the Flutter SDK's own git calls must not see them.
        env = {key: value for key, value in os.environ.items() if not key.startswith('GIT_')}
        out = subprocess.run(command, cwd=cwd, capture_output=True, text=True, timeout=600, env=env)
    except (OSError, subprocess.SubprocessError) as error:
        return False, str(error)
    if out.returncode == 0:
        return True, ''
    lines = [line for line in (out.stderr + out.stdout).strip().splitlines() if line.strip()]
    return False, lines[-1] if lines else f'exit {out.returncode}'


def main(argv, root=ROOT):
    if len(argv) != 2:
        print('usage: tool/sync-pub-lock OLD NEW', file=sys.stderr)
        return 0
    for directory in changed_lock_dirs(root, argv[0], argv[1]):
        label = directory or '.'
        ok, detail = pub_get(root, directory)
        if ok:
            print(f'sync-pub-lock: {LOCK} changed in {label}; ran pub get --enforce-lockfile there.' + (f' ({detail})' if detail else ''))
        else:
            print(f'sync-pub-lock: WARNING: {LOCK} changed in {label} but pub get --enforce-lockfile failed ({detail}). '
                  f'Run it by hand: (cd {label} && {root / "tool/flutter"} pub get --enforce-lockfile)', file=sys.stderr)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception as error:  # a hook helper must never fail the git operation
        print(f'sync-pub-lock: WARNING: {error}', file=sys.stderr)
        sys.exit(0)
