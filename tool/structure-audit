#!/usr/bin/env python3
"""Ratchet hotspot modules, including parts, extensions and derived facades.

  tool/structure-audit --check    fail on growth or invalid/expired exceptions
  tool/structure-audit --update   explicitly lower ceilings; never raise them
  tool/structure-audit --update --module workspace_controller
  tool/structure-audit --json     print measured modules and their source files

The initial ceilings describe existing code, not desirable architecture.
Comments/formatting affect lines, but cannot hide token or instance-field growth.
Syntax inventory cannot decide whether an arbitrary collaborator owns the right
responsibility: the source-file inventory and that decision remain in review.
Exceptions in tool/structure-audit-baseline.json require an exact module, metric,
limit, reason, reviewer (Cindy or Kevin) and UTC expires date. The reviewer field
records a review; writing their name does not grant their approval.
"""
import argparse
import datetime
import importlib.machinery
import importlib.util
import json
import pathlib
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
BASELINE = ROOT / 'tool/structure-audit-baseline.json'
HINTS = {
    'workspace_controller': 'delegate to the existing domain owner; new state needs one declared owner',
    'workspace_view': 'keep shell composition here; move domain state to its existing owner',
    'resource_view': 'keep page presentation local; delegate loading/acceptance to the domain owner',
    'chat_view': 'keep rendering here; delegate composer/conversation state to its owner',
    'main': 'keep bootstrap here; put service lifecycle in the application root',
}


class AuditError(RuntimeError):
    pass


def run_scanner(config_path=BASELINE, root=ROOT):
    # Reuse the same pinned SDK discovery as the existing design-system audit.
    loader = importlib.machinery.SourceFileLoader('structure_sdk', str(ROOT / 'tool/ds-audit'))
    spec = importlib.util.spec_from_loader('structure_sdk', loader)
    sdk = importlib.util.module_from_spec(spec)
    loader.exec_module(sdk)
    config = ROOT / '.dart_tool/package_config.json'
    if not config.is_file():
        raise AuditError('run `TMPDIR=$HOME/.cache/tmp-cindy tool/flutter pub get --enforce-lockfile` first')
    output = subprocess.run([
        str(sdk.dart_executable()), f'--packages={config}',
        str(ROOT / 'tool/ds_audit/bin/structure_audit.dart'), str(root), str(config_path),
    ], cwd=ROOT, capture_output=True, text=True)
    if output.returncode:
        raise AuditError(output.stderr.strip() or output.stdout.strip())
    return json.loads(output.stdout)


def validate(document, today):
    if document.get('version') != 1 or not isinstance(document.get('modules'), dict) or not document['modules']:
        raise AuditError('baseline needs version 1 and nonempty modules')
    for name, module in document['modules'].items():
        if not isinstance(module, dict) or not isinstance(module.get('root'), str):
            raise AuditError(f'{name}: module needs a root')
        metrics = module.get('metrics')
        if not isinstance(metrics, dict) or not {'lines', 'tokens'} <= metrics.keys():
            raise AuditError(f'{name}: metrics need lines and tokens')
        if any(type(n) is not int or n < 0 for n in metrics.values()):
            raise AuditError(f'{name}: limits must be nonnegative integers')
    exceptions = document.get('exceptions', [])
    if not isinstance(exceptions, list):
        raise AuditError('exceptions must be a list')
    limits = {}
    for item in exceptions:
        if not isinstance(item, dict) or set(item) != {'module', 'metric', 'limit', 'reason', 'reviewer', 'expires'}:
            raise AuditError('exception needs module, metric, limit, reason, reviewer, expires')
        name, metric = item['module'], item['metric']
        if name not in document['modules'] or not isinstance(metric, str) or not (
                metric in ('lines', 'tokens') or metric.startswith('field.')):
            raise AuditError('exception must identify an exact module and metric')
        if item['reviewer'] not in ('Cindy', 'Kevin') or not isinstance(item['reason'], str) or not item['reason'].strip():
            raise AuditError(f'{name}/{metric}: needs a reason and review by Cindy or Kevin')
        if type(item['limit']) is not int or item['limit'] < 0:
            raise AuditError(f'{name}/{metric}: invalid exception limit')
        try:
            expires = datetime.date.fromisoformat(item['expires'])
        except (TypeError, ValueError):
            raise AuditError(f'{name}/{metric}: expires must be a YYYY-MM-DD date') from None
        if expires <= today:
            raise AuditError(f'{name}/{metric}: exception expired on {expires}; remove it or obtain a new review')
        key = name, metric
        if key in limits:
            raise AuditError(f'{name}/{metric}: duplicate exception')
        limits[key] = item['limit']
    return limits


def compare(document, report, limits):
    if set(document['modules']) != set(report['modules']):
        raise AuditError('scanner modules differ from the baseline')
    growth, lower, allowed = [], [], []
    for name, module in document['modules'].items():
        previous = module['metrics']
        current = report['modules'][name]['metrics']
        for metric in sorted(previous.keys() | current.keys()):
            before, now = previous.get(metric, 0), current.get(metric, 0)
            if now > before:
                (allowed if now <= limits.get((name, metric), before) else growth).append((name, metric, before, now))
            elif now < before:
                lower.append((name, metric, before, now))
    return growth, lower, allowed


def lower_baseline(document, report, modules=None):
    selected = set(document['modules'] if modules is None else modules)
    if not selected or selected - document['modules'].keys():
        raise AuditError('--module must name an existing baseline module')
    scoped_document = {'modules': {name: document['modules'][name] for name in selected}}
    scoped_report = {'modules': {name: report['modules'][name] for name in selected}}
    growth, _, _ = compare(scoped_document, scoped_report, {})
    if growth:
        raise AuditError('--update cannot raise any ceiling, including growth covered by exceptions')
    for name, module in document['modules'].items():
        if name not in selected:
            continue
        current = report['modules'][name]['metrics']
        module['metrics'] = {metric: min(limit, current.get(metric, 0))
                             for metric, limit in module['metrics'].items()}
    return document


def main(argv=None, *, today=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--check', action='store_true')
    mode.add_argument('--update', action='store_true')
    mode.add_argument('--json', action='store_true')
    parser.add_argument('--module', action='append', metavar='NAME',
                        help='with --update, lower only this module (repeatable)')
    args = parser.parse_args(argv)
    if args.module and not args.update:
        parser.error('--module requires --update')
    try:
        document = json.loads(BASELINE.read_text(encoding='utf-8'))
        limits = validate(document, today or datetime.datetime.now(datetime.timezone.utc).date())
        report = run_scanner()
        growth, lower, allowed = compare(document, report, limits)
        if args.json:
            print(json.dumps(report, indent=2))
        else:
            for name, module in report['modules'].items():
                measured = module['metrics']
                fields = sum(n for key, n in measured.items() if key.startswith('field.'))
                print(f'{name}: {measured["lines"]} lines, {measured["tokens"]} tokens, {fields} fields ({len(module["files"])} files)')
            for label, rows in (('GROW', growth), ('ALLOW', allowed)):
                for name, metric, before, now in rows:
                    print(f'{label} {name}/{metric}: {before} -> {now}')
            if lower:
                print(f'{len(lower)} ceiling(s) can lower: explicitly run tool/structure-audit --update; no automatic baseline edits.')
            for name in sorted({r[0] for r in growth}):
                print(f'{name}: {HINTS.get(name, "review this module ownership")}.')
            if growth:
                example = dict(module=growth[0][0], metric=growth[0][1], limit=growth[0][3],
                               reason='explain the necessary change', reviewer='Cindy',
                               expires='YYYY-MM-DD')
                print('Or obtain Cindy/Kevin review and add one bounded exception to tool/structure-audit-baseline.json:')
                print(json.dumps(example))
        if args.update:
            lower_baseline(document, report, args.module)
            BASELINE.write_text(json.dumps(document, indent=2) + '\n', encoding='utf-8')
            print('Baseline explicitly lowered; no ceiling raised.')
        return 1 if args.check and growth else 0
    except (AuditError, OSError, ValueError, KeyError, TypeError) as error:
        print(f'structure-audit: {error}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
