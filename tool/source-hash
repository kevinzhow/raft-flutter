#!/usr/bin/env python3
"""Hash ignored-secret-free product and verification inputs, excluding docs."""
import hashlib,pathlib,subprocess
root=pathlib.Path(__file__).resolve().parent.parent
paths=subprocess.check_output(['git','ls-files','--cached','--others','--exclude-standard','-z'],cwd=root).decode().split('\0')
h=hashlib.sha256()
for name in sorted(set(paths)):
    if not name or not (name.startswith(('apps/','packages/','tool/tests/','tool/ds_audit/')) or name in {'.fvmrc','pubspec.yaml','pubspec.lock','tool/flutter','tool/prepare-media-linux','tool/source-hash','tool/native-linux','tool/native-test','tool/check-project','tool/ds-audit','tool/ds-audit-baseline.json'}):
        continue
    if PathName := pathlib.Path(name).name:
        if PathName.startswith('generated_plugin_registrant.') or PathName == 'generated_plugins.cmake':
            continue
    path=root/name
    if not path.is_file():
        continue
    h.update(name.encode()+b'\0')
    h.update(hashlib.sha256(path.read_bytes()).digest())
print(h.hexdigest())
