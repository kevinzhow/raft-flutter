#!/usr/bin/env python3
"""S3-like static server: Accept-Ranges, 206, HEAD, optional ?rate=<bytes/s>. Logs each request.

Counts what it really sent, for the player interaction suite (integration_test/player_interactions_test.dart):
  GET /__stats  -> {"files": {name: {"requests": n, "bytes": sent, "size": size}}, "log": [{...}, ...]}
  GET /__reset  -> clears the counters
  GET /__fail?file=<name>&status=403&count=1 -> the next <count> requests for the file answer <status>
  GET /__cmd?set=<name>|poll|ack|done -> a mailbox between the app under test and the host runner
      (tool/player-interactions): the app sets a host command (adb back key, screen recording, ...), the runner
      polls, performs it and acks, the app polls done.
All of these are served without the file lookup and are not counted themselves.
"""
import json, os, re, sys, threading, time
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
ROOT = sys.argv[1]; PORT = int(sys.argv[2])
LOCK = threading.Lock(); LOG = []; SENT = {}; FAIL = {}; CMD = {'pending': None, 'done': True, 'result': None}
def stats():
    with LOCK:
        files = {}
        for e in LOG:
            f = files.setdefault(e['file'], {'requests': 0, 'bytes': 0, 'size': e['size']})
            f['requests'] += 1
        for k, v in SENT.items():
            files.setdefault(k, {'requests': 0, 'bytes': 0, 'size': 0})['bytes'] = v
        return {'files': files, 'log': list(LOG)}
class H(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'
    def log_message(self, f, *a):
        sys.stderr.write('%s %s\n' % (self.command, self.path) + ('   Range: %s\n' % self.headers.get('Range') if self.headers.get('Range') else ''))
    def _serve(self, head):
        from urllib.parse import urlparse, parse_qs
        u = urlparse(self.path); q = parse_qs(u.query)
        if u.path in ('/__fail', '/__cmd'):
            with LOCK:
                if u.path == '/__fail':
                    FAIL[q['file'][0]] = [int(q.get('status', ['403'])[0]), int(q.get('count', ['1'])[0])]
                    out = {'fail': FAIL}
                else:
                    if 'set' in q: CMD.update(pending=q['set'][0], done=False, result=None)
                    if 'ack' in q: CMD.update(pending=None, done=True, result=q['ack'][0] or None)
                    out = dict(CMD)
            body = json.dumps(out).encode()
            self.send_response(200); self.send_header('Content-Type', 'application/json')
            self.send_header('Content-Length', str(len(body))); self.end_headers()
            if not head: self.wfile.write(body)
            return
        if u.path in ('/__stats', '/__reset'):
            if u.path == '/__reset':
                with LOCK: LOG.clear(); SENT.clear(); FAIL.clear()
            body = json.dumps(stats()).encode()
            self.send_response(200); self.send_header('Content-Type', 'application/json')
            self.send_header('Content-Length', str(len(body))); self.end_headers()
            if not head: self.wfile.write(body)
            return
        path = os.path.join(ROOT, os.path.basename(u.path))
        if not os.path.isfile(path):
            self.send_response(404); self.send_header('Content-Length', '0'); self.end_headers(); return
        size = os.path.getsize(path); start, end = 0, size - 1; status = 200
        with LOCK:
            failing = FAIL.get(os.path.basename(u.path))
            if failing and failing[1] > 0:
                failing[1] -= 1; fail = failing[0]
                LOG.append({'file': os.path.basename(u.path), 'method': self.command, 'range': self.headers.get('Range'),
                            'status': fail, 'length': 0, 'size': size, 'at': time.time(), 'ua': self.headers.get('User-Agent', '')})
            else:
                fail = None
        if fail:
            self.send_response(fail); self.send_header('Content-Length', '0'); self.end_headers(); return
        m = re.match(r'bytes=(\d*)-(\d*)', self.headers.get('Range', ''))
        if m:
            if m.group(1): start = int(m.group(1))
            if m.group(2): end = min(int(m.group(2)), size - 1)
            if not m.group(1) and m.group(2): start = max(0, size - int(m.group(2))); end = size - 1
            status = 206
        self.send_response(status)
        self.send_header('Content-Type', 'video/mp4'); self.send_header('Accept-Ranges', 'bytes')
        self.send_header('Content-Length', str(end - start + 1))
        if status == 206: self.send_header('Content-Range', 'bytes %d-%d/%d' % (start, end, size))
        self.end_headers()
        name = os.path.basename(u.path)
        with LOCK:
            LOG.append({'file': name, 'method': self.command, 'range': self.headers.get('Range'), 'status': status,
                        'length': end - start + 1, 'size': size, 'at': time.time(), 'ua': self.headers.get('User-Agent', '')})
        if head: return
        rate = int(q.get('rate', ['0'])[0])
        with open(path, 'rb') as f:
            f.seek(start); left = end - start + 1
            try:
                while left > 0:
                    chunk = f.read(min(65536 if not rate else max(rate // 20, 1), left))
                    self.wfile.write(chunk); left -= len(chunk)
                    with LOCK: SENT[name] = SENT.get(name, 0) + len(chunk)
                    if rate: time.sleep(0.05)
            except (BrokenPipeError, ConnectionResetError): pass
    def do_GET(self): self._serve(False)
    def do_HEAD(self): self._serve(True)
ThreadingHTTPServer(('127.0.0.1', PORT), H).serve_forever()
