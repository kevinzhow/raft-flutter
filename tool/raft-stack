#!/usr/bin/env python3
"""Run an isolated local comparison stack without changing global tools.

Usage: tool/raft-stack [--config PATH] start|stop|status|ports|sync
       tool/raft-stack [--config PATH] flags [on|off KEY...]
       tool/raft-stack [--config PATH] restart web|content-worker|risingwave

Each config (default .local/stack.json) describes one source checkout and one
raftdev environment, so several Raft versions can run side by side from one
worktree. Config keys (all paths may start with ~):
  environment, sourceDir, sourceCommit, webUrl, apiUrl      required
  sourceVersion   e.g. "v1.21.23"; selects <patch>-<version> reference patches
  patches         patch names to apply (default seed-history, risingwave-memory)
  toolchain       {"binDir": "<dir with node and pnpm>", "env": {"COREPACK_HOME": ...}}
                  env is exported by a pnpm wrapper placed first on PATH (tmux windows
                  only inherit PATH)
                  default: npx-provided node 24.21.0 / pnpm 10.29.3 (toolchain-paths.txt)
  risingwaveImage override of the pinned RisingWave image
  featureFlags    flag keys enabled for the fixture server after start (or via the
                  flags action): dev stacks seed few flag rows, so a missing flag row
                  plus a server-stage allow rule is written to the environment's
                  PostgreSQL container
  featureFlagsOff flag keys forced off for the fixture server (a server-stage deny rule;
                  a flag with no row is already off). `flags on KEY...` / `flags off
                  KEY...` move keys between the two lists in the config file and apply
                  the change at once; plain `flags` re-applies both lists. Every flags
                  run prints the stored state of the keys it touched
  fixturePlan     optional: set the fixture server's plan (free|founder|partner|pro) when
                  flags are applied. Creating a hosted agent counts against the plan's seats
                  and the fixture server's "pro" plan has one, so hosted-agent work needs
                  "founder" (unlimited); a plan removed from the config is not reverted
  serverEnvFile   private (mode 600) KEY=VALUE file for the Raft server, linked as
                  <sourceDir>/packages/server/.env (the server loads it with dotenv;
                  raftdev itself only forwards a fixed list of variables). Created on
                  start/sync with generated keys, see below
                  The file always gets generated SLOCK_PROVIDER_CREDENTIAL_KEY,
                  RAFT_APP_WEBHOOK_ENCRYPTION_KEY and RAFT_TOTP_SECRET_ENCRYPTION_KEY
                  (v1.24+ refuses to store an authenticator secret without the last)
  antiprotonUrl   optional with serverEnvFile: http://localhost:<port> of the local
                  antiproton (tool/antiproton-local); written as
                  ANTIPROTON_BASE_URL_OVERRIDE, together with RAFTBENCH_LOCAL_SERVER_ID
The sync action re-applies patches, the server env file and flags to a running stack;
the server (node --watch) is restarted so it re-reads the env file. With
the antiproton-local-<version> patch the hosted-agent path works locally (RaftBench
analysis, Cloud agents): RAFTBENCH_LOCAL_SERVER_ID is the fixture server, the provider
token comes from `tool/antiproton-local mint-token`, and add antiproton_hosted_runtime
to featureFlags.
  artifacts       optional {"contentDomain": "artifacts.localhost:<port>", "workerPort": <port>}
                  (workerPort defaults to the domain's port): workspace Artifacts on the
                  local stack. The server env file gets ARTIFACTS_CONTENT_DOMAIN, generated
                  ARTIFACTS_CONTENT_WORKER_TOKEN / ARTIFACTS_CONTENT_RAFT_TOKENS and
                  APP_STORAGE_R2_* for the environment's RustFS; the Web dev server gets
                  VITE_ARTIFACTS_CONTENT_DOMAIN through a managed <sourceDir>/packages/web/.env.local
                  (Vite reads it; tmux windows inherit no environment); the source's content
                  Worker (packages/content-worker, built once with its `build` script) runs in
                  Miniflare (tool/raft-content-worker.mjs) on 127.0.0.1:<workerPort> with
                  bindings in the private .local/<config stem>-content-worker.env. start starts
                  it after raftdev, stop stops it first, status reports it. Its PID and start
                  time are recorded in .local/<config stem>-content-worker.pid; only that
                  process (and its process group) is ever stopped
restart web restarts only the Web dev server (tmux respawn of the raftdev `web` window with
its original command, after refreshing .env.local); restart content-worker restarts only the
content Worker. Neither touches the database, the server or the other windows.
restart risingwave recreates only the managed RisingWave container with the source's own
container arguments and config (tool/raft-risingwave.ts imports them from scripts/dev/raftdev.ts,
so the reference patches apply) and provisions its CDC source and views from Postgres with the
source's bootstrap script, as start does. Postgres data, Redis, RustFS and the server stay up;
Activity reads answer 503 until the views are back.
status adds a RisingWave health line: container state, meta heartbeat failures in the last
minute, whether the committed epoch moves, and how far the RW copy of messages lags Postgres.
Private state (logs, PID files, the toolchain wrapper) lives next to the config file.
  containerCpus   CPU limit (docker --cpus) for each of the environment's containers
                  (Postgres, Redis, RustFS, RisingWave, otelcol), applied with `docker update`
                  after start, sync and restart risingwave (the RW helper applies it before
                  the bootstrap). Default 2; 0 leaves the containers unlimited
  processPrefix   optional command prefix (e.g. ["cpu-lane", "agents"]: a CPU-capped systemd
                  scope that execs the command) for the processes this tool starts itself: the
                  content Worker and the RisingWave restart helper with its bootstrap. The
                  server, Web and daemon are tmux windows of the user's tmux server, which
                  raftdev reuses and which runs outside any such scope, so a prefix on raftdev
                  would not reach them; bound those with the user's own slice for tmux
A patch manifest may say {"upstream": "<why>"} instead of listing files: the source
version already does what the patch did, so nothing is applied for that name.
Logs are private files .local/<config stem>-<action>.log (stack-<action>.log for
the default config).
"""
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from local_env_file import random_b64, read_env_file, write_env_file  # noqa: E402

ROOT = Path(__file__).resolve().parents[1]
LOCAL = ROOT / '.local'
PATCH_DIR = ROOT / 'tool/reference-patches'
ACTIONS = {'start', 'stop', 'status', 'ports', 'flags', 'sync'}
RESTARTABLE = ('web', 'content-worker', 'risingwave')
RISINGWAVE_HELPER = ROOT / 'tool/raft-risingwave.ts'
WORKER_SCRIPT = ROOT / 'tool/raft-content-worker.mjs'
WEB_ENV_MARKER = '# Managed by tool/raft-stack (artifacts.contentDomain); rewritten on start/sync/restart.'

DEFAULT_PATCHES = ('seed-history', 'risingwave-memory')
DEFAULT_IMAGE = 'mirror.gcr.io/risingwavelabs/risingwave@sha256:ba5915a5e85c938a3ec62d76c63c6e4cb37d4f4e3c5c30886f0d2eff61b70073'
USAGE = ('Usage: tool/raft-stack [--config PATH] start|stop|status|ports|sync\n'
         '       tool/raft-stack [--config PATH] flags [on|off KEY...]\n'
         '       tool/raft-stack [--config PATH] restart web|content-worker|risingwave')


def parse_args(argv):
    """Return (config path, action), plus (mode, keys) for `flags on|off KEY...`."""
    args = list(argv)
    config = LOCAL / 'stack.json'
    if args[:1] == ['--config'] and len(args) >= 2:
        config = Path(args[1]).expanduser()
        args = args[2:]
    if args[:1] == ['flags'] and len(args) >= 3 and args[1] in ('on', 'off'):
        return config, 'flags', (args[1], args[2:])
    if args[:1] == ['restart'] and len(args) == 2 and args[1] in RESTARTABLE:
        return config, 'restart', args[1]
    if len(args) != 1 or args[0] not in ACTIONS:
        raise SystemExit(USAGE)
    return config, args[0]


def select_patches(config, patch_dir=PATCH_DIR):
    """Return patch base names; a <name>-<sourceVersion> pair wins over <name>."""
    version = config.get('sourceVersion')
    names = []
    for name in config.get('patches', DEFAULT_PATCHES):
        if version and (patch_dir / f'{name}-{version}.json').exists():
            name = f'{name}-{version}'
        names.append(name)
    return names


def apply_patches(source, names, patch_dir=PATCH_DIR):
    """Apply each reviewed patch whose files still have the recorded before hashes.

    A manifest is either one file ({path, beforeSHA256, afterSHA256}) or several
    ({files: [...]}). All files must be in the same state: all before (apply), all
    after (already applied) or the patch is refused. Returns the names applied now.
    A file whose hash is one of the item's supersededAfterSHA256 (an earlier reviewed
    version of the same patch) is first restored to the pinned commit's content.
    """
    applied = []
    for name in names:
        repair = json.loads((patch_dir / (name + '.json')).read_text())
        if repair.get('upstream'):
            continue
        files = repair.get('files') or [repair]
        for item in files:
            digest = hashlib.sha256((source / item['path']).read_bytes()).hexdigest()
            if digest in item.get('supersededAfterSHA256', []):
                subprocess.run(['git', 'checkout', '--', item['path']], cwd=source, check=True)
        digests = [hashlib.sha256((source / item['path']).read_bytes()).hexdigest() for item in files]
        patch = patch_dir / (name + '.patch')
        if all(digest == item['beforeSHA256'] for digest, item in zip(digests, files)):
            subprocess.run(['git', 'apply', '--check', str(patch)], cwd=source, check=True)
            subprocess.run(['git', 'apply', str(patch)], cwd=source, check=True)
            applied.append(name)
        elif not all(digest == item['afterSHA256'] for digest, item in zip(digests, files)):
            raise SystemExit('Reference setup file differs from the reviewed compatibility patch: ' + name)
    return applied


def toolchain_bin(config):
    toolchain = config.get('toolchain') or {}
    if toolchain.get('binDir'):
        return Path(toolchain['binDir']).expanduser()
    paths_file = LOCAL / 'toolchain-paths.txt'
    if not paths_file.exists():
        paths_file.write_text(subprocess.check_output([
            'npx', '--yes', '--package=node@24.21.0', '--package=pnpm@10.29.3',
            '-c', 'command -v node; command -v pnpm',
        ], text=True))
    return Path(paths_file.read_text().splitlines()[0]).parent


FLAG_KEY_RE = re.compile(r'^[a-z0-9_]{1,80}$')
UUID_RE = re.compile(r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')


def feature_flag_sql(keys, server_id):
    """Idempotent SQL: default-off server-randomised flags with an allow rule for one server."""
    if not UUID_RE.match(server_id):
        raise SystemExit('Fixture server id is not a UUID.')
    statements = ['BEGIN;']
    for key in keys:
        if not FLAG_KEY_RE.match(key):
            raise SystemExit('Invalid feature flag key: ' + key)
        statements.append(
            'INSERT INTO feature_flags (key, description, enabled, kill_switch, randomization_unit, default_enabled, salt) '
            f"VALUES ('{key}', 'Local fixture flag', true, false, 'server', false, '{key}') ON CONFLICT (key) DO NOTHING;")
        statements.append(
            'INSERT INTO feature_flag_rules (id, flag_key, stage, priority, decision, "values") '
            f"SELECT gen_random_uuid(), '{key}', 'server', 0, 'allow', '[\"{server_id}\"]'::jsonb "
            f"WHERE NOT EXISTS (SELECT 1 FROM feature_flag_rules WHERE flag_key = '{key}' AND stage = 'server');")
    statements.append('COMMIT;')
    return '\n'.join(statements) + '\n'


# Our own rules sort first among server-stage rules (first match by priority wins), so a
# toggle beats any allowlist rule a seed may have written for the same server.
TOGGLE_PRIORITY = -1000
BUMP_CONFIG_VERSION_SQL = (
    # v1.24+: every replica polls this row and sends `server:features-changed`, so open
    # clients re-read their flags; older sources have no such table.
    "DO $$ BEGIN IF to_regclass('feature_flag_config_versions') IS NOT NULL THEN "
    "INSERT INTO feature_flag_config_versions (scope, version) VALUES ('global', 1) "
    "ON CONFLICT (scope) DO UPDATE SET version = feature_flag_config_versions.version + 1, "
    "updated_at = now(); END IF; END $$;")


def feature_flag_toggle_sql(on_keys, off_keys, server_id):
    """Idempotent SQL: the fixture server's own server-stage rule says allow (on) or deny (off).

    A missing flag row is created (default off, server-randomised) only for an on key.
    """
    if not UUID_RE.match(server_id):
        raise SystemExit('Fixture server id is not a UUID.')
    statements = ['BEGIN;']
    for key, decision in [(k, 'allow') for k in on_keys] + [(k, 'deny') for k in off_keys]:
        if not FLAG_KEY_RE.match(key):
            raise SystemExit('Invalid feature flag key: ' + key)
        if decision == 'allow':
            statements.append(
                'INSERT INTO feature_flags (key, description, enabled, kill_switch, randomization_unit, default_enabled, salt) '
                f"VALUES ('{key}', 'Local fixture flag', true, false, 'server', false, '{key}') ON CONFLICT (key) DO NOTHING;")
        statements.append(
            f"DELETE FROM feature_flag_rules WHERE flag_key = '{key}' AND stage = 'server' "
            f"AND \"values\" = '[\"{server_id}\"]'::jsonb;")
        statements.append(
            'INSERT INTO feature_flag_rules (id, flag_key, stage, priority, decision, "values") '
            f"SELECT gen_random_uuid(), '{key}', 'server', {TOGGLE_PRIORITY}, '{decision}', '[\"{server_id}\"]'::jsonb "
            f"WHERE EXISTS (SELECT 1 FROM feature_flags WHERE key = '{key}');")
    statements.append(BUMP_CONFIG_VERSION_SQL)
    statements.append('COMMIT;')
    return '\n'.join(statements) + '\n'


def feature_flag_state_sql(keys, server_id):
    """One line per key: key|row enabled|kill switch|default|this server's own rule decision."""
    if not UUID_RE.match(server_id):
        raise SystemExit('Fixture server id is not a UUID.')
    for key in keys:
        if not FLAG_KEY_RE.match(key):
            raise SystemExit('Invalid feature flag key: ' + key)
    listed = ', '.join(f"('{key}')" for key in keys)
    return (
        f"SELECT k.key, coalesce(f.enabled::text, 'no row'), coalesce(f.kill_switch::text, '-'), "
        f"coalesce(f.default_enabled::text, '-'), coalesce((SELECT r.decision FROM feature_flag_rules r "
        f"WHERE r.flag_key = k.key AND r.stage = 'server' AND r.\"values\" = '[\"{server_id}\"]'::jsonb "
        f"ORDER BY r.priority LIMIT 1), '-') FROM (VALUES {listed}) AS k(key) "
        f"LEFT JOIN feature_flags f ON f.key = k.key ORDER BY k.key;\n")


def toggle_config_flags(config, mode, keys):
    """Move keys into featureFlags (on) or featureFlagsOff (off); returns the new config."""
    for key in keys:
        if not FLAG_KEY_RE.match(key):
            raise SystemExit('Invalid feature flag key: ' + key)
    on = [k for k in config.get('featureFlags') or [] if k not in keys]
    off = [k for k in config.get('featureFlagsOff') or [] if k not in keys]
    (on if mode == 'on' else off).extend(keys)
    updated = dict(config, featureFlags=on)
    if off:
        updated['featureFlagsOff'] = off
    else:
        updated.pop('featureFlagsOff', None)
    return updated


FIXTURE_PLANS = ('free', 'founder', 'partner', 'pro')


def fixture_plan_sql(plan, server_id):
    if plan not in FIXTURE_PLANS:
        raise SystemExit('Invalid fixturePlan: ' + str(plan))
    if not UUID_RE.match(server_id):
        raise SystemExit('Fixture server id is not a UUID.')
    return f"UPDATE servers SET plan = '{plan}' WHERE id = '{server_id}';\n"


def run_psql(config, sql, capture=False):
    result = subprocess.run(['docker', 'exec', '-i', f"slock-dev-{config['environment']}-pg",
                             'psql', '-U', 'postgres', '-d', 'slock', '-v', 'ON_ERROR_STOP=1', '-q']
                            + (['-At', '-F', '|'] if capture else []),
                            input=sql, text=True, check=True,
                            stdout=subprocess.PIPE if capture else subprocess.DEVNULL)
    return result.stdout if capture else None


def print_flag_state(config, keys, server_id):
    print('flag | row enabled | kill switch | default | fixture server rule')
    print(run_psql(config, feature_flag_state_sql(keys, server_id), capture=True).rstrip())


def apply_feature_flags(config, source):
    """Flags and (optionally) the fixture server's plan, both written to the environment's PostgreSQL."""
    keys = config.get('featureFlags') or []
    off_keys = config.get('featureFlagsOff') or []
    plan = config.get('fixturePlan')
    if not keys and not off_keys and not plan:
        return
    fixture = json.loads((source / f".dev-env-{config['environment']}.json").read_text())
    if keys:
        run_psql(config, feature_flag_sql(keys, fixture['server']['id']))
    if keys or off_keys:
        run_psql(config, feature_flag_toggle_sql(keys, off_keys, fixture['server']['id']))
        print('feature flags for the fixture server: on ' + (', '.join(keys) or '-')
              + '; off ' + (', '.join(off_keys) or '-'))
        print_flag_state(config, keys + off_keys, fixture['server']['id'])
    if plan:
        run_psql(config, fixture_plan_sql(plan, fixture['server']['id']))
        print('fixture server plan set to ' + plan)


def fixture_server_id(config, source):
    path = source / f".dev-env-{config['environment']}.json"
    return json.loads(path.read_text())['server']['id'] if path.exists() else None


def server_env_values(config, existing, server_id):
    """Env for the local Raft server: loopback antiproton, the fixture server, secrets at rest.

    Keys already in the file win (generated secrets stay stable; the provider tokens
    written by tool/antiproton-local mint-token are kept); the two derived values are
    refreshed from the config and fixture.
    """
    values = dict(existing)
    if config.get('antiprotonUrl'):
        values['ANTIPROTON_BASE_URL_OVERRIDE'] = config['antiprotonUrl'].rstrip('/')
    # Not the canary setup: a canary server is frozen to canary RaftBench provisions and could
    # not also host Cloud agents. Drop it (and its token) if an earlier version of this file had it.
    for stale in ('RAFTBENCH_CANARY_SERVER_ID', 'ANTIPROTON_CANARY_PROVISIONING_TOKEN'):
        values.pop(stale, None)
    if server_id and config.get('antiprotonUrl'):
        values['RAFTBENCH_LOCAL_SERVER_ID'] = server_id
    for key in ('SLOCK_PROVIDER_CREDENTIAL_KEY', 'RAFT_APP_WEBHOOK_ENCRYPTION_KEY',
                'RAFT_TOTP_SECRET_ENCRYPTION_KEY'):
        values.setdefault(key, random_b64())
    artifacts = config.get('artifacts')
    if artifacts:
        values['ARTIFACTS_CONTENT_DOMAIN'] = content_domain(config)
        # Two different tokens (the server refuses a Worker token that is also a Raft token).
        values.setdefault('ARTIFACTS_CONTENT_WORKER_TOKEN', random_b64())
        values.setdefault('ARTIFACTS_CONTENT_RAFT_TOKENS', random_b64())
        bucket = bucket_component(config['environment'])
        values.setdefault('APP_STORAGE_R2_ENDPOINT', f"http://localhost:{19000 + compute_offset(config['environment'])}")
        values.setdefault('APP_STORAGE_R2_REGION', 'auto')
        values.setdefault('APP_STORAGE_R2_ACCESS_KEY_ID', 'slockdev')
        values.setdefault('APP_STORAGE_R2_SECRET_ACCESS_KEY', f'slockdev-secret-{bucket}')
        values.setdefault('APP_STORAGE_R2_BUCKET', f'slock-dev-{bucket}-attachments')
    return values


def compute_offset(name):
    """raftdev's port offset for an environment name (scripts/dev/raftdev.ts computeOffset)."""
    value = 0
    for ch in name:
        byte = ch.encode('utf-8')[0]
        value = (value * 31 + (byte - 256 if byte > 127 else byte)) % 100
    return value


def bucket_component(name):
    """raftdev's sanitizeBucketComponent: the RustFS bucket and secret are derived from it."""
    value = re.sub(r'-+', '-', re.sub(r'[^a-z0-9-]+', '-', name.lower()).strip('-'))
    return value or 'env'


DOMAIN_RE = re.compile(r'^[a-z0-9.-]+\.localhost(:[0-9]{1,5})?$')


def content_domain(config):
    domain = str((config.get('artifacts') or {}).get('contentDomain', '')).strip().lower()
    if not DOMAIN_RE.match(domain):
        raise SystemExit('artifacts.contentDomain must be a <name>.localhost[:port] host.')
    return domain


def worker_port(config):
    artifacts = config.get('artifacts') or {}
    port = artifacts.get('workerPort') or content_domain(config).partition(':')[2]
    if not str(port).isdigit():
        raise SystemExit('artifacts.workerPort is required when contentDomain has no port.')
    return int(port)


def content_worker_bindings(config, server_values, existing):
    """The content Worker's bindings, crossed with the server's tokens; PORTHOLE_SECRET stays stable."""
    values = dict(existing)
    values.update(
        CONTENT_DOMAIN=content_domain(config),
        APP_ORIGIN=config['webUrl'].rstrip('/'),
        RAFT_API_URL=config['apiUrl'].rstrip('/'),
        # The Worker's token to Raft is one Raft lists; Raft's token to the Worker signs tickets.
        RAFT_API_TOKEN=server_values['ARTIFACTS_CONTENT_RAFT_TOKENS'].split(',')[0].strip(),
        RAFT_TOKENS=server_values['ARTIFACTS_CONTENT_WORKER_TOKEN'],
        R2_ENDPOINT=server_values['APP_STORAGE_R2_ENDPOINT'],
        R2_BUCKET=server_values['APP_STORAGE_R2_BUCKET'],
        R2_READ_ACCESS_KEY_ID=server_values['APP_STORAGE_R2_ACCESS_KEY_ID'],
        R2_READ_SECRET_ACCESS_KEY=server_values['APP_STORAGE_R2_SECRET_ACCESS_KEY'],
    )
    values.setdefault('PORTHOLE_SECRET', random_b64())
    return values


def web_env_text(config):
    return f'{WEB_ENV_MARKER}\nVITE_ARTIFACTS_CONTENT_DOMAIN={content_domain(config)}\n'


def prepare_web_env(config, source):
    """Write the managed packages/web/.env.local; returns True when it changed. A foreign file is kept."""
    if not config.get('artifacts'):
        return False
    path = source / 'packages/web/.env.local'
    text = web_env_text(config)
    if path.exists():
        current = path.read_text()
        if not current.startswith(WEB_ENV_MARKER):
            raise SystemExit(f'{path} exists and is not managed by tool/raft-stack; move it away first.')
        if current == text:
            return False
    path.write_text(text)
    return True


def worker_files(stem):
    return LOCAL / f'{stem}-content-worker.env', LOCAL / f'{stem}-content-worker.pid', LOCAL / f'{stem}-content-worker.log'


def prepare_content_worker(config, stem):
    """Write the Worker's private bindings from the server env file; returns True when they changed."""
    bindings_file = worker_files(stem)[0]
    server_values = read_env_file(Path(config['serverEnvFile']).expanduser())
    missing = [k for k in ('ARTIFACTS_CONTENT_RAFT_TOKENS', 'ARTIFACTS_CONTENT_WORKER_TOKEN', 'APP_STORAGE_R2_BUCKET')
               if not server_values.get(k)]
    if missing:
        raise SystemExit('The server env file lacks ' + ', '.join(missing) + ': run start or sync first.')
    existing = read_env_file(bindings_file)
    values = content_worker_bindings(config, server_values, existing)
    if values != existing or not bindings_file.exists():
        write_env_file(bindings_file, values)
        return True
    return False


def process_start_time(pid):
    """Field 22 of /proc/<pid>/stat (clock ticks since boot): tells a PID apart from a reused one."""
    try:
        stat = Path(f'/proc/{pid}/stat').read_text()
    except OSError:
        return None
    return stat.rsplit(')', 1)[1].split()[19]


def recorded_worker_pid(stem):
    """The recorded Worker PID if that very process (same start time, our script) still runs, else None."""
    pid_file = worker_files(stem)[1]
    try:
        pid_text, start = pid_file.read_text().split()
        pid = int(pid_text)
    except (OSError, ValueError):
        return None
    if process_start_time(pid) != start:
        return None
    try:
        cmdline = Path(f'/proc/{pid}/cmdline').read_bytes().split(b'\0')
    except OSError:
        return None
    # Any worktree's copy of the script (the PID file sits next to the shared config); the
    # start time above already rules out a reused PID.
    return pid if any(arg.endswith(b'/tool/' + WORKER_SCRIPT.name.encode()) for arg in cmdline) else None


def port_open(port):
    import socket
    with socket.socket() as sock:
        sock.settimeout(1)
        return sock.connect_ex(('127.0.0.1', port)) == 0


def build_content_worker(source, env):
    worker_dir = source / 'packages/content-worker'
    if (worker_dir / 'dist/raftContent.js').exists():
        return
    print('building the content Worker (wrangler deploy --dry-run)...')
    subprocess.run(['pnpm', 'run', 'build'], cwd=worker_dir, check=True,
                   env=dict(env, WRANGLER_SEND_METRICS='false'), stdout=subprocess.DEVNULL)


def start_content_worker(config, source, stem, env):
    import time
    if not config.get('artifacts'):
        return None
    pid = recorded_worker_pid(stem)
    if pid:
        print(f'content Worker already running (pid {pid})')
        return pid
    port = worker_port(config)
    if port_open(port):
        raise SystemExit(f'Port {port} is taken by a process this tool did not start; stop that owner first.')
    prepare_content_worker(config, stem)
    build_content_worker(source, env)
    bindings_file, pid_file, log_file = worker_files(stem)
    fd = os.open(log_file, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    with os.fdopen(fd, 'a') as log:
        # A prefix such as `cpu-lane agents` (systemd-run --scope) execs the command, so the
        # recorded PID and start time are the Worker's own.
        proc = subprocess.Popen(
            process_prefix(config) + [str(toolchain_bin(config) / 'node'), str(WORKER_SCRIPT),
                                      str(source / 'packages/content-worker'), str(bindings_file), str(port)],
            cwd=source / 'packages/content-worker', env=env, stdin=subprocess.DEVNULL,
            stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    pid_file.write_text(f'{proc.pid} {process_start_time(proc.pid)}\n')
    pid_file.chmod(0o600)
    for _ in range(120):
        if proc.poll() is not None:
            raise SystemExit(f'content Worker exited ({proc.returncode}); see {log_file}')
        if port_open(port):
            print(f'content Worker on 127.0.0.1:{port} (pid {proc.pid}); private log: {log_file}')
            return proc.pid
        time.sleep(0.5)
    raise SystemExit(f'content Worker did not open port {port}; see {log_file}')


def stop_content_worker(stem):
    """Stop only the recorded Worker process (and the process group it leads)."""
    import signal
    import time
    pid = recorded_worker_pid(stem)
    pid_file = worker_files(stem)[1]
    if not pid:
        pid_file.unlink(missing_ok=True)
        return False
    os.kill(pid, signal.SIGTERM)
    for _ in range(30):
        if recorded_worker_pid(stem) is None:
            break
        time.sleep(0.5)
    else:
        if os.getpgid(pid) == pid:
            os.killpg(pid, signal.SIGKILL)
    pid_file.unlink(missing_ok=True)
    print(f'content Worker stopped (pid {pid})')
    return True


def worker_status(config, stem):
    if not config.get('artifacts'):
        return
    pid = recorded_worker_pid(stem)
    port = worker_port(config)
    state = f'running (pid {pid})' if pid else 'not running'
    print(f'content Worker: {state}; 127.0.0.1:{port} {"open" if port_open(port) else "closed"}')


def restart_web(config, source):
    """Respawn only the raftdev `web` tmux window with its original command."""
    import time
    import urllib.request
    target = f"slock-{config['environment']}:web"
    if subprocess.run(['tmux', 'has-session', '-t', f"slock-{config['environment']}"],
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        raise SystemExit('The stack is not running (no tmux session); use start.')
    prepare_web_env(config, source)
    subprocess.run(['tmux', 'respawn-window', '-k', '-t', target], check=True)
    for _ in range(120):
        time.sleep(1)
        try:
            with urllib.request.urlopen(config['webUrl'], timeout=5) as response:
                if response.status == 200:
                    print('Web dev server restarted: ' + config['webUrl'])
                    return 0
        except OSError:
            pass
    raise SystemExit('Web dev server did not answer after the restart; see `./raftdev logs`.')


def prepare_server_env(config, source):
    """Create/refresh the private server env file and link it as packages/server/.env.

    Returns True when the file content changed. A foreign regular .env is never replaced.
    """
    if not config.get('serverEnvFile'):
        return False
    env_file = Path(config['serverEnvFile']).expanduser()
    existing = read_env_file(env_file)
    values = server_env_values(config, existing, fixture_server_id(config, source))
    changed = values != existing
    if changed or not env_file.exists():
        write_env_file(env_file, values)
    env_file.chmod(0o600)
    link = source / 'packages/server/.env'
    if link.is_symlink():
        if Path(os.readlink(link)) != env_file:
            link.unlink()
    elif link.exists():
        raise SystemExit(f'{link} exists and is not the managed link; move it away first.')
    if not link.exists():
        link.symlink_to(env_file)
    return changed


def write_private_json(path, data):
    tmp = path.with_name(path.name + '.tmp')
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as handle:
        handle.write(json.dumps(data, indent=2) + '\n')
    os.replace(tmp, path)


def restart_server_watch(source):
    """The server runs under node --watch: touching an imported file restarts it, so it re-reads .env."""
    os.utime(source / 'packages/server/src/server.ts')


def toolchain_env(config):
    values = (config.get('toolchain') or {}).get('env', {})
    return {k: os.path.expanduser(str(v)) for k, v in values.items()}


def write_wrapper_dir(config, directory):
    """Create a pnpm wrapper that exports toolchain.env.

    raftdev runs server/web/daemon in tmux windows that do not inherit this
    process's environment (only PATH reaches them), so settings such as
    COREPACK_HOME must travel inside a wrapper that sits first on PATH.
    """
    values = toolchain_env(config)
    if not values:
        return None
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    lines = ['#!/bin/sh'] + [f'export {k}={shlex.quote(v)}' for k, v in sorted(values.items())]
    lines.append(f'exec {shlex.quote(str(toolchain_bin(config) / "pnpm"))} "$@"')
    wrapper = directory / 'pnpm'
    wrapper.write_text('\n'.join(lines) + '\n')
    wrapper.chmod(0o755)
    return directory


def build_env(config, base_env, wrapper_dir=None):
    env = {k: v for k, v in base_env.items() if not k.lower().startswith('npm_config_')}
    path = [str(toolchain_bin(config))]
    if wrapper_dir:
        path.insert(0, str(wrapper_dir))
    env['PATH'] = os.pathsep.join(path) + os.pathsep + env.get('PATH', '')
    env.update(toolchain_env(config))
    env.update(SLOCKDEV_TUNNEL='0', SLOCKDEV_IDLE_TTL_SECONDS='0', SLOCKDEV_TRACE_OBSERVE='0',
               RAFTDEV_RISINGWAVE_IMAGE=config.get('risingwaveImage', DEFAULT_IMAGE))
    return env


DEFAULT_CONTAINER_CPUS = 2
CONTAINER_SUFFIXES = ('pg', 'redis', 'rustfs', 'risingwave', 'otelcol')


def container_cpus(config):
    value = config.get('containerCpus', DEFAULT_CONTAINER_CPUS)
    if isinstance(value, bool) or not isinstance(value, (int, float)) or value < 0:
        raise SystemExit('containerCpus must be a number of CPUs (0 = unlimited).')
    return value


def container_cpu_commands(config, existing):
    """docker update commands for the environment's containers that exist; [] when unlimited."""
    cpus = container_cpus(config)
    if not cpus:
        return []
    names = [f"slock-dev-{config['environment']}-{suffix}" for suffix in CONTAINER_SUFFIXES]
    return [['docker', 'update', '--cpus', f'{cpus:g}', name] for name in names if name in existing]


def apply_container_cpus(config):
    listed = subprocess.run(['docker', 'ps', '-a', '--format', '{{.Names}}'], capture_output=True, text=True)
    commands = container_cpu_commands(config, set(listed.stdout.split()))
    for command in commands:
        subprocess.run(command, check=True, stdout=subprocess.DEVNULL)
    if commands:
        print(f'container CPU limit {container_cpus(config):g} on ' + ', '.join(c[-1] for c in commands))


def process_prefix(config):
    prefix = config.get('processPrefix') or []
    if not isinstance(prefix, list) or not all(isinstance(part, str) and part for part in prefix):
        raise SystemExit('processPrefix must be a list of command words.')
    return prefix


def rw_names(config):
    env = config['environment']
    return f'slock-dev-{env}-risingwave', f'slock-dev-{env}-pg'


def rw_query(config, sql, timeout=8):
    """One RisingWave query through the environment's Postgres container (it is on the RW network)."""
    rw, pg = rw_names(config)
    try:
        result = subprocess.run(
            ['docker', 'exec', '-i', pg, 'psql', '-h', rw, '-p', '4566', '-U', 'root', '-d', 'dev', '-At',
             '-v', 'ON_ERROR_STOP=1', '-c', f"SET statement_timeout = '{timeout - 2}s'", '-c', sql],
            capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return None
    return result.stdout.strip().splitlines()[-1] if result.returncode == 0 and result.stdout.strip() else None


def heartbeat_failures(log_text):
    return sum(1 for line in log_text.splitlines() if 'Failed to send_heartbeat' in line)


def rw_health(config):
    """(ok, summary) for the environment's RisingWave; never raises."""
    import time
    rw, pg = rw_names(config)
    state = subprocess.run(['docker', 'inspect', '-f', '{{.State.Status}}', rw], capture_output=True, text=True)
    if state.returncode != 0:
        return False, 'no container'
    if state.stdout.strip() != 'running':
        return False, 'container ' + state.stdout.strip()
    logs = subprocess.run(['docker', 'logs', '--since', '60s', rw], capture_output=True, text=True)
    failures = heartbeat_failures(logs.stdout + logs.stderr)
    # Checkpoints come every checkpoint_frequency barriers (5 s with the fixture config), so wait
    # up to 15 s for the committed epoch to move. A wedged meta answers nothing or never moves.
    epoch_sql = 'SELECT max(committed_epoch) FROM rw_catalog.rw_hummock_snapshot'
    first = rw_query(config, epoch_sql)
    latest = first
    deadline = time.monotonic() + 15
    while first is not None and latest == first and time.monotonic() < deadline:
        time.sleep(2)
        latest = rw_query(config, epoch_sql)
    if first is None or latest is None:
        epoch = 'epoch: no answer (meta not responding?)'
    elif latest == first:
        epoch = f'epoch: stuck at {latest} for 15 s'
    else:
        epoch = 'epoch: moving'
    pg_latest = subprocess.run(['docker', 'exec', pg, 'psql', '-U', 'postgres', '-d', 'slock', '-At', '-c',
                                'SELECT extract(epoch FROM max(created_at))::bigint FROM messages'],
                               capture_output=True, text=True).stdout.strip()
    rw_latest = rw_query(config, 'SELECT extract(epoch FROM max(created_at))::bigint FROM rw_messages')
    lag_s = None
    if pg_latest.isdigit() and rw_latest and rw_latest.isdigit():
        lag_s = int(pg_latest) - int(rw_latest)
    lag = 'messages lag unknown' if lag_s is None else f'messages lag {lag_s} s'
    # The epoch decides: a wedged meta stops it. Heartbeat timeouts while it still moves are a
    # meta stall that recovered (DEGRADED); a lag only means something while messages arrive.
    moving = epoch == 'epoch: moving' and (lag_s is None or lag_s <= 60)
    label = ('OK' if failures == 0 else 'DEGRADED') if moving else 'UNHEALTHY'
    return moving, f'{label}: meta heartbeat failures in the last minute {failures}; {epoch}; {lag}'


def restart_risingwave(config, source, stem, env):
    """Recreate only the RW container and re-provision it (tool/raft-risingwave.ts)."""
    import time
    apply_patches(source, select_patches(config))
    log = LOCAL / f'{stem}-restart-risingwave.log'
    started = time.monotonic()
    fd = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as output:
        result = subprocess.run(
            process_prefix(config) + ['pnpm', 'exec', 'node', '--import', '@oxc-node/core/register',
                                      str(RISINGWAVE_HELPER), str(source), config['environment']],
            cwd=source / 'packages/server', env=dict(env, RAFT_STACK_CONTAINER_CPUS=f'{container_cpus(config):g}'),
            stdout=output, stderr=subprocess.STDOUT)
    print(f'restart risingwave: exit {result.returncode} after {time.monotonic() - started:.0f} s; private log: {log}')
    if result.returncode == 0:
        apply_container_cpus(config)
        print('RisingWave: ' + rw_health(config)[1])
    return result.returncode


def main(argv):
    global LOCAL
    parsed = parse_args(argv)
    config_path, action = parsed[:2]
    # Logs, PID files and the toolchain wrapper live next to the config, so another worktree's
    # tool/raft-stack can manage the same running stack.
    LOCAL = config_path.resolve().parent
    LOCAL.mkdir(mode=0o700, exist_ok=True)
    if not config_path.exists():
        raise SystemExit(f'Create {config_path} using docs/local-test-stack.md first.')
    config = json.loads(config_path.read_text())
    if len(parsed) == 3 and action == 'flags':
        config = toggle_config_flags(config, *parsed[2])
        write_private_json(config_path, config)
    source = Path(config['sourceDir']).expanduser()
    actual = subprocess.check_output(['git', '-C', str(source), 'rev-parse', 'HEAD'], text=True).strip()
    if actual != config['sourceCommit']:
        raise SystemExit('Source revision differs from the recorded Web reference.')
    stem = 'stack' if config_path.name == 'stack.json' else config_path.stem
    env = build_env(config, os.environ, write_wrapper_dir(config, LOCAL / f'toolchain-{stem}'))
    if action == 'start':
        # Local RisingWave uses a 2 GiB container limit and a 1.5 GiB internal
        # budget; the pinned Source launcher patch survives stack recreation.
        apply_patches(source, select_patches(config))
        prepare_server_env(config, source)
        prepare_web_env(config, source)
    if action == 'restart':
        if parsed[2] == 'web':
            return restart_web(config, source)
        if parsed[2] == 'risingwave':
            return restart_risingwave(config, source, stem, env)
        if not config.get('artifacts'):
            raise SystemExit('No artifacts block in the config: there is no content Worker.')
        # The server keeps running: restart it only if the env file had to change.
        if prepare_server_env(config, source):
            restart_server_watch(source)
        stop_content_worker(stem)
        start_content_worker(config, source, stem, env)
        return 0
    if action == 'sync':
        applied = apply_patches(source, select_patches(config))
        # Always restart the server (node --watch): it reads the env file only at launch,
        # and tokens minted into it later do not change its content hash for us to detect.
        if prepare_server_env(config, source) or config.get('serverEnvFile'):
            restart_server_watch(source)
        apply_feature_flags(config, source)
        if prepare_web_env(config, source):
            print('Web env changed: run `restart web`.')
        if config.get('artifacts') and (prepare_content_worker(config, stem) or not recorded_worker_pid(stem)):
            stop_content_worker(stem)
            start_content_worker(config, source, stem, env)
        apply_container_cpus(config)
        print('synced: patches applied now: ' + (', '.join(applied) or 'none'))
        return 0
    if action == 'stop':
        stop_content_worker(stem)
    if action == 'flags':
        apply_feature_flags(config, source)
        return 0
    args = ['./raftdev', action]
    if action != 'status':
        args.append(config['environment'])
    if action == 'start':
        args += ['--description', 'Raft Flutter Web comparison fixtures', '--risingwave=full']
    log = LOCAL / f'{stem}-{action}.log'
    with log.open('w') as output:
        log.chmod(0o600)
        result = subprocess.run(args, cwd=source, env=env, stdout=output, stderr=subprocess.STDOUT)
    print(f'raftdev {action}: exit {result.returncode}; private local log: {log}')
    if result.returncode == 0 and action == 'start':
        apply_container_cpus(config)
        apply_feature_flags(config, source)
        # The fixture server id exists only now; the freshly started server needs it.
        if prepare_server_env(config, source):
            restart_server_watch(source)
        start_content_worker(config, source, stem, env)
    if action == 'status':
        worker_status(config, stem)
        print('RisingWave: ' + rw_health(config)[1])
    if result.returncode == 0 and action in {'start', 'status', 'ports'}:
        print('Web: ' + config['webUrl'])
        print('API: ' + config['apiUrl'])
    return result.returncode


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
