#!/usr/bin/env python3
"""Build an iOS simulator bundle with its App Group entitlements; never launch it.

Xcode embeds iOS simulator entitlements in the executable's Mach-O sections.
Keep its empty host code-signature entitlements: attaching iOS App Group or
keychain entitlements to that signature makes AMFI reject the process before
Flutter starts. Physical-device signing and provisioning are not changed here.
"""
import argparse
import json
from pathlib import Path
import plistlib
import subprocess
import sys

from android_app import local_dev_version

ROOT = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--build-number', type=int, default=1)
args = parser.parse_args()
if sys.platform != 'darwin' or args.build_number < 1:
    sys.exit('This build helper requires macOS and a positive build number.')
version = local_dev_version(ROOT)
subprocess.run([sys.executable, str(ROOT / 'tool/flutter'), 'build', 'ios',
                '--simulator', '--debug', f'--build-number={args.build_number}',
                f'--dart-define=RAFT_APP_VERSION={version}'],
               cwd=ROOT / 'apps/raft_flutter', check=True)
bundle = ROOT / 'apps/raft_flutter/build/ios/iphonesimulator/Runner.app'
extensions = [bundle / 'PlugIns' / (name + '.appex')
              for name in ('ShareExtension', 'ActionExtension')]
targets = extensions + [bundle]
infos = []
for target in targets:
    with (target / 'Info.plist').open('rb') as stream:
        infos.append(plistlib.load(stream))
app_info = infos[-1]
group = 'group.app.raft.raftFlutter'
expected_ids = ['app.raft.raftFlutter.ShareExtension',
                'app.raft.raftFlutter.ActionExtension', 'app.raft.raftFlutter']
shared_keychain = app_info.get('RaftShareKeychainGroup')
if (not shared_keychain or '$(' in shared_keychain
        or any(info['CFBundleIdentifier'] != identifier
               or info.get('RaftAppGroup') != group
               or info.get('RaftShareKeychainGroup') != shared_keychain
               or info['CFBundleVersion'] != app_info['CFBundleVersion']
               for info, identifier in zip(infos, expected_ids))):
    sys.exit('Unexpected app/extension identity, version or shared groups. Build stopped.')
# Validate Xcode's output without re-signing it. Simulator executables run on
# the host kernel; iOS entitlements must not be copied into their host signature.
for target in targets:
    result = subprocess.check_output(
        ['codesign', '--display', '--xml', '--entitlements', '-', str(target)],
        stderr=subprocess.PIPE)
    if plistlib.loads(result):
        sys.exit('Simulator host signature has entitlements. Build stopped.')
subprocess.run(['codesign', '--verify', '--deep', '--strict', str(bundle)], check=True)
print(json.dumps({'bundle': str(bundle), 'extensions': [str(extension) for extension in extensions],
                  'aboutVersion': version, 'nativeVersion': app_info['CFBundleShortVersionString'],
                  'buildNumber': app_info['CFBundleVersion'], 'appGroup': group,
                  'simulatorOnly': True, 'launched': False}))
