SPEC_APPENDIX = r"""

// raft-flutter parity: unrounded widths of the first text-bearing elements in
// the capture target (evidence for subpixel glyph positioning).
async function parityTextRunWidths(page: Page, selector: string) {
  return page.evaluate((sel) => {
    const out: Array<{ text: string; width: number }> = [];
    for (const element of [...document.querySelectorAll(`${sel}, ${sel} *`)]) {
      if (out.length >= 60) break;
      const own = [...element.childNodes].filter((n) => n.nodeType === 3).map((n) => n.textContent || "").join("").trim();
      if (!own) continue;
      out.push({ text: own.slice(0, 40), width: Math.round(element.getBoundingClientRect().width * 10000) / 10000 });
    }
    return out;
  }, selector);
}

// raft-flutter parity: the faces Chromium actually used to draw the capture's
// text (CDP CSS.getPlatformFontsForNode), glyph counts summed per family.
async function parityCollectPlatformFonts(page: Page, selector: string) {
  const cdp = await page.context().newCDPSession(page);
  await cdp.send("DOM.enable");
  await cdp.send("CSS.enable");
  const { root } = await cdp.send("DOM.getDocument", { depth: -1 });
  const { nodeIds } = await cdp.send("DOM.querySelectorAll", { nodeId: root.nodeId, selector: `${selector}, ${selector} *` });
  const usage: Record<string, number> = {};
  for (const nodeId of nodeIds.slice(0, 600)) {
    try {
      const { fonts } = await cdp.send("CSS.getPlatformFontsForNode", { nodeId });
      for (const font of fonts) {
        const key = `${font.familyName}${font.isCustomFont ? "" : " (system)"}`;
        usage[key] = (usage[key] || 0) + font.glyphCount;
      }
    } catch {
      // nodes without layout have no platform fonts
    }
  }
  await cdp.detach();
  return Object.fromEntries(Object.entries(usage).sort((a, b) => b[1] - a[1]));
}
"""


def patch_exactly_once(text, old, new, what):
    count = text.count(old)
    if count != 1:
        sys.exit(f'upstream {what} changed: patch anchor found {count}x:\n{old[:200]}')
    return text.replace(old, new)


