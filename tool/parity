def prepare_react_provider():
    REACT_GEN.mkdir(parents=True, exist_ok=True)
    prepare_cases(root, RAFT_SOURCE, REACT_GEN, git(RAFT_SOURCE, 'rev-parse', 'HEAD'))
    spec = (VT / 'tests/react-provider.spec.ts').read_text()
    for old, new in SPEC_PATCHES:
        spec = patch_exactly_once(spec, old, new, 'react-provider.spec.ts')
    # Deterministic CSS animations/transitions: every capture call gets
    # Playwright's animations: "disabled" (finite animations/transitions jump
    # to their end state, infinite ones reset to their initial at-rest frame;
    # e.g. Skeleton's animate-pulse is captured at opacity 1, not mid-pulse).
    shot = '.screenshot({ path: imagePath'
    if spec.count(shot) != 4:
        sys.exit(f'upstream react-provider.spec.ts changed: expected 4 screenshot calls, found {spec.count(shot)}')
    spec = spec.replace(shot, shot + ', animations: "disabled"')
    spec = patch_exactly_once(spec,
        '    const parityPlatformFonts = await parityCollectPlatformFonts(page, selector);',
        '    const baselineRepair = await parityVerifyRepairedMarkdown(page, visualCase.id, selector);\n'
        '    const parityPlatformFonts = await parityCollectPlatformFonts(page, selector);', 'baseline render guard')
    spec = patch_exactly_once(spec,
        '          fontSource: "production Google Fonts response for raft-ui fonts.css (raft-flutter parity deviation from upstream stub)",',
        '          ...(baselineRepair ? { baselineRepair } : {}),\n'
        '          fontSource: "production Google Fonts response for raft-ui fonts.css (raft-flutter parity deviation from upstream stub)",', 'baseline repair metadata')
    (REACT_GEN / 'react-provider.spec.ts').write_text(spec + SPEC_APPENDIX + BASELINE_REPAIR_GUARD)
    # Same module type as the upstream package (packages/visual-testing is ESM).
    (REACT_GEN / 'package.json').write_text(json.dumps({'type': json.loads((VT / 'package.json').read_text())['type']}) + '\n')
    web = RAFT_SOURCE / 'packages/web'
    config = (web / 'playwright.visual-testing.config.ts').read_text()
    for old, new in [
        ('const require = createRequire(import.meta.url);',
         f'const require = createRequire({json.dumps(str(web / "package.json"))});'),
        ('require("../visual-testing/shared/fixtureData.json")',
         f'require({json.dumps(str(SHARED / "fixtureData.json"))})'),
        ('  testDir: "../visual-testing/tests",',
         f'  testDir: {json.dumps(str(REACT_GEN))},\n  testMatch: "react-provider.spec.ts",\n'
         f'  outputDir: {json.dumps(str(OUT / "playwright-test-results"))},'),
        ('    deviceScaleFactor: 3,',
         '    deviceScaleFactor: 3,\n'
         '    // raft-flutter parity: Chromium text rasterization flags (see docs/parity.md "Text rendering").\n'
         '    launchOptions: { args: JSON.parse(process.env.PARITY_CHROMIUM_ARGS || "[]") },'),
        ('    url: `http://127.0.0.1:${port}`,',
         f'    cwd: {json.dumps(str(web))},\n    url: `http://127.0.0.1:${{port}}`,'),
        ('    command: `pnpm exec vite --host 127.0.0.1 --port ${port}`,',
         '    command: ' + json.dumps('node ' + str(root / 'tool/parity-baseline-web.mjs')) + ','),
    ]:
        config = patch_exactly_once(config, old, new, 'playwright.visual-testing.config.ts')
    (REACT_GEN / 'playwright.visual-testing.config.ts').write_text(config)
    return REACT_GEN / 'playwright.visual-testing.config.ts'


