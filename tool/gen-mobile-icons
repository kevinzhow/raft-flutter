#!/usr/bin/env python3
"""Render packaged mobile palettes from the unchanged Raft brand vector.
Requires rsvg-convert; no account data or runtime-generated launcher bitmaps.
"""
from pathlib import Path
import json
import re
import subprocess
import sys
import tempfile
import xml.etree.ElementTree as ET

ROOT = Path(__file__).resolve().parent.parent
APP = ROOT / 'apps/raft_flutter'
RES = APP / 'android/app/src/main/res'
ASSETS = APP / 'ios/Runner/Assets.xcassets'
A = '{http://schemas.android.com/apk/res/android}'
PALETTE = [('yellow', 'brutalYellow'), ('blue', 'brutalCyan'),
           ('green', 'brutalLime'), ('white', 'codeSurface'), ('pink', 'brutalPink')]
SPLASH_ICON = '@mipmap/ic_launcher_{name}'  # adaptive icon: the system masks it like the launcher
TILE = 112  # dp / pt of the launch icon tile
source = ET.parse(RES / 'drawable/ic_launcher_foreground.xml').getroot()
paths = source.find('group').findall('path')
tokens = (ROOT / 'packages/raft_ui/lib/src/tokens/product_colors.g.dart').read_text()
colors = {name: re.search(r'\b' + token + r': Color\(0xff([0-9a-f]{6})\)', tokens).group(1).upper()
          for name, token in PALETTE}
mark = ''.join(f'<path fill="#{p.attrib[A + "fillColor"][-6:]}" d="{p.attrib[A + "pathData"]}"/>' for p in paths)

# `--no-raster` rewrites only the text resources (no rsvg-convert needed).
RASTER = '--no-raster' not in sys.argv

def render(path, size, background=None, dark=False, fill_ratio=.625):
    if not RASTER:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    art = mark
    if dark:
        art = ''.join(f'<path fill="#{"FFFAEF" if p.attrib[A+"fillColor"][-6:] == "000000" else "141111"}" d="{p.attrib[A+"pathData"]}"/>' for p in paths)
    width = size * fill_ratio
    x, y = (size-width)/2, (size-width*253/274)/2
    bg = f'<rect width="{size}" height="{size}" fill="#{background}"/>' if background else ''
    svg = f'<svg xmlns="http://www.w3.org/2000/svg" width="{size}" height="{size}" viewBox="0 0 {size} {size}">{bg}<g transform="translate({x} {y}) scale({width/274})">{art}</g></svg>'
    with tempfile.NamedTemporaryFile(suffix='.svg', mode='w') as f:
        f.write(svg); f.flush()
        subprocess.run(['rsvg-convert', f.name, '-o', str(path)], check=True)

def write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(value)

write(ROOT/'packages/raft_ui/lib/src/app_icon_mark.g.dart',
      "// GENERATED by tool/gen-mobile-icons from Android's official foreground.\n"
      "part of 'brand.dart';\n\nconst RaftBrandSvg _raftAppIcon = RaftBrandSvg(\n"
      "  width: 274,\n  height: 253,\n  paths: [\n" + ''.join(
          f"    (\n      0x{p.attrib[A+'fillColor'][1:]},\n      '{p.attrib[A+'pathData']}',\n    ),\n" for p in paths)
      + "  ],\n);\n")
base = json.loads((ASSETS / 'AppIcon.appiconset/Contents.json').read_text())
for name, _ in PALETTE:
    # iOS 15+ retains explicit phone/iPad size slots for compatibility.
    folder = ASSETS / ('AppIcon' if name == 'yellow' else 'AppIcon' + name.title())
    folder = folder.with_suffix('.appiconset')
    write(folder/'Contents.json', json.dumps(base, indent=2)+'\n')
    for entry in base['images']:
        size = round(float(entry['size'].split('x')[0]) * int(entry['scale'][0]))
        render(folder/entry['filename'], size, colors[name])
    adaptive = f'''<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/raft_icon_{name}" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
'''
    write(RES/f'mipmap-anydpi-v26/ic_launcher_{name}.xml', adaptive)
    write(RES/f'mipmap-anydpi-v33/ic_launcher_{name}.xml', adaptive.replace('</adaptive-icon>', '    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />\n</adaptive-icon>'))
    for density, size in [('mdpi',48),('hdpi',72),('xhdpi',96),('xxhdpi',144),('xxxhdpi',192)]:
        render(RES/f'mipmap-{density}/ic_launcher_{name}.png', size, colors[name], fill_ratio=56/72)
    # <= Android 11 launch window: theme canvas + the chosen icon as a centred
    # tile (Android 12+ draws the icon itself from the alias/persisted theme).
    write(RES/f'drawable/launch_tile_{name}.xml', f'''<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="{TILE}dp" android:height="{TILE}dp" android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="@color/raft_icon_{name}" />
            <corners android:radius="{TILE * 0.2237:.1f}dp" />
        </shape>
    </item>
    <item android:width="{TILE}dp" android:height="{TILE}dp" android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
''')
    write(RES/f'drawable/launch_{name}.xml', f'''<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/raft_canvas_system_brutal" />
    <item android:drawable="@drawable/launch_tile_{name}" />
</layer-list>
''')
write(RES/'values/raft_icon_colors.xml', '<resources>\n'+''.join(f'    <color name="raft_icon_{n}">#{c}</color>\n' for n,c in colors.items())+'</resources>\n')
# Entry-activity themes (the alias target). They decide the starting window on
# Android <= 32 (system day/night canvas + the icon of that alias); on 33+ the
# persisted splash theme below wins. Both the platform and the AndroidX
# attributes are needed: routing transfers the system splash on 31+, never
# draws another page.
for qualifier, parent in [('values','RaftLaunchWindow'),('values-v31','RaftSystemSplash'),('values-v33','RaftSystemSplash')]:
    styles = '<resources>\n'
    for name,_ in PALETTE:
        styles += f'''    <style name="IconLaunch{name.title()}" parent="{parent}">
        <item name="android:windowBackground">@drawable/launch_{name}</item>
        <item name="windowSplashScreenBackground">@color/raft_canvas_system_brutal</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
'''
        if qualifier != 'values':
            styles += f'''        <item name="android:windowSplashScreenBackground">@color/raft_canvas_system_brutal</item>
        <item name="android:windowSplashScreenAnimatedIcon">{SPLASH_ICON.format(name=name)}</item>
'''
        if qualifier == 'values-v33':
            styles += '        <item name="android:windowSplashScreenBehavior">icon_preferred</item>\n'
        styles += '    </style>\n'
    write(RES/f'{qualifier}/raft_icon_styles.xml',styles+'</resources>\n')
# Android 13+: the app persists ONE splash theme with
# SplashScreen.setSplashScreenTheme (LaunchTheme.kt). The system applies it to
# every later launch, before the process draws anything, so it carries the
# stored appearance (canvas + system bar style) and the chosen icon:
# RaftSplash_<kind>_<icon>. `system_*` kinds resolve the canvas through the
# -night qualifier at launch time.
KINDS = [('brutal_light', '@color/raft_canvas_brutal_light', 'true'),
         ('elegant_light', '@color/raft_canvas_elegant_light', 'true'),
         ('dark', '@color/raft_canvas_elegant_dark', 'false'),
         ('system_brutal', '@color/raft_canvas_system_brutal', '@bool/raft_launch_light_bars'),
         ('system_elegant', '@color/raft_canvas_system_elegant', '@bool/raft_launch_light_bars')]
themes = '<?xml version="1.0" encoding="utf-8"?>\n<!-- GENERATED by tool/gen-mobile-icons. -->\n<resources>\n'
for kind, canvas, light in KINDS:
    themes += f'''    <style name="RaftSplash_{kind}" parent="RaftSystemSplash">
        <item name="android:windowSplashScreenBackground">{canvas}</item>
        <item name="android:colorBackground">{canvas}</item>
        <item name="android:statusBarColor">{canvas}</item>
        <item name="android:navigationBarColor">{canvas}</item>
        <item name="android:windowLightStatusBar">{light}</item>
        <item name="android:windowLightNavigationBar">{light}</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>
'''
    for name,_ in PALETTE:
        themes += f'''    <style name="RaftSplash_{kind}_{name}" parent="RaftSplash_{kind}">
        <item name="android:windowSplashScreenAnimatedIcon">{SPLASH_ICON.format(name=name)}</item>
    </style>
'''
write(RES/'values-v33/raft_splash_themes.xml', themes+'</resources>\n')
# iOS: the system LaunchScreen is static and shows only the theme canvas
# (light/dark follow the system; it cannot know the stored theme or icon).
# SceneDelegate.swift then draws the chosen icon as a tile: LaunchMark is the
# mark inside that tile (always the light/cream+ink version, like the icon).
launch = ASSETS/'LaunchMark.imageset'
render(launch/'mark-light.png', 360, fill_ratio=.92)
write(launch/'Contents.json', json.dumps({'images':[
    {'idiom':'universal','filename':'mark-light.png'}],
    'info':{'author':'xcode','version':1}},indent=2)+'\n')
# Launch canvas = page body of the first Flutter frame (docs/theme-tokens
# `layer-canvas-muted`): white Brutal light, #F8F8F7 Elegant light, #0D0D0B
# Elegant dark. LaunchBackground (system LaunchScreen + Brutal) / LaunchBackgroundElegant.
def component(value):
    return f'{value / 255:.3f}'
def colorset(light, dark):
    return json.dumps({'colors':[
        {'idiom':'universal','color':{'color-space':'srgb','components':dict(zip(('red','green','blue'), map(component, light)), alpha='1.000')}},
        {'idiom':'universal','appearances':[{'appearance':'luminosity','value':'dark'}],
         'color':{'color-space':'srgb','components':dict(zip(('red','green','blue'), map(component, dark)), alpha='1.000')}}],
        'info':{'author':'xcode','version':1}},indent=2)+'\n'
CANVAS_DARK = (13, 13, 11)
write(ASSETS/'LaunchBackground.colorset/Contents.json', colorset((255, 255, 255), CANVAS_DARK))
write(ASSETS/'LaunchBackgroundElegant.colorset/Contents.json', colorset((248, 248, 247), CANVAS_DARK))
print('Generated five mobile palettes, launch resources and theme canvas colours.')
