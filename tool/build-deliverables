#!/usr/bin/env python3
"""Build local acceptance artifacts from the currently verified native source."""
import hashlib
import base64
import json
import os
import pathlib
import re
import shutil
import subprocess
import tarfile
import struct
import zlib

from release import linux_package


def complete_png(data):
    """Require a whole current PNG, including chunk checksums, before publishing."""
    if not data.startswith(b'\x89PNG\r\n\x1a\n') or len(data) > 25 * 1024 * 1024:
        return False
    offset, header, pixels = 8, False, False
    while offset + 12 <= len(data):
        size = struct.unpack('>I', data[offset:offset + 4])[0]
        end = offset + 12 + size
        if end > len(data):
            return False
        kind, body = data[offset + 4:offset + 8], data[offset + 8:end - 4]
        if zlib.crc32(kind + body) & 0xffffffff != struct.unpack('>I', data[end - 4:end])[0]:
            return False
        if not header:
            if kind != b'IHDR' or size != 13:
                return False
            width, height = struct.unpack('>II', body[:8])
            if not (0 < width <= 8192 and 0 < height <= 8192):
                return False
            header = True
        if kind == b'IDAT':
            pixels = True
        if kind == b'IEND':
            return size == 0 and pixels and end == len(data)
        offset = end
    return False

def digest(path):
    with path.open('rb') as source:
        return hashlib.file_digest(source, 'sha256').hexdigest()



root = pathlib.Path(__file__).resolve().parent.parent
app = root / 'apps/raft_flutter'
output = root / 'build/deliverables'
output.mkdir(parents=True, exist_ok=True)
source_hash = subprocess.check_output([str(root / 'tool/source-hash')], text=True).strip()
evidence_receipts = {}
engineering = json.loads((root / '.local/engineering-run.json').read_text())
if (engineering.get('completed') is not True or engineering.get('sourceHash') != source_hash
        or engineering.get('checks', {}).get('host-collector-tests.txt') is not True):
    raise SystemExit('Build stopped: current source needs a passing engineering run.')
for platform in ['linux', 'android']:
    manifest = json.loads((root / f'.local/native-e2e/native-{platform}-run.json').read_text())
    log = (root / ('.local/native-linux-fleet.txt' if platform == 'linux' else '.local/native-android-test.txt')).read_text()
    if (manifest.get('completed') is not True or manifest.get('platform') != platform
            or manifest.get('sourceHash') != source_hash
            or f"Native evidence run: {platform} {manifest['runId']}" not in log
            or 'All tests passed!' not in log):
        raise SystemExit(f'Build stopped: {platform} needs a passing native run of current source.')
    checkpoints = root / f'.local/native-e2e/native-{platform}-checkpoints.tsv'
    pictures = {}
    for line in checkpoints.read_text().splitlines():
        columns = line.split('\t')
        if (len(columns) != 3 or columns[2] != manifest['runId']
                or not re.fullmatch(platform + r'-[a-z-]+', columns[0])
                or not re.fullmatch(r'[0-9TZ:+.-]+', columns[1]) or 'failure' in columns[0]):
            raise SystemExit(f'Build stopped: {platform} checkpoint inventory is not current.')
        picture = root / '.local/native-e2e' / (columns[0] + '.png')
        if not picture.is_file():
            raise SystemExit(f'Build stopped: {platform} checkpoint image missing.')
        data = picture.read_bytes()
        if not complete_png(data):
            raise SystemExit(f'Build stopped: {platform} checkpoint image is incomplete.')
        pictures[picture.name] = digest(picture)
    if not pictures:
        raise SystemExit(f'Build stopped: {platform} checkpoint inventory is empty.')
    evidence_receipts[platform] = {
        **manifest, 'checkpointsSha256': digest(checkpoints), 'images': pictures,
        'logSha256': digest(root / ('.local/native-linux-fleet.txt' if platform == 'linux' else '.local/native-android-test.txt')),
    }
shade_receipt = root / '.local/native-e2e/android-os-notification-click.json'
shade_image = root / '.local/native-e2e/android-os-notification-shade.png'
if not shade_receipt.is_file() or not shade_image.is_file():
    raise SystemExit('Build stopped: Android OS notification evidence is missing.')
notification = json.loads(shade_receipt.read_text())
if (notification.get('clicked') is not True
        or notification.get('runId') != evidence_receipts['android']['runId']
        or notification.get('sourceHash') != source_hash
        or not complete_png(shade_image.read_bytes())):
    raise SystemExit('Build stopped: Android OS notification evidence is stale.')
evidence_receipts['android']['osNotification'] = {
    **notification, 'imageSha256': digest(shade_image),
}
for name, marker in [('all-project-tests.txt', 'All tests passed!'), ('analyze-all.txt', 'No issues found!'), ('host-collector-tests.txt', '\nOK\n')]:
    if engineering.get('checks', {}).get(name) is not True or marker not in (root / '.local' / name).read_text():
        raise SystemExit('Build stopped: engineering check incomplete.')
# Do not pass verification fixture paths, secrets, or test feature defines.
release_env = dict(os.environ)
release_env.pop('DART_DEFINES', None)
# Flutter release regeneration excludes dev-only native plugins. --no-pub
# skips this regeneration and can retain a preceding integration-test registrant.
# The exact source hash (including lockfiles) must still remain unchanged below.
for target in ['linux', 'apk']:
    with (root / f'.local/release-{target}.txt').open('w') as log:
        subprocess.run([str(root / 'tool/flutter'), 'build', target, '--release', '--target=lib/main.dart'],
                       cwd=app, env=release_env, stdout=log, stderr=subprocess.STDOUT, check=True)
    if subprocess.check_output([str(root / 'tool/source-hash')], text=True).strip() != source_hash:
        raise SystemExit('Build stopped: source changed while compiling.')
    if target == 'linux':
        config = (app / 'linux/flutter/ephemeral/generated_config.cmake').read_text()
        match = re.search(r'"DART_DEFINES=([^"\n]*)"', config)
        if match:
            for value in match[1].split(','):
                decoded = base64.b64decode(value).decode()
                if not decoded.startswith('FLUTTER_'):
                    raise SystemExit('Build stopped: unexpected release Dart define.')
staging = root / 'build/raft-flutter-linux-x64'
if staging.exists():
    shutil.rmtree(staging)
# The local acceptance path shares the same thin-system staging policy as CI.
# Never restore the retired media closure or transitive DT_RPATH rewriting.
linux_package(staging)
with tarfile.open(output / 'raft-flutter-linux-x64.tar.gz', 'w:gz') as archive:
    archive.add(staging, arcname=staging.name)
shutil.copy2(app / 'build/app/outputs/flutter-apk/app-release.apk', output / 'raft-flutter-android.apk')
metadata = {'sourceHash': source_hash, 'flutter': '3.47.8', 'dart': '3.13.7',
            'productCommit': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, text=True).strip(),
            'reference': json.loads((root / 'docs/source-reference.json').read_text())['commit'],
            'androidSigning': 'local debug keystore; acceptance only',
            'deliveryTools': {name: digest(root / name) for name in ['tool/build-deliverables', 'tool/publish-report']},
            'nativeEvidence': evidence_receipts,
            'engineeringEvidence': {'manifest': engineering, 'logs': {
                name: digest(root / '.local' / name) for name in ['all-project-tests.txt', 'analyze-all.txt', 'host-collector-tests.txt']}},
            'linuxPackaging': json.loads((staging / 'linux-system-runtime.json').read_text()),
            'artifacts': {}}
for name in ['raft-flutter-android.apk', 'raft-flutter-linux-x64.tar.gz']:
    path = output / name
    metadata['artifacts'][name] = {'sha256': digest(path), 'bytes': path.stat().st_size}
if subprocess.check_output([str(root / 'tool/source-hash')], text=True).strip() != source_hash:
    raise SystemExit('Build stopped: source changed while packaging.')
(output / 'build-manifest.json').write_text(json.dumps(metadata, indent=2) + '\n')
(output / 'CHECKSUMS.txt').write_text(''.join(f"{row['sha256']}  {name}\n" for name, row in metadata['artifacts'].items()))
print(json.dumps({'sourceHash': source_hash, 'manifest': str(output / 'build-manifest.json'),
                  'artifacts': metadata['artifacts']}, indent=2))
