#!/usr/bin/env python3
"""raft-flutter parity EXTENSION suite on the official visual-testing framework.

  tool/parity-ext/run run [--cases <id|glob>[,...]] [--refresh-react] [--shards N] [--skip-flutter]
  tool/parity-ext/run dom-dump [--cases <id|glob>[,...]] [--out DIR]   # diagnostic, writes no PNGs
  tool/parity-ext/run summary
  tool/parity-ext/run publish [--no-verify]

Same pipeline as tool/parity (official React provider spec + Playwright config
as generated copies, Flutter provider test/parity/parity_capture_test.dart,
official `cli.mjs diff` + `site`), pointed at the extension manifest
(sharedCases.json schema, ids components.<area>.*) instead of the official case
set, which stays untouched. The manifest is NOT committed: every invocation
builds <out>/cases.json by running the discovered tool/parity-ext/build-*.py
(builders.py: build-cases.py first, then optional `ORDER = n`, then file name), then derives cases.sampled.json
(theme sampling: brutal-light complete, elegant themes 1-2 per surface,
tool/parity-ext/sampling.py) from it. Differences from tool/parity, all generated,
never edits to the Source checkout:
  * render host: tool/parity-ext-web.mjs (official host + appended
    tool/parity-ext/host/*.tsx + parityTheme root override);
  * provider spec: answers tool/parity-ext/fixtures/*.json `routes` (and the
    search overlay's /messages/search `search` rules), supports `hover` and
    `press` {target, key} interactions, and parks the pointer after click interactions
    (Flutter taps leave no hover);
  * deviceScaleFactor follows each case's viewport.density (desktop cases 1);
  * React captures come from a content-addressed cache shared by all worktrees
    (react_cache.py; PARITY_EXT_CACHE, default
    <main checkout>/../raft-flutter-wt/.parity-cache): hit = copied, Playwright
    skipped; miss = captured and stored; --refresh-react recaptures and overwrites;
  * the summary adds a non-text score per case and a geometry verdict
    (analyze-diffs.py), next to the unchanged official 96% pass;
  * output build/parity-ext/ (PARITY_EXT_OUT); publish to
    <reports>/raft_flutter_parity_ext/<stamp> + latest (never the official
    raft_flutter_parity/).
"""
import argparse
import datetime as dt
import importlib.machinery
import importlib.util
import json
import os
import pathlib
import shutil
import subprocess
import sys
import time
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / 'tool'))  # tool/parity's sibling modules
loader = importlib.machinery.SourceFileLoader('parity_ext_official_adapter', str(ROOT / 'tool/parity'))
spec = importlib.util.spec_from_loader(loader.name, loader)
parity = importlib.util.module_from_spec(spec)
loader.exec_module(parity)

EXT = ROOT / 'tool/parity-ext'
sys.path.insert(0, str(EXT))
import builders  # noqa: E402  (tool/parity-ext/builders.py)
import react_cache  # noqa: E402  (tool/parity-ext/react_cache.py)
import sampling  # noqa: E402  (tool/parity-ext/sampling.py: theme sampling rule)

_ad_loader = importlib.machinery.SourceFileLoader('parity_ext_analyze_diffs', str(EXT / 'analyze-diffs.py'))
analyze = importlib.util.module_from_spec(importlib.util.spec_from_loader(_ad_loader.name, _ad_loader))
sys.modules[_ad_loader.name] = analyze  # forked classifier workers resolve their function by module name
_ad_loader.exec_module(analyze)

FIXTURES = EXT / 'fixtures'
OUT = pathlib.Path(os.environ.get('PARITY_EXT_OUT', ROOT / 'build/parity-ext'))
PUBLISH_DIR = parity.REPORTS / 'raft_flutter_parity_ext'
WEB_PORT = os.environ.get('PARITY_EXT_WEB_PORT', '4396')
TEXT_RENDER = 'android'  # grayscale AA + unhinted advances: see docs/parity.md "Text rendering"

# Point the official adapter at the extension output and manifest.
parity.OUT = OUT
parity.RESULTS = OUT / 'visual-testing-results'
parity.SITE = OUT / 'site'
parity.REACT_GEN = OUT / 'react-provider'
parity.WEB_PORT = WEB_PORT


MANIFEST = OUT / 'cases.json'  # generated by builders.build_manifest (never committed)
FULL_MANIFEST = MANIFEST


def write_sampled_manifest():
    global MANIFEST
    OUT.mkdir(parents=True, exist_ok=True)
    builders.build_manifest(OUT)
    sampled = sampling.sample_themes(json.loads(FULL_MANIFEST.read_text()))
    MANIFEST = OUT / 'cases.sampled.json'
    MANIFEST.write_text(json.dumps(sampled, indent=2) + '\n')


def ext_cases():
    return json.loads(MANIFEST.read_text())['cases']


parity.manifest_cases = ext_cases


def cli(*args, log=None):
    """Official CLI, unmodified, with the extension manifest."""
    cmd = ['node', str(parity.VT / 'src/cli.mjs'), *args, '--manifest', str(MANIFEST)]
    print('+', ' '.join(cmd), flush=True)
    with (open(log, 'a') if log else open(os.devnull, 'w')) as sink:
        result = subprocess.run(cmd, cwd=parity.VT, env=parity.node_env(),
                                stdout=sink if log else None, stderr=subprocess.STDOUT if log else None)
    if result.returncode != 0:
        sys.exit(f'official CLI failed: {" ".join(args)} (exit {result.returncode})' + (f'; see {log}' if log else ''))


SPEC_EXT_PATCHES = [
    # Per-case clock: `props.clockIso` replaces the fixture instant (plan limits
    # that depend on the trial end date, relative labels).
    ('      await page.clock.setFixedTime(new Date(fixtureNowEpochMillis));',
     '      const parityExtClock = (visualCase.variants?.[0]?.props as Record<string, string> | undefined)?.clockIso;\n'
     '      await page.clock.setFixedTime(new Date(parityExtClock ? Date.parse(parityExtClock) : fixtureNowEpochMillis));'),
    ('    await page.goto(caseUrl(visualCase));',
     '    await parityExtRoutes(page, visualCase);\n    await page.goto(caseUrl(visualCase));'),
    ('    } else if (interaction.type === "fill" && interaction.target) {',
     '    } else if ((interaction.type as string) === "hover" && interaction.target) {\n'
     '      await page.locator(interaction.target).first().hover();\n'
     '    } else if ((interaction.type as string) === "press" && interaction.target) {\n'
     '      await page.locator(interaction.target).first().press(String((interaction as any).key));\n'
     '    } else if ((interaction.type as string) === "scroll" && interaction.target) {\n'
     '      // Wheel over the target (y < 0 scrolls the list up), then let it settle.\n'
     '      await page.locator(interaction.target).first().hover();\n'
     '      await page.mouse.wheel(0, Number((interaction as { y?: number }).y ?? 0));\n'
     '      await page.waitForTimeout(400);\n'
     '    } else if (interaction.type === "fill" && interaction.target) {'),
    ('    await page.setViewportSize({ width: viewport.width, height: viewport.height });',
     '    await page.setViewportSize({ width: viewport.width, height: viewport.height });\n'
     '    // Extension: `viewport.touch` reports a phone pointer, `(hover: none)`\n'
     '    // and `(pointer: coarse)`, like Android Chrome.\n'
     '    if ((viewport as { touch?: boolean }).touch) {\n'
     '      const parityExtCdp = await page.context().newCDPSession(page);\n'
     '      await parityExtCdp.send("Emulation.setTouchEmulationEnabled", { enabled: true, maxTouchPoints: 5 });\n'
     '    }'),
    # Native right click (a real `contextmenu` event at the element centre, or
    # at `x`,`y` from its top-left); the official `contextmenu` type only waits
    # for the message context menu.
    ('    } else if (interaction.type === "fill" && interaction.target) {',
     '    } else if ((interaction.type as string) === "rightclick" && interaction.target) {\n'
     '      await page.locator(interaction.target).first().click({ button: "right",\n'
     '        position: interaction.x === undefined ? undefined : { x: interaction.x, y: interaction.y ?? 0 } });\n'
     '    } else if (interaction.type === "fill" && interaction.target) {'),
    ('    await applyInteractions(page, visualCase);',
     '    await applyInteractions(page, visualCase);\n'
     '    // Extension: Flutter taps leave no hover; park the pointer off the\n'
     '    // captured surfaces unless the case asked for a hover state.\n'
     '    const parityExtSteps = [...(visualCase.capture?.interactions || [])];\n'
     '    if (!parityExtSteps.some((s) => (s.type as string) === "hover")) {\n'
     '      await page.mouse.move(viewport.width - 1, viewport.height - 1);\n'
     '    }'),
    # Diagnostic: PARITY_EXT_DOM_DUMP=<dir> writes the DOM geometry/style of the
    # capture target to <dir>/<caseId>.json and ends the test before any PNG or
    # metadata is written, so normal captures are unaffected.
    ('    await parityPrepareRepairedNotification(page, visualCase.id);\n',
     '    await parityPrepareRepairedNotification(page, visualCase.id);\n'
     '    if (process.env.PARITY_EXT_DOM_DUMP) {\n'
     '      await parityExtDomDump(page, selector, visualCase.id, process.env.PARITY_EXT_DOM_DUMP);\n'
     '      return;\n'
     '    }\n'),
]
SPEC_EXT_APPENDIX = r'''

// raft-flutter parity extension: endpoints the mounted components call after
// the first render, answered from tool/parity-ext/fixtures/*.json `routes`
// ("METHOD /path" -> JSON body), the same data the Flutter fixture client serves.
async function parityExtRoutes(page: Page, visualCase: VisualCase) {
  const dir = process.env.PARITY_EXT_FIXTURES!;
  const { readdirSync, appendFileSync, mkdirSync } = await import("node:fs");
  // Debug aid: PARITY_EXT_LOG_REQUESTS=<dir> lists every /api request a case
  // makes (to align the fixture routes both providers answer).
  const logDir = process.env.PARITY_EXT_LOG_REQUESTS;
  if (logDir) {
    mkdirSync(logDir, { recursive: true });
    page.on("request", (request: any) => {
      const url = new URL(request.url());
      if (url.pathname.startsWith("/api/")) {
        appendFileSync(resolve(logDir, `${visualCase.id}.txt`), `${request.method()} ${url.pathname}${url.search}\n`);
      }
    });
  }
  const props = (visualCase.variants?.[0]?.props || {}) as Record<string, string>;
  for (const file of readdirSync(dir).filter((f: string) => f.endsWith(".json"))) {
    // A case may pin its fixture (`props.extFixture`): routes of the other families
    // (e.g. settings' GET /agents) must not shadow its own.
    if (props.extFixture && file !== `${props.extFixture}.json`) continue;
    const fixture = JSON.parse(readFileSync(resolve(dir, file), "utf8"));
    // The machine list the case's page loaded (the Sidebar re-reads it on
    // mount): fixture `lists[props.list]`, the detail variant replacing its
    // row; `loading` keeps the read in flight like the Flutter side.
    if (fixture.lists && props.list) {
      const detail = props.machine ? fixture.machines[props.machine] : null;
      const machines = fixture.lists[props.list].map((id: string) =>
        detail && detail.id === id ? detail : fixture.machines[id]);
      await page.route((url: URL) => /^\/api\/servers\/[^/]+\/machines$/.test(url.pathname), (route: any) => {
        if (route.request().method() !== "GET") return route.fallback();
        if (String(props.loading) === "true") return;
        return route.fulfill({ status: 200, contentType: "application/json", body: JSON.stringify({
          machines, latestComputerVersion: fixture.latestComputerVersion, latestComputerReleaseNotes: null }) });
      });
    }
    // props.routeSet selects per-case overrides from `routeSets`:
    // {"$pending": true} never answers (loading), {"$status": N} answers N.
    const routes = { ...(fixture.routes || {}), ...((fixture.routeSets || {})[props.routeSet] || {}) };
    // Search overlay: GET /messages/search answered from fixture.search by the
    // request's q (+ senderId); case prop searchMode "pending" never answers
    // (skeleton), "error" answers HTTP 500.
    if (fixture.search && props.extKind === "search-overlay") {
      await page.route((url: URL) => url.pathname === "/api/messages/search", (route: any) => {
        if (route.request().method() !== "GET") return route.fallback();
        if (props.searchMode === "pending") return;
        if (props.searchMode === "error") {
          return route.fulfill({ status: 500, contentType: "application/json", body: JSON.stringify({ error: "Internal Server Error" }) });
        }
        const params = new URL(route.request().url()).searchParams;
        const q = (params.get("q") || "").trim().toLowerCase();
        const senderId = params.get("senderId") || "";
        const rule = fixture.search.responses.find((r: any) => r.q === q && (r.senderId || "") === senderId);
        return route.fulfill({ status: 200, contentType: "application/json", body: JSON.stringify(rule ? rule.body : fixture.search.fallback) });
      });
    }
    for (const [key, body] of Object.entries(routes)) {
      const [method, path] = key.split(" ");
      await page.route((url: URL) => url.pathname === `/api${path}`, (route: any) => {
        if (route.request().method() !== method) return route.fallback();
        // `{"$when": [{"query": {"dirPath": "notes"}, "answer": A}], "$default": B}` answers one path differently
        // by query string (the Flutter fixture client applies the same rule).
        let answer: any = body;
        const when = (body as any)?.$when;
        if (Array.isArray(when)) {
          const params = new URL(route.request().url()).searchParams;
          const hit = when.find((w: any) => Object.entries(w.query || {}).every(([k, v]) => params.get(k) === v));
          answer = hit ? hit.answer : (body as any).$default;
        }
        const special = (answer || {}) as { $pending?: boolean; $status?: number; $body?: unknown; $file?: string; $contentType?: string };
        if (special.$pending) return;
        // `{"$file": "name.png", "$contentType": "image/png"}` answers the bytes of a fixture file.
        if (special.$file) {
          return route.fulfill({ status: 200, contentType: special.$contentType || "application/octet-stream",
            body: readFileSync(resolve(dir, special.$file)) });
        }
        if (special.$status) {
          return route.fulfill({ status: special.$status, contentType: "application/json",
            body: JSON.stringify(special.$body ?? { error: "fixture error" }) });
        }
        return route.fulfill({ status: 200, contentType: "application/json", body: JSON.stringify(answer) });
      });
    }
  }
}

// Diagnostic (PARITY_EXT_DOM_DUMP): depth-first dump of every element under the
// capture target with its rect relative to the target's top-left and the
// computed style that drives layout/paint. SVG internals are not descended.
async function parityExtDomDump(page: Page, selector: string, caseId: string, dir: string) {
  const dump = await page.locator(selector).first().evaluate((root: Element) => {
    const r0 = root.getBoundingClientRect();
    const r2 = (n: number) => Math.round(n * 100) / 100;
    const nodes: any[] = [];
    const visit = (el: Element, depth: number) => {
      const r = el.getBoundingClientRect();
      const cs = getComputedStyle(el);
      const own = Array.from(el.childNodes).filter((n) => n.nodeType === 3)
        .map((n) => (n.textContent || "").replace(/\s+/g, " ").trim()).filter(Boolean).join(" ");
      nodes.push({
        depth,
        tag: el.tagName.toLowerCase(),
        testid: el.getAttribute("data-testid") || undefined,
        slot: el.getAttribute("data-slot") || undefined,
        cls: (typeof (el as any).className === "string" ? (el as any).className : el.getAttribute("class") || "").slice(0, 200),
        text: own ? own.slice(0, 60) : undefined,
        rect: { x: r2(r.x - r0.x), y: r2(r.y - r0.y), w: r2(r.width), h: r2(r.height) },
        style: {
          display: cs.display, position: cs.position, flexDirection: cs.flexDirection,
          alignItems: cs.alignItems, justifyContent: cs.justifyContent, whiteSpace: cs.whiteSpace,
          textOverflow: cs.textOverflow, overflow: cs.overflow, textAlign: cs.textAlign,
          fontFamily: cs.fontFamily.split(",")[0].trim(), fontSize: cs.fontSize, lineHeight: cs.lineHeight,
          fontWeight: cs.fontWeight, letterSpacing: cs.letterSpacing, textTransform: cs.textTransform,
          color: cs.color, backgroundColor: cs.backgroundColor,
          borderTopWidth: cs.borderTopWidth, borderBottomWidth: cs.borderBottomWidth,
          borderLeftWidth: cs.borderLeftWidth, borderRightWidth: cs.borderRightWidth,
          borderColor: cs.borderTopColor === cs.borderBottomColor ? cs.borderTopColor : `${cs.borderTopColor} / ${cs.borderBottomColor}`,
          boxShadow: cs.boxShadow.slice(0, 120),
          paddingTop: cs.paddingTop, paddingRight: cs.paddingRight, paddingBottom: cs.paddingBottom, paddingLeft: cs.paddingLeft,
          marginTop: cs.marginTop, marginBottom: cs.marginBottom,
          gap: cs.gap, borderRadius: cs.borderRadius, opacity: cs.opacity,
        },
      });
      if (el.tagName.toLowerCase() === "svg") return;
      for (const child of Array.from(el.children)) visit(child, depth + 1);
    };
    visit(root, 0);
    return { card: { x: r2(r0.x), y: r2(r0.y), w: r2(r0.width), h: r2(r0.height) }, nodes };
  });
  const { mkdirSync: mk, writeFileSync: wf } = await import("node:fs");
  mk(dir, { recursive: true });
  wf(resolve(dir, `${caseId}.json`), JSON.stringify({ caseId, selector, viewport: page.viewportSize(), ...dump }, null, 1));
}
'''
CONFIG_EXT_PATCHES = [
    ('    deviceScaleFactor: 3,', '    deviceScaleFactor: Number(process.env.PARITY_EXT_DSF || 3),'),
    ('    command: ' + json.dumps('node ' + str(ROOT / 'tool/parity-baseline-web.mjs')) + ',',
     '    command: ' + json.dumps('node ' + str(ROOT / 'tool/parity-ext-web.mjs')) + ','),
    ('    reuseExistingServer: !process.env.CI,', '    reuseExistingServer: false,'),
]


def capture_machinery():
    """The capture-side code and flags that feed the React cache key (react_cache.py)."""
    return repr((SPEC_EXT_PATCHES, SPEC_EXT_APPENDIX, CONFIG_EXT_PATCHES, TEXT_RENDER,
                 parity.CHROMIUM_TEXT_ARGS[TEXT_RENDER]))


def react_capture(cases, refresh, dom_dump=None):
    react_dir = parity.RESULTS / 'react'
    cache = ctx = None
    keys = {}
    if dom_dump:
        need = list(cases)
    else:
        cache = react_cache.Cache(react_cache.default_cache_dir(ROOT))
        ctx = react_cache.KeyContext(ROOT, EXT, parity.RAFT_SOURCE, capture_machinery())
        keys = {c['id']: ctx.key(c) for c in cases}
        need = []
        for c in cases:
            if not refresh and cache.has(keys[c['id']]):
                cache.restore(keys[c['id']], c['id'], react_dir)
            else:  # a failed capture must never leave a stale image behind
                (react_dir / f"{c['id']}.png").unlink(missing_ok=True)
                (react_dir / f"{c['id']}.metadata.json").unlink(missing_ok=True)
                need.append(c)
        print(f'react cache {cache.dir}: {len(cases) - len(need)} hit, {len(need)} to capture'
              + (' (--refresh-react)' if refresh else ''), flush=True)
        write_react_source(len(cases) - len(need), len(need), cache.dir)
    if not need:
        return
    parity.cmd_fonts(argparse.Namespace(refresh=False))
    config = parity.prepare_react_provider()
    spec_file = parity.REACT_GEN / 'react-provider.spec.ts'
    code = spec_file.read_text()
    for old, new in SPEC_EXT_PATCHES:
        code = parity.patch_exactly_once(code, old, new, 'react-provider.spec.ts (extension)')
    spec_file.write_text(code + SPEC_EXT_APPENDIX)
    conf = config.read_text()
    for old, new in CONFIG_EXT_PATCHES:
        conf = parity.patch_exactly_once(conf, old, new, 'playwright.visual-testing.config.ts (extension)')
    config.write_text(conf)
    log = OUT / ('react-dom-dump.log' if dom_dump else 'react-capture.log')
    log.write_text('')
    densities = sorted({(c.get('viewport') or {}).get('density', 1) for c in need})
    failed = 0
    for density in densities:
        ids = [c['id'] for c in need if (c.get('viewport') or {}).get('density', 1) == density]
        env = parity.node_env()
        env.update({
            'SLOCK_VISUAL_PROVIDER': 'react',
            'SLOCK_VISUAL_CASE_IDS': ','.join(ids),
            'SLOCK_VISUAL_CASE_MANIFEST': str(MANIFEST),
            'SLOCK_VISUAL_RESULT_ROOT': str(parity.RESULTS),
            'SLOCK_ANDROID_REPO_ROOT': str(OUT),
            'PARITY_VT_ROOT': str(parity.VT),
            'PARITY_FONT_CACHE': str(parity.FONT_CACHE),
            'PARITY_CHROMIUM_ARGS': json.dumps(parity.CHROMIUM_TEXT_ARGS[TEXT_RENDER]),
            'PARITY_BASELINE_HOST_OUT': str(parity.REACT_GEN),
            'PARITY_EXT_DSF': str(density),
            'PARITY_EXT_FIXTURES': str(FIXTURES),
            'PARITY_EXT_HOST_OUT': str(OUT / 'host'),
            'PARITY_RAFT_SOURCE': str(parity.RAFT_SOURCE),
        })
        if dom_dump:
            env['PARITY_EXT_DOM_DUMP'] = str(dom_dump)
        else:
            env.pop('PARITY_EXT_DOM_DUMP', None)
        cmd = ['pnpm', 'exec', 'playwright', 'test', '--config', str(config), '--reporter=line']
        print('+', ' '.join(cmd), f'({len(ids)} case(s) at {density}x)', flush=True)
        with open(log, 'a') as sink:
            r = subprocess.run(cmd, cwd=parity.RAFT_SOURCE / 'packages/web', env=env,
                               stdout=sink, stderr=subprocess.STDOUT)
        failed += r.returncode != 0
    if dom_dump:
        count = len(list(pathlib.Path(dom_dump).glob('*.json')))
        print(f'dom dump: {count} file(s) in {dom_dump}' + (f'; some runs failed, see {log}' if failed else ''))
        return
    stored = sum(cache.store(keys[c['id']], c['id'], react_dir, ctx.inputs(c)) for c in need)
    print(f'react cache: stored {stored}/{len(need)} fresh capture(s)')
    if failed:
        print(f'react: some captures failed; see {log}')


def write_react_source(hits, captured, cache_dir):
    (OUT / 'react-source.json').write_text(json.dumps({
        'fonts': 'production', 'textRender': TEXT_RENDER, 'raftSource': str(parity.RAFT_SOURCE),
        'commit': parity.git(parity.RAFT_SOURCE, 'rev-parse', 'HEAD'),
        'dirtyFiles': parity.git(parity.RAFT_SOURCE, 'status', '--short').splitlines(),
        'cache': {'dir': str(cache_dir), 'hits': hits, 'captured': captured},
        'checkedAt': dt.datetime.now(dt.timezone.utc).isoformat(),
    }, indent=2))


def area_of(case_id):
    return case_id.split('.')[1] if case_id.count('.') >= 1 else case_id


def add_non_text(summary, by_id):
    """Second metric per case (analyze-diffs.py): similarity if the pixels classified as
    text glyph anti-aliasing (bucket `text`) matched, and the geometry verdict
    (non-text similarity >= GEOMETRY_PASS). The official verdict / 96% pass are untouched."""
    res = parity.RESULTS
    pairs = {}
    for row in summary['cases']:
        rp, fp = res / 'react' / f"{row['id']}.png", res / 'android' / f"{row['id']}.png"
        if row['react'] and row['flutter'] and rp.is_file() and fp.is_file():
            pairs[row['id']] = (rp, fp, (by_id[row['id']].get('viewport') or {}).get('density', 1))
    memo_file = OUT / 'non-text-memo.json'
    memo = json.loads(memo_file.read_text()) if memo_file.is_file() else {}
    scores = analyze.non_text_scores(pairs, memo=memo)
    memo_file.write_text(json.dumps(memo))
    threshold = analyze.GEOMETRY_PASS / 100
    for row in summary['cases']:
        sc = scores.get(row['id'])
        row['nonTextSimilarity'] = None if sc is None else round(sc['nonTextSimilarity'] / 100, 6)
        row['textShare'] = None if sc is None else round(sc['textShare'] / 100, 6)
        row['geometryPass'] = bool(sc is not None and row['nonTextSimilarity'] >= threshold)
    areas = {}
    for row in summary['cases']:
        a = areas.setdefault(area_of(row['id']), {'total': 0, 'passing': 0, 'geometryPass': 0, '_sim': [], '_nt': [], '_txt': []})
        a['total'] += 1
        a['passing'] += row['verdict'] == 'passing'
        a['geometryPass'] += row['geometryPass']
        if row['nonTextSimilarity'] is not None and row['pixelPerfectSimilarity'] is not None:
            a['_sim'].append(row['pixelPerfectSimilarity'])
            a['_nt'].append(row['nonTextSimilarity'])
            a['_txt'].append(row['textShare'])
    mean = lambda xs: round(sum(xs) / len(xs), 6) if xs else None
    for a in areas.values():
        a['meanSimilarity'], a['meanNonTextSimilarity'], a['meanTextShare'] = mean(a.pop('_sim')), mean(a.pop('_nt')), mean(a.pop('_txt'))
    summary['byArea'] = dict(sorted(areas.items()))
    n = len(summary['cases'])
    summary['totals']['geometryPass'] = sum(r['geometryPass'] for r in summary['cases'])
    summary['totals']['geometryPercentage'] = round(100 * summary['totals']['geometryPass'] / n, 2) if n else 0.0
    summary['definition']['geometryPass'] = (
        f'non-text similarity >= {threshold} (tool/parity-ext/analyze-diffs.py GEOMETRY_PASS); non-text similarity = '
        'fraction of pixels that match exactly OR are classified as text glyph anti-aliasing (bucket "text": '
        'dense ink neighbourhood no whole-pixel shift explains). Informational; the official 96% pass is unchanged.')


def ext_markdown(summary):
    pct = lambda v: '' if v is None else f'{v * 100:.2f}%'
    t = summary['totals']
    official = parity.summary_markdown(summary).replace('; elegant-dark: 0 official cases.', '.')
    head = official.split('| case | verdict')[0].rstrip('\n')
    lines = [head, '',
             f"Geometry pass (non-text similarity >= {analyze.GEOMETRY_PASS}%): **{t['geometryPass']}/{t['total']} = "
             f"{t['geometryPercentage']}%** (official 96% pass: {t['passing']}/{t['total']} = {t['percentage']}%)",
             '',
             '| area | cases | exact pass (96%) | geometry pass | mean exact | mean non-text | mean text share |',
             '| --- | --- | --- | --- | --- | --- | --- |']
    for name, a in summary['byArea'].items():
        lines.append(f"| {name} | {a['total']} | {a['passing']}/{a['total']} | {a['geometryPass']}/{a['total']} | "
                     f"{pct(a['meanSimilarity'])} | {pct(a['meanNonTextSimilarity'])} | {pct(a['meanTextShare'])} |")
    lines += ['', '| case | verdict | geometry | exact | non-text | text share | flutter mapping |',
              '| --- | --- | --- | --- | --- | --- | --- |']
    for c in sorted(summary['cases'], key=lambda c: (c['verdict'], c['nonTextSimilarity'] or 0, c['id'])):
        m = c['flutterMapping']
        detail = ', '.join(m.get('widgets', [])) if m['status'] == 'mapped' else f"{m['status']}: {m.get('reason', '')}"
        lines.append(f"| `{c['id']}` | {c['verdict']} | {'pass' if c['geometryPass'] else 'fail'} | {pct(c['pixelPerfectSimilarity'])} | "
                     f"{pct(c['nonTextSimilarity'])} | {pct(c['textShare'])} | {detail.replace('|', '/')} |")
    return '\n'.join(lines) + '\n'


def restrict_to(summary, chosen_ids):
    """A partial run (`--cases`): report only the selected cases (the official summary
    counts every manifest case, so all the unselected ones would read as failures)."""
    rows = [r for r in summary['cases'] if r['id'] in chosen_ids]
    count = lambda v: sum(1 for x in rows if x['verdict'] == v)
    total = len(rows)
    summary['cases'] = rows
    summary['totals'].update({
        'total': total, 'reactCaptured': sum(x['react'] for x in rows), 'flutterCaptured': sum(x['flutter'] for x in rows),
        'flutterMapped': sum(x['flutterMapping']['status'] == 'mapped' for x in rows),
        'passing': count('passing'),
        'strictPass': sum(x['verdict'] == 'passing' and x['officialStatus'] in ('same', 'pass') for x in rows),
        'failing': count('failing'), 'notCovered': count('not-covered'),
        'flutterCaptureFailed': count('flutter-capture-failed'), 'reactMissing': count('react-missing'),
        'percentage': round(100 * count('passing') / total, 2) if total else 0.0,
    })
    summary['notCoveredByReason'] = {k: [i for i in v if i in chosen_ids] for k, v in summary['notCoveredByReason'].items()}
    summary['selection'] = f'{total} selected case(s) of the manifest'


def summarize(chosen_ids=None):
    summary = parity.summarize()
    if chosen_ids is not None:
        restrict_to(summary, chosen_ids)
    by_id = {c['id']: c for c in ext_cases()}
    themes = {}
    for row in summary['cases']:
        row['theme'] = by_id[row['id']]['theme']
        t = themes.setdefault(row['theme'], {'total': 0, 'passing': 0})
        t['total'] += 1
        t['passing'] += row['verdict'] == 'passing'
    summary.update({
        'suite': 'raft-flutter extension (NOT the official case set)',
        'manifest': str(MANIFEST.relative_to(ROOT) if MANIFEST.is_relative_to(ROOT) else MANIFEST),
        'byTheme': themes, 'themesWithoutOfficialCases': [],
    })
    summary['definition']['unit'] = 'extension case (one theme each; theme is the id suffix)'
    summary['definition']['total'] = ('every case the tool/parity-ext/build-*.py builders generate; '
                                       + sampling.sampled_themes_note())
    add_non_text(summary, by_id)
    (OUT / 'summary.json').write_text(json.dumps(summary, indent=2))
    (OUT / 'summary.md').write_text(ext_markdown(summary))
    return summary


def cmd_run(a):
    OUT.mkdir(parents=True, exist_ok=True)
    chosen = parity.select(ext_cases(), a.cases)
    if not chosen:
        sys.exit(f'no extension cases match {a.cases!r}')
    react_capture(chosen, a.refresh_react)
    if not a.skip_flutter:
        os.environ['PARITY_MANIFEST'] = str(MANIFEST)
        os.environ['PARITY_EXT_FIXTURES'] = str(FIXTURES)
        parity.flutter_capture(chosen, a.cases, a.shards)
    log = OUT / 'cli.log'
    log.write_text('')
    cli('diff', '--pairs', parity.PAIR, log=log)
    stamp = dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    shutil.rmtree(parity.SITE, ignore_errors=True)
    cli('site', '--pairs', parity.PAIR, '--skip-analysis', '--site-dir', str(parity.SITE),
        '--run-id', f'{stamp}-flutter-ext-{parity.git(ROOT, "rev-parse", "--short", "HEAD") or "local"}',
        '--commit-subject', 'raft-flutter parity EXTENSION suite (not the official case set)', log=log)
    (OUT / 'site-stamp.txt').write_text(stamp)
    summary = summarize({c['id'] for c in chosen} if a.cases else None)
    shutil.copy(OUT / 'summary.json', parity.SITE / 'flutter-parity-summary.json')
    shutil.copy(OUT / 'summary.md', parity.SITE / 'flutter-parity-summary.md')
    t = summary['totals']
    print(f"extension {parity.PAIR}: {t['passing']}/{t['total']} passing = {t['percentage']}% (official 96%); "
          f"geometry pass {t['geometryPass']}/{t['total']} = {t['geometryPercentage']}%")


def cmd_dom_dump(a):
    OUT.mkdir(parents=True, exist_ok=True)
    chosen = parity.select(ext_cases(), a.cases)
    if not chosen:
        sys.exit(f'no extension cases match {a.cases!r}')
    react_capture(chosen, False, dom_dump=pathlib.Path(a.out).resolve())


def cmd_publish(a):
    if not (parity.SITE / 'index.html').is_file():
        sys.exit('no site; run `tool/parity-ext/run run` first')
    stamp = (OUT / 'site-stamp.txt').read_text().strip()
    PUBLISH_DIR.mkdir(parents=True, exist_ok=True)
    dest = PUBLISH_DIR / stamp
    if dest.exists():
        sys.exit(f'{dest} exists; runs are immutable')
    shutil.copytree(parity.SITE, dest)
    latest = PUBLISH_DIR / 'latest'
    if latest.is_symlink():
        latest.unlink()
    elif latest.exists():
        sys.exit(f'{latest} is not a symlink; refusing to replace it')
    latest.symlink_to(stamp)
    runs = sorted((p.name for p in PUBLISH_DIR.iterdir() if p.is_dir() and not p.is_symlink()), reverse=True)
    totals = json.loads((OUT / 'summary.json').read_text())['totals']
    items = '\n'.join(f'<li><a href="{r}/">{r}</a></li>' for r in runs)
    (PUBLISH_DIR / 'index.html').write_text(
        '<!doctype html><meta charset="utf-8"><title>raft-flutter parity extension suite</title>'
        '<meta http-equiv="refresh" content="0; url=latest/">'
        '<p>raft-flutter EXTENSION suite (not the official case set; official report: '
        '<a href="../raft_flutter_parity/latest/">raft_flutter_parity</a>).</p>'
        f'<p>Latest: <a href="latest/">latest/</a> ({totals["passing"]}/{totals["total"]} = '
        f'{totals["percentage"]}% passing)</p><ul>{items}</ul>')
    print(f'published {dest} (latest -> {stamp})')
    if a.no_verify:
        return
    base = f'{parity.BASE_URL}/raft_flutter_parity_ext'
    for rel in [f'{stamp}/', 'latest/', 'latest/flutter-parity-summary.json', 'latest/latest/home-cases.json']:
        parity.verify(f'{base}/{rel}')
    home = json.loads(urllib.request.urlopen(f'{base}/latest/latest/home-cases.json').read())
    images = [img for case in home.get('cases', [])
              for img in [*(p.get('image') for p in (case.get('providers') or {}).values()),
                          *(p.get('sideBySideImage') for p in (case.get('pairs') or {}).values())] if img]
    bad = 0
    for img in images:
        try:
            urllib.request.urlopen(f'{base}/latest/{img.lstrip("./")}').read(16)
        except Exception as exc:  # noqa: BLE001
            bad += 1
            print(f'  image FAIL {img}: {exc}')
    print(f'images: {len(images) - bad}/{len(images)} resolve; URL: {base}/latest/')
    if bad:
        sys.exit(1)


def main():
    p = argparse.ArgumentParser(prog='tool/parity-ext/run', description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest='cmd', required=True)
    r = sub.add_parser('run')
    r.add_argument('--cases', help='comma list of extension case ids or globs (default: all)')
    r.add_argument('--refresh-react', action='store_true')
    r.add_argument('--shards', type=int, default=int(os.environ.get('PARITY_SHARDS', '4')))
    r.add_argument('--skip-flutter', action='store_true')
    r.set_defaults(fn=cmd_run)
    d = sub.add_parser('dom-dump', help='diagnostic: dump the Web DOM geometry/style of the capture target per case')
    d.add_argument('--cases', default='components.search-overlay.*', help='ids or globs (default: search overlay)')
    d.add_argument('--out', default=str(OUT / 'react-dom'))
    d.set_defaults(fn=cmd_dom_dump)
    s = sub.add_parser('summary')
    s.add_argument('--cases', help='report only these ids / globs (default: every manifest case)')
    s.set_defaults(fn=lambda a: summarize({c['id'] for c in parity.select(ext_cases(), a.cases)} if a.cases else None))
    pub = sub.add_parser('publish')
    pub.add_argument('--no-verify', action='store_true')
    pub.set_defaults(fn=cmd_publish)
    a = p.parse_args()
    write_sampled_manifest()
    a.fn(a)


if __name__ == '__main__':
    main()
