SPEC_EXT_APPENDIX = r'''

// raft-flutter parity extension: endpoints the mounted components call after
// the first render, answered from tool/parity-ext/fixtures/*.json `routes`
// ("METHOD /path" -> JSON body), the same data the Flutter fixture client serves.
async function parityExtRoutes(page: Page, visualCase: VisualCase) {
  const dir = process.env.PARITY_EXT_FIXTURES!;
  const { readdirSync, appendFileSync, mkdirSync } = await import("node:fs");
  // Debug aid: PARITY_EXT_LOG_REQUESTS=<dir> lists every /api request a case
  // makes (to align the fixture routes both providers answer).
  const logDir = process.env.PARITY_EXT_LOG_REQUESTS;
  if (logDir) {
    mkdirSync(logDir, { recursive: true });
    page.on("request", (request: any) => {
      const url = new URL(request.url());
      if (url.pathname.startsWith("/api/")) {
        appendFileSync(resolve(logDir, `${visualCase.id}.txt`), `${request.method()} ${url.pathname}${url.search}\n`);
      }
    });
  }
  const props = (visualCase.variants?.[0]?.props || {}) as Record<string, string>;
  for (const file of readdirSync(dir).filter((f: string) => f.endsWith(".json"))) {
    // A case may pin its fixture (`props.extFixture`): routes of the other families
    // (e.g. settings' GET /agents) must not shadow its own.
    if (props.extFixture && file !== `${props.extFixture}.json`) continue;
    const fixture = JSON.parse(readFileSync(resolve(dir, file), "utf8"));
    // The machine list the case's page loaded (the Sidebar re-reads it on
    // mount): fixture `lists[props.list]`, the detail variant replacing its
    // row; `loading` keeps the read in flight like the Flutter side.
    if (fixture.lists && props.list) {
      const detail = props.machine ? fixture.machines[props.machine] : null;
      const machines = fixture.lists[props.list].map((id: string) =>
        detail && detail.id === id ? detail : fixture.machines[id]);
      await page.route((url: URL) => /^\/api\/servers\/[^/]+\/machines$/.test(url.pathname), (route: any) => {
        if (route.request().method() !== "GET") return route.fallback();
        if (String(props.loading) === "true") return;
        return route.fulfill({ status: 200, contentType: "application/json", body: JSON.stringify({
          machines, latestComputerVersion: fixture.latestComputerVersion, latestComputerReleaseNotes: null }) });
      });
    }
    // props.routeSet selects per-case overrides from `routeSets`:
    // {"$pending": true} never answers (loading), {"$status": N} answers N.
    const routes = { ...(fixture.routes || {}), ...((fixture.routeSets || {})[props.routeSet] || {}) };
    // Search overlay: GET /messages/search answered from fixture.search by the
    // request's q (+ senderId); case prop searchMode "pending" never answers
    // (skeleton), "error" answers HTTP 500.
    if (fixture.search && props.extKind === "search-overlay") {
      await page.route((url: URL) => url.pathname === "/api/messages/search", (route: any) => {
        if (route.request().method() !== "GET") return route.fallback();
        if (props.searchMode === "pending") return;
        if (props.searchMode === "error") {
          return route.fulfill({ status: 500, contentType: "application/json", body: JSON.stringify({ error: "Internal Server Error" }) });
        }
        const params = new URL(route.request().url()).searchParams;
        const q = (params.get("q") || "").trim().toLowerCase();
        const senderId = params.get("senderId") || "";
        const rule = fixture.search.responses.find((r: any) => r.q === q && (r.senderId || "") === senderId);
        return route.fulfill({ status: 200, contentType: "application/json", body: JSON.stringify(rule ? rule.body : fixture.search.fallback) });
      });
    }
    for (const [key, body] of Object.entries(routes)) {
      const [method, path] = key.split(" ");
      await page.route((url: URL) => url.pathname === `/api${path}`, (route: any) => {
        if (route.request().method() !== method) return route.fallback();
        // `{"$when": [{"query": {"dirPath": "notes"}, "answer": A}], "$default": B}` answers one path differently
        // by query string (the Flutter fixture client applies the same rule).
        let answer: any = body;
        const when = (body as any)?.$when;
        if (Array.isArray(when)) {
          const params = new URL(route.request().url()).searchParams;
          const hit = when.find((w: any) => Object.entries(w.query || {}).every(([k, v]) => params.get(k) === v));
          answer = hit ? hit.answer : (body as any).$default;
        }
        const special = (answer || {}) as { $pending?: boolean; $status?: number; $body?: unknown; $file?: string; $contentType?: string };
        if (special.$pending) return;
        // `{"$file": "name.png", "$contentType": "image/png"}` answers the bytes of a fixture file.
        if (special.$file) {
          return route.fulfill({ status: 200, contentType: special.$contentType || "application/octet-stream",
            body: readFileSync(resolve(dir, special.$file)) });
        }
        if (special.$status) {
          return route.fulfill({ status: special.$status, contentType: "application/json",
            body: JSON.stringify(special.$body ?? { error: "fixture error" }) });
        }
        return route.fulfill({ status: 200, contentType: "application/json", body: JSON.stringify(answer) });
      });
    }
  }
}

// Diagnostic (PARITY_EXT_DOM_DUMP): depth-first dump of every element under the
// capture target with its rect relative to the target's top-left and the
// computed style that drives layout/paint. SVG internals are not descended.
async function parityExtDomDump(page: Page, selector: string, caseId: string, dir: string) {
  const dump = await page.locator(selector).first().evaluate((root: Element) => {
    const r0 = root.getBoundingClientRect();
    const r2 = (n: number) => Math.round(n * 100) / 100;
    const nodes: any[] = [];
    const visit = (el: Element, depth: number) => {
      const r = el.getBoundingClientRect();
      const cs = getComputedStyle(el);
      const own = Array.from(el.childNodes).filter((n) => n.nodeType === 3)
        .map((n) => (n.textContent || "").replace(/\s+/g, " ").trim()).filter(Boolean).join(" ");
      nodes.push({
        depth,
        tag: el.tagName.toLowerCase(),
        testid: el.getAttribute("data-testid") || undefined,
        slot: el.getAttribute("data-slot") || undefined,
        cls: (typeof (el as any).className === "string" ? (el as any).className : el.getAttribute("class") || "").slice(0, 200),
        text: own ? own.slice(0, 60) : undefined,
        rect: { x: r2(r.x - r0.x), y: r2(r.y - r0.y), w: r2(r.width), h: r2(r.height) },
        style: {
          display: cs.display, position: cs.position, flexDirection: cs.flexDirection,
          alignItems: cs.alignItems, justifyContent: cs.justifyContent, whiteSpace: cs.whiteSpace,
          textOverflow: cs.textOverflow, overflow: cs.overflow, textAlign: cs.textAlign,
          fontFamily: cs.fontFamily.split(",")[0].trim(), fontSize: cs.fontSize, lineHeight: cs.lineHeight,
          fontWeight: cs.fontWeight, letterSpacing: cs.letterSpacing, textTransform: cs.textTransform,
          color: cs.color, backgroundColor: cs.backgroundColor,
          borderTopWidth: cs.borderTopWidth, borderBottomWidth: cs.borderBottomWidth,
          borderLeftWidth: cs.borderLeftWidth, borderRightWidth: cs.borderRightWidth,
          borderColor: cs.borderTopColor === cs.borderBottomColor ? cs.borderTopColor : `${cs.borderTopColor} / ${cs.borderBottomColor}`,
          boxShadow: cs.boxShadow.slice(0, 120),
          paddingTop: cs.paddingTop, paddingRight: cs.paddingRight, paddingBottom: cs.paddingBottom, paddingLeft: cs.paddingLeft,
          marginTop: cs.marginTop, marginBottom: cs.marginBottom,
          gap: cs.gap, borderRadius: cs.borderRadius, opacity: cs.opacity,
        },
      });
      if (el.tagName.toLowerCase() === "svg") return;
      for (const child of Array.from(el.children)) visit(child, depth + 1);
    };
    visit(root, 0);
    return { card: { x: r2(r0.x), y: r2(r0.y), w: r2(r0.width), h: r2(r0.height) }, nodes };
  });
  const { mkdirSync: mk, writeFileSync: wf } = await import("node:fs");
  mk(dir, { recursive: true });
  wf(resolve(dir, `${caseId}.json`), JSON.stringify({ caseId, selector, viewport: page.viewportSize(), ...dump }, null, 1));
}
'''
# Only new pending-address cases install this machinery. Existing cases keep
# their cache input; the new case carries an explicit machineryRev.
PENDING_ADDRESS_SETUP = r'''
  if (props.pendingSpinner === "1") {
    const fixture = JSON.parse(readFileSync(resolve(dir, 'threadattachments.json'), 'utf8'));
    const queryPath = '/api' + fixture.pendingSpinner.queryPath;
    const state: PendingAddressState = {
      id: visualCase.id, held: new Set<any>(), seen: 0, imageRequests: 0,
      accepting: true, lateAborted: 0, abortErrors: 0, unexpectedMethods: 0,
      closingWork: new Set<Promise<void>>(),
      predicate: (url: URL) => url.pathname === queryPath,
      handler: async (route: any) => {
        state.seen++;
        if (route.request().method() !== 'GET') state.unexpectedMethods++;
        if (!state.accepting) {
          const work = route.abort('aborted').then(
            () => { state.lateAborted++; }, () => { state.abortErrors++; });
          state.closingWork.add(work);
          await work;
          state.closingWork.delete(work);
          return;
        }
        state.held.add(route);
        // Real request stays pending until visible-close/page-owned cleanup.
      },
    };
    parityExtPendingAddresses.set(page, state);
    page.on('request', (request: any) => {
      if (request.resourceType() === 'image' && /^https?:/.test(request.url())) state.imageRequests++;
    });
    await page.emulateMedia({ reducedMotion: 'reduce' });
    await page.route(state.predicate, state.handler);
  }
'''
SPEC_PENDING_ADDRESS_APPENDIX = r'''
type PendingAddressState = {
  id: string; held: Set<any>; seen: number; imageRequests: number;
  accepting: boolean; lateAborted: number; abortErrors: number; unexpectedMethods: number;
  closingWork: Set<Promise<void>>;
  predicate: (url: URL) => boolean; handler: (route: any) => Promise<void>;
};
const parityExtPendingAddresses = new WeakMap<Page, PendingAddressState>();

async function parityExtAssertPendingAddress(page: Page, visualCase: VisualCase) {
  if (String(visualCase.variants?.[0]?.props?.pendingSpinner) !== "1") return;
  const state = parityExtPendingAddresses.get(page)!;
  await expect.poll(() => state.seen).toBeGreaterThan(0);
  expect(state.held.size).toBeGreaterThan(0);
  expect(state.imageRequests).toBe(0);
  expect(state.unexpectedMethods).toBe(0);
  const spinner = page.locator('[data-testid="image-lightbox"] [data-slot="spinner"]');
  await expect(spinner).toHaveCount(1);
  await expect(spinner.locator('[data-spinner-pixel]')).toHaveCount(4);
  const box = await spinner.boundingBox();
  expect(box?.width).toBe(19);
  expect(box?.height).toBe(19);
  const reducedMotion = await page.evaluate(() => matchMedia('(prefers-reduced-motion: reduce)').matches);
  expect(reducedMotion).toBe(true);
  const dir = resolve(resultRoot, 'react');
  mkdirSync(dir, { recursive: true });
  writeFileSync(resolve(dir, `${state.id}.pending-state.json`), JSON.stringify({
    caseId: state.id, stage: 'waiting-for-download-address-no-preview',
    actualSpinnerCount: await spinner.count(), actualPixelCount: await spinner.locator('[data-spinner-pixel]').count(),
    gridWidth: box!.width, gridHeight: box!.height, reducedMotion,
    addressQueries: state.seen, pending: state.held.size, imageRequests: state.imageRequests,
  }, null, 2));
}

// Keep the exact query interceptor installed for the entire page lifetime.
// Close the real UI first, so source ImageLightbox's cleanup cancels its observer.
// New requests cannot enter the held set and are aborted even during teardown.
test.afterEach(async ({ page }: { page: Page }) => {
  const state = parityExtPendingAddresses.get(page);
  if (!state) return;
  state.accepting = false;
  let aborted = 0, visibleCloseUsed = false, closeErrors = 0;
  try {
    if (!page.isClosed()) {
      const lightbox = page.locator('[data-testid="image-lightbox"]');
      if (await lightbox.isVisible()) {
        // This is the source's visible X/Close action, not a store mutation.
        const close = lightbox.locator('button').filter({ has: page.locator('svg.lucide-x') });
        await expect(close).toHaveCount(1);
        await close.click();
        await expect(lightbox).toHaveCount(0);
        visibleCloseUsed = true;
      }
    }
  } catch { closeErrors++; }
  finally {
    for (const route of state.held) {
      try { await route.abort('aborted'); aborted++; }
      catch { state.abortErrors++; }
    }
    state.held.clear();
    // No unroute while a live page could retry. Page close retires its routes.
    try { if (!page.isClosed()) await page.close(); }
    catch { closeErrors++; }
    await Promise.all(Array.from(state.closingWork));
    parityExtPendingAddresses.delete(page);
    const dir = resolve(resultRoot, 'react');
    mkdirSync(dir, { recursive: true });
    writeFileSync(resolve(dir, `${state.id}.pending-cleanup.json`), JSON.stringify({
      caseId: state.id, stage: 'waiting-for-download-address-no-preview',
      acceptingNewQueries: state.accepting, queries: state.seen, aborted,
      lateAborted: state.lateAborted, abortErrors: state.abortErrors,
      unexpectedMethods: state.unexpectedMethods, pending: state.held.size,
      imageRequests: state.imageRequests, visibleCloseUsed, closeErrors,
      pageClosed: page.isClosed(), interceptorRemovedOnlyWithPage: true,
    }, null, 2));
  }
  expect(state.abortErrors).toBe(0);
  expect(closeErrors).toBe(0);
  expect(visibleCloseUsed).toBe(true);
  expect(state.unexpectedMethods).toBe(0);
  expect(aborted + state.lateAborted).toBe(state.seen);
  expect(state.imageRequests).toBe(0);
  expect(page.isClosed()).toBe(true);
});
'''

CONFIG_EXT_PATCHES = [
    ('    deviceScaleFactor: 3,', '    deviceScaleFactor: Number(process.env.PARITY_EXT_DSF || 3),'),
    ('    command: ' + json.dumps('node ' + str(ROOT / 'tool/parity-baseline-web.mjs')) + ',',
     '    command: ' + json.dumps('node ' + str(ROOT / 'tool/parity-ext-web.mjs')) + ','),
    ('    reuseExistingServer: !process.env.CI,', '    reuseExistingServer: false,'),
]


def capture_machinery():
    """The capture-side code and flags that feed the React cache key (react_cache.py)."""
    return repr((SPEC_EXT_PATCHES, SPEC_STATES_PATCHES, SPEC_EXT_APPENDIX, CONFIG_EXT_PATCHES, TEXT_RENDER,
                 parity.CHROMIUM_TEXT_ARGS[TEXT_RENDER]))


def _now():
    return dt.datetime.now(dt.timezone.utc).isoformat()


def _error(row, stage, error):
    value = {'stage': stage, 'type': type(error).__name__, 'message': str(error)}
    for field in ('copySteps', 'cleanupSteps'):
        if hasattr(error, field):
            value[field] = getattr(error, field)
    row['error'] = value
    row['events'].append(value)


def _clear_results(row, react_dir, reason):
    """Retire only this invocation's owned result copies; preserve their bytes."""
    steps, errors = {}, []
    for extension in ('png', 'metadata.json'):
        path = react_dir / f"{row['caseId']}.{extension}"
        steps[extension] = {'presentBefore': path.is_file(), 'removed': False}
        try:
            if path.is_file():
                digest = react_cache.sha(path.read_bytes())
                archived = OUT / 'react-discarded-results' / f"{row['caseId']}.{digest}.{extension}"
                archived.parent.mkdir(parents=True, exist_ok=True)
                if not archived.exists():
                    react_cache._atomic_copy(path, archived)
                if react_cache.sha(archived.read_bytes()) != digest:
                    raise ValueError('discarded result evidence differs from its digest')
                steps[extension]['preservedAt'] = str(archived)
            path.unlink(missing_ok=True)
            steps[extension]['removed'] = not path.exists()
        except (OSError, ValueError) as error:
            steps[extension]['error'] = str(error)
            errors.append(error)
    row['events'].append({'stage': 'result-cleanup', 'reason': reason, 'steps': steps})
    if errors:
        error = OSError('could not retire unverified result copies')
        error.cleanupSteps = steps
        raise error


def _generated_identity(spec_file, config):
    return {'specSha256': react_cache.sha(spec_file.read_bytes()),
            'configSha256': react_cache.sha(config.read_bytes())}


def _applied_patch_identity(extra_spec_patches=(), extra_appendix=''):
    def pairs(patches):
        return [{'anchorSha256': react_cache.sha(old), 'replacementSha256': react_cache.sha(new)}
                for old, new in patches]
    return {'baseProviderSha256': react_cache.sha((ROOT / 'tool/parity').read_bytes()),
            'spec': pairs(SPEC_EXT_PATCHES + SPEC_STATES_PATCHES + list(extra_spec_patches)),
            'config': pairs(CONFIG_EXT_PATCHES),
            'appendixSha256': react_cache.sha(SPEC_EXT_APPENDIX + extra_appendix)}


def react_capture(cases, refresh, dom_dump=None):
    react_dir = parity.RESULTS / 'react'
    cache = ctx = None
    keys, inputs, need = {}, {}, []
    rows = {c['id']: {'caseId': c['id'], 'mode': 'attempted', 'outcome': 'pending',
                     'attemptedThisRun': False, 'playwrightAttempted': False, 'actionsExecutedThisRun': None,
                     'producedArtifacts': False, 'executionProof': None,
                     'observedState': {'status': 'not-recorded'}, 'events': [], 'error': None}
            for c in cases}
    stage = 'cache-prepare'
    failed = False
    fatal = False
    try:
        OUT.mkdir(parents=True, exist_ok=True)
        if dom_dump:
            need = list(cases)
        else:
            cache = react_cache.Cache(react_cache.default_cache_dir(ROOT))
            ctx = react_cache.KeyContext(ROOT, EXT, parity.RAFT_SOURCE, capture_machinery())
            for c in cases:
                cid, row = c['id'], rows[c['id']]
                inputs[cid], keys[cid] = ctx.inputs(c), ctx.key(c)
                row['cacheKey'] = keys[cid]
                if not refresh and cache.has(keys[cid], inputs[cid]):
                    try:
                        proof = cache.restore(keys[cid], cid, react_dir, inputs[cid])
                        row.update(mode='cache-hit', outcome='restored', executionProof=proof,
                                   actionsExecutedThisRun=False, restoredAt=_now())
                        continue
                    except Exception as error:
                        fatal = True
                        _error(row, 'restore', error)
                        row['outcome'] = 'restore-failed'
                # Never let a failed fresh attempt inherit a prior result pair.
                _clear_results(row, react_dir, 'before-preparation')
                need.append(c)
        if not need:
            return False
        stage = 'prepare'
        parity.cmd_fonts(argparse.Namespace(refresh=False))
        # A first font preparation can change the bytes used by the key. Bind
        # fresh attempts after that preparation; restored entries keep origins.
        if not dom_dump:
            ctx = react_cache.KeyContext(ROOT, EXT, parity.RAFT_SOURCE, capture_machinery())
            for c in need:
                cid = c['id']
                inputs[cid], keys[cid] = ctx.inputs(c), ctx.key(c)
                rows[cid]['cacheKey'] = keys[cid]
        config = pathlib.Path(parity.prepare_react_provider())
        spec_file = parity.REACT_GEN / 'react-provider.spec.ts'
        code = spec_file.read_text()
        for old, new in SPEC_EXT_PATCHES + SPEC_STATES_PATCHES:
            code = parity.patch_exactly_once(code, old, new, 'react-provider.spec.ts (extension)')
        changes = []
        prepared = code + SPEC_EXT_APPENDIX
        if any(str(c.get('variants', [{}])[0].get('props', {}).get('pendingSpinner')) == '1'
               for c in cases):
            changes = [
                ('    await applyInteractions(page, visualCase);',
                 '    await applyInteractions(page, visualCase);\n'
                 '    await parityExtAssertPendingAddress(page, visualCase);'),
                ('  const props = (visualCase.variants?.[0]?.props || {}) as Record<string, string>;\n',
                 '  const props = (visualCase.variants?.[0]?.props || {}) as Record<string, string>;\n'
                 + PENDING_ADDRESS_SETUP),
            ]
            for old, new in changes:
                if prepared.count(old) != 1:
                    raise RuntimeError('Pending-address capture anchor changed')
                prepared = prepared.replace(old, new)
            prepared += SPEC_PENDING_ADDRESS_APPENDIX
        spec_file.write_text(prepared)
        conf = config.read_text()
        for old, new in CONFIG_EXT_PATCHES:
            conf = parity.patch_exactly_once(conf, old, new, 'playwright.visual-testing.config.ts (extension)')
        config.write_text(conf)
        generated, applied = _generated_identity(spec_file, config), _applied_patch_identity(
            changes, SPEC_PENDING_ADDRESS_APPENDIX if changes else '')
        # Preserve the exact temp executor bytes that will be handed to the
        # process, not merely their source patches. These snapshots are never
        # rewritten on a hit or used as evidence of rendered state.
        snapshots = OUT / 'react-execution-inputs'
        snapshots.mkdir(parents=True, exist_ok=True)
        generated_references = {}
        for name, path in (('spec', spec_file), ('config', config)):
            digest = generated[f'{name}Sha256']
            target = snapshots / f'{name}-{digest}.ts'
            if target.exists():
                if react_cache.sha(target.read_bytes()) != digest:
                    raise ValueError('execution input snapshot differs from its digest')
            else:
                with target.open('xb') as sink:
                    sink.write(path.read_bytes())
            generated_references[f'{name}Snapshot'] = str(target.resolve())
            generated_references[f'{name}ExecutedPath'] = str(path.resolve())
        log = OUT / ('react-dom-dump.log' if dom_dump else 'react-capture.log')
        log.write_text('')
        densities = sorted({(c.get('viewport') or {}).get('density', 1) for c in need})
        for density in densities:
            group = [c for c in need if (c.get('viewport') or {}).get('density', 1) == density]
            ids = [c['id'] for c in group]
            stage = 'runner'
            started, returncode, runner_error = _now(), None, None
            try:
                if _generated_identity(spec_file, config) != generated:
                    raise ValueError('temporary executor changed before execution')
                if not dom_dump:
                    current = react_cache.KeyContext(ROOT, EXT, parity.RAFT_SOURCE, capture_machinery())
                    if any(current.inputs(c) != inputs[c['id']] for c in group):
                        raise ValueError('source bindings changed before execution')
                    for cid in ids:
                        _clear_results(rows[cid], react_dir, 'immediately-before-runner')
                env = parity.node_env()
                env.update({
                    'SLOCK_VISUAL_PROVIDER': 'react', 'SLOCK_VISUAL_CASE_IDS': ','.join(ids),
                    'SLOCK_VISUAL_CASE_MANIFEST': str(MANIFEST),
                    'SLOCK_VISUAL_RESULT_ROOT': str(parity.RESULTS), 'SLOCK_ANDROID_REPO_ROOT': str(OUT),
                    'PARITY_VT_ROOT': str(parity.VT), 'PARITY_FONT_CACHE': str(parity.FONT_CACHE),
                    'PARITY_CHROMIUM_ARGS': json.dumps(parity.CHROMIUM_TEXT_ARGS[TEXT_RENDER]),
                    'PARITY_BASELINE_HOST_OUT': str(parity.REACT_GEN), 'PARITY_EXT_DSF': str(density),
                    'PARITY_EXT_FIXTURES': str(FIXTURES), 'PARITY_EXT_HOST_OUT': str(OUT / 'host'),
                    'PARITY_RAFT_SOURCE': str(parity.RAFT_SOURCE),
                })
                if dom_dump:
                    env['PARITY_EXT_DOM_DUMP'] = str(dom_dump)
                else:
                    env.pop('PARITY_EXT_DOM_DUMP', None)
                cmd = ['pnpm', 'exec', 'playwright', 'test', '--config', str(config), '--reporter=line']
                for cid in ids:
                    rows[cid]['playwrightAttempted'] = True
                    rows[cid]['attemptedThisRun'] = True
                with open(log, 'a') as sink:
                    result = subprocess.run(cmd, cwd=parity.RAFT_SOURCE / 'packages/web', env=env,
                                            stdout=sink, stderr=subprocess.STDOUT)
                returncode = result.returncode
            except (Exception, SystemExit) as error:
                runner_error = error
                failed = True
                fatal = True
            completed = _now()
            stable = False
            try:
                stable = _generated_identity(spec_file, config) == generated
                if not dom_dump:
                    current = react_cache.KeyContext(ROOT, EXT, parity.RAFT_SOURCE, capture_machinery())
                    stable = stable and all(current.inputs(c) == inputs[c['id']] for c in group)
            except Exception as error:
                runner_error = runner_error or error
            if not stable:
                failed = True
                fatal = True
            failed = failed or returncode not in (None, 0)
            for c in group:
                cid, row = c['id'], rows[c['id']]
                row['playwrightGroupExit'] = returncode
                if runner_error:
                    _error(row, 'runner', runner_error)
                if dom_dump:
                    row['outcome'] = 'diagnostic'
                    continue
                png, meta = react_dir / f'{cid}.png', react_dir / f'{cid}.metadata.json'
                row['outputPresence'] = {'png': png.is_file(), 'metadata': meta.is_file()}
                row['producedArtifacts'] = png.is_file() and meta.is_file()
                if not stable:
                    row['outcome'] = 'executor-drift'
                    _error(row, 'executor-stability', ValueError('executor/source bytes not stable around execution'))
                    continue
                if runner_error or returncode is None:
                    row['outcome'] = 'runner-failed'
                    continue
                if not row['producedArtifacts']:
                    row['outcome'] = 'runner-failed' if returncode != 0 else 'missing-artifacts'
                    failed = True
                    continue
                try:
                    metadata = json.loads(meta.read_text())
                    proof = {'version': react_cache.VERSION, 'caseId': cid, 'cacheKey': keys[cid],
                             'capturedAt': metadata.get('capturedAt'),
                             'sourceBindings': inputs[cid]['sourceBindings'],
                             'executorInputs': inputs[cid]['executorInputs'],
                             'generated': {**generated, **generated_references},
                             'appliedPatches': applied,
                             'appliedPatchIdentity': react_cache.sha(react_cache._canon(applied)),
                             'execution': {'startedAt': started, 'completedAt': completed,
                                           'returncode': returncode, 'temporaryBytesStable': True},
                             'artifacts': react_cache.artifact_identity(png, meta),
                             'observedState': {'status': 'not-recorded'}}
                    if not react_cache._valid_proof(proof, keys[cid], cid, inputs[cid], png, meta):
                        raise ValueError('fresh artifact pair has no valid original execution proof')
                    row.update(mode='executed', outcome='captured', executionProof=proof, error=None)
                    if returncode != 0:
                        row.update(outcome='runner-failed', cacheStore='not-stored-group-failure')
                        _error(row, 'runner', ValueError(f'Playwright group exited {returncode}; artifacts retained'))
                        continue
                    stage = 'store'
                    if not cache.store(keys[cid], cid, react_dir, inputs[cid], execution_proof=proof):
                        raise ValueError('cache refused fresh execution proof')
                    row['cacheStore'] = cache.last_store_status
                except (Exception, SystemExit) as error:
                    failed = True
                    fatal = True
                    row['outcome'] = 'store-failed'
                    _error(row, 'store', error)
        if failed and not dom_dump:
            # Preserve --allow-structural-gaps: ordinary missing surfaces and
            # assertion failures are adjudicated by cmd_run's missing/lost/
            # no-reference rules. Infrastructure/proof errors remain fatal.
            stage = 'runner-log'
            text = log.read_text(errors='replace')
            fatal = fatal or any(marker in text for marker in (
                'browserType.launch:', "Executable doesn't exist at",
                'Target page, context or browser has been closed',
            ))
    except (Exception, SystemExit) as error:
        failed = True
        fatal = True
        for row in rows.values():
            if row['mode'] != 'cache-hit':
                if row['outcome'] in ('pending', 'restore-failed'):
                    row['outcome'] = 'prepare-failed'
                _error(row, stage, error)
    finally:
        if not dom_dump:
            values = list(rows.values())
            for row in values:
                if row['mode'] != 'cache-hit' and row['executionProof'] is None:
                    try:
                        _clear_results(row, react_dir, 'unverified-result-after-failure')
                    except (Exception, SystemExit) as error:
                        fatal = True
                        _error(row, 'result-cleanup', error)
            write_react_source(sum(row['mode'] == 'cache-hit' for row in values),
                               sum(row['executionProof'] is not None and row['mode'] == 'executed'
                                   for row in values), cache.dir if cache else None, values)
    return failed if dom_dump else fatal


def write_react_source(hits, captured, cache_dir, cases=None):
    cases = cases or []
    report = {
        'receiptVersion': react_cache.VERSION,
        'fonts': 'production', 'textRender': TEXT_RENDER, 'raftSource': str(parity.RAFT_SOURCE),
        'commit': parity.git(parity.RAFT_SOURCE, 'rev-parse', 'HEAD'),
        'dirtyFiles': parity.git(parity.RAFT_SOURCE, 'status', '--short').splitlines(),
        'cache': {'dir': str(cache_dir) if cache_dir is not None else None,
                  'hits': hits, 'attempted': sum(row['playwrightAttempted'] for row in cases),
                  'captured': captured, 'produced': sum(row['producedArtifacts'] for row in cases),
                  'successfulCaptures': sum(row['mode'] == 'executed'
                                            and row.get('playwrightGroupExit') == 0 for row in cases)},
        'cases': cases, 'checkedAt': _now(),
    }
    OUT.mkdir(parents=True, exist_ok=True)
    react_cache._atomic_write(OUT / 'react-source.json', json.dumps(report, indent=2))


def area_of(case_id):
    return case_id.split('.')[1] if case_id.count('.') >= 1 else case_id


def add_non_text(summary, by_id):
    """Second metric per case (analyze-diffs.py): similarity if the pixels classified as
    text glyph anti-aliasing (bucket `text`) matched, and the geometry verdict
    (non-text similarity >= GEOMETRY_PASS). The official verdict / 96% pass are untouched."""
    res = parity.RESULTS
    pairs = {}
    for row in summary['cases']:
        rp, fp = res / 'react' / f"{row['id']}.png", res / 'android' / f"{row['id']}.png"
        if row['react'] and row['flutter'] and rp.is_file() and fp.is_file():
            pairs[row['id']] = (rp, fp, (by_id[row['id']].get('viewport') or {}).get('density', 1))
    memo_file = OUT / 'non-text-memo.json'
    memo = json.loads(memo_file.read_text()) if memo_file.is_file() else {}
    scores = analyze.non_text_scores(pairs, memo=memo)
    memo_file.write_text(json.dumps(memo))
    threshold = analyze.GEOMETRY_PASS / 100
    for row in summary['cases']:
        sc = scores.get(row['id'])
        row['nonTextSimilarity'] = None if sc is None else round(sc['nonTextSimilarity'] / 100, 6)
        row['textShare'] = None if sc is None else round(sc['textShare'] / 100, 6)
        row['geometryPass'] = bool(sc is not None and row['nonTextSimilarity'] >= threshold)
    areas = {}
    for row in summary['cases']:
        a = areas.setdefault(area_of(row['id']), {'total': 0, 'passing': 0, 'geometryPass': 0, '_sim': [], '_nt': [], '_txt': []})
        a['total'] += 1
        a['passing'] += row['verdict'] == 'passing'
        a['geometryPass'] += row['geometryPass']
        if row['nonTextSimilarity'] is not None and row['pixelPerfectSimilarity'] is not None:
            a['_sim'].append(row['pixelPerfectSimilarity'])
            a['_nt'].append(row['nonTextSimilarity'])
            a['_txt'].append(row['textShare'])
    mean = lambda xs: round(sum(xs) / len(xs), 6) if xs else None
    for a in areas.values():
        a['meanSimilarity'], a['meanNonTextSimilarity'], a['meanTextShare'] = mean(a.pop('_sim')), mean(a.pop('_nt')), mean(a.pop('_txt'))
    summary['byArea'] = dict(sorted(areas.items()))
    n = len(summary['cases'])
    summary['totals']['geometryPass'] = sum(r['geometryPass'] for r in summary['cases'])
    summary['totals']['geometryPercentage'] = round(100 * summary['totals']['geometryPass'] / n, 2) if n else 0.0
    summary['definition']['geometryPass'] = (
        f'non-text similarity >= {threshold} (tool/parity-ext/analyze-diffs.py GEOMETRY_PASS); non-text similarity = '
        'fraction of pixels that match exactly OR are classified as text glyph anti-aliasing (bucket "text": '
        'dense ink neighbourhood no whole-pixel shift explains). Informational; the official 96% pass is unchanged.')


def ext_markdown(summary):
    pct = lambda v: '' if v is None else f'{v * 100:.2f}%'
    t = summary['totals']
    official = parity.summary_markdown(summary).replace('; elegant-dark: 0 official cases.', '.')
    head = official.split('| case | verdict')[0].rstrip('\n')
    lines = [head, '',
             f"Geometry pass (non-text similarity >= {analyze.GEOMETRY_PASS}%): **{t['geometryPass']}/{t['total']} = "
             f"{t['geometryPercentage']}%** (official 96% pass: {t['passing']}/{t['total']} = {t['percentage']}%)",
             '',
             '| area | cases | exact pass (96%) | geometry pass | mean exact | mean non-text | mean text share |',
             '| --- | --- | --- | --- | --- | --- | --- |']
    for name, a in summary['byArea'].items():
        lines.append(f"| {name} | {a['total']} | {a['passing']}/{a['total']} | {a['geometryPass']}/{a['total']} | "
                     f"{pct(a['meanSimilarity'])} | {pct(a['meanNonTextSimilarity'])} | {pct(a['meanTextShare'])} |")
    lines += ['', '| case | verdict | geometry | exact | non-text | text share | flutter mapping |',
              '| --- | --- | --- | --- | --- | --- | --- |']
    for c in sorted(summary['cases'], key=lambda c: (c['verdict'], c['nonTextSimilarity'] or 0, c['id'])):
        m = c['flutterMapping']
        detail = ', '.join(m.get('widgets', [])) if m['status'] == 'mapped' else f"{m['status']}: {m.get('reason', '')}"
        lines.append(f"| `{c['id']}` | {c['verdict']} | {'pass' if c['geometryPass'] else 'fail'} | {pct(c['pixelPerfectSimilarity'])} | "
                     f"{pct(c['nonTextSimilarity'])} | {pct(c['textShare'])} | {detail.replace('|', '/')} |")
    return '\n'.join(lines) + '\n'


def restrict_to(summary, chosen_ids):
    """A partial run (`--cases`): report only the selected cases (the official summary
    counts every manifest case, so all the unselected ones would read as failures)."""
    rows = [r for r in summary['cases'] if r['id'] in chosen_ids]
    count = lambda v: sum(1 for x in rows if x['verdict'] == v)
    total = len(rows)
    summary['cases'] = rows
    summary['totals'].update({
        'total': total, 'reactCaptured': sum(x['react'] for x in rows), 'flutterCaptured': sum(x['flutter'] for x in rows),
        'flutterMapped': sum(x['flutterMapping']['status'] == 'mapped' for x in rows),
        'passing': count('passing'),
        'strictPass': sum(x['verdict'] == 'passing' and x['officialStatus'] in ('same', 'pass') for x in rows),
        'failing': count('failing'), 'notCovered': count('not-covered'),
        'flutterCaptureFailed': count('flutter-capture-failed'), 'reactMissing': count('react-missing'),
        'percentage': round(100 * count('passing') / total, 2) if total else 0.0,
    })
    summary['notCoveredByReason'] = {k: [i for i in v if i in chosen_ids] for k, v in summary['notCoveredByReason'].items()}
    summary['selection'] = f'{total} selected case(s) of the manifest'


def summarize(chosen_ids=None):
    summary = parity.summarize()
    if chosen_ids is not None:
        restrict_to(summary, chosen_ids)
    by_id = {c['id']: c for c in ext_cases()}
    themes = {}
    for row in summary['cases']:
        row['theme'] = by_id[row['id']]['theme']
        t = themes.setdefault(row['theme'], {'total': 0, 'passing': 0})
        t['total'] += 1
        t['passing'] += row['verdict'] == 'passing'
    summary.update({
        'suite': 'raft-flutter extension (NOT the official case set)',
        'manifest': str(MANIFEST.relative_to(ROOT) if MANIFEST.is_relative_to(ROOT) else MANIFEST),
        'byTheme': themes, 'themesWithoutOfficialCases': [],
    })
    summary['definition']['unit'] = 'extension case (one theme each; theme is the id suffix)'
    summary['definition']['total'] = ('every case the tool/parity-ext/build-*.py builders generate; '
                                       + sampling.sampled_themes_note())
    add_non_text(summary, by_id)
    (OUT / 'summary.json').write_text(json.dumps(summary, indent=2))
    (OUT / 'summary.md').write_text(ext_markdown(summary))
    return summary


def cmd_run(a):
    OUT.mkdir(parents=True, exist_ok=True)
    try:
        override = reference_contract.configure_theme(frozen=a.frozen, env=os.environ)
        if not a.frozen:
            reference = reference_contract.validate_reference(
                parity.RAFT_SOURCE, json.loads((ROOT / 'tool/parity-reference.json').read_text()))
            (OUT / 'comparison-inputs.json').write_text(json.dumps({
                'phase': 'reference-and-request', 'status': 'INPUTS_VALIDATED',
                'themeOverride': override, 'reference': reference,
            }, indent=2) + '\n')
    except (OSError, ValueError) as error:
        sys.exit(f'extension comparison precondition failed: {error}')
    chosen = parity.select(ext_cases(), a.cases)
    if not chosen:
        sys.exit(f'no extension cases match {a.cases!r}')
    chosen_ids = {case['id'] for case in chosen}
    previous = OUT / 'summary.json'
    expected = {row['id'] for row in json.loads(previous.read_text()).get('cases', [])
                if row.get('react') and row['id'] in chosen_ids} if previous.is_file() else set()
    environment_failed = False
    flutter_failed = 0
    if a.frozen:
        # Elegant / Brutal: the reference is the frozen a57b9dab render, not the Web (frozen_ref.py).
        found, missing = frozen_ref.install(parity.RESULTS, [c['id'] for c in chosen], frozen_ref.search_dirs('ext'))
        print(f'frozen references: {len(found)} found, {len(missing)} without a frozen image', flush=True)
        (OUT / 'frozen-missing.json').write_text(json.dumps(missing, indent=1))
    else:
        environment_failed = react_capture(chosen, a.refresh_react) is True
    if not a.skip_flutter:
        os.environ['PARITY_MANIFEST'] = str(MANIFEST)
        os.environ['PARITY_EXT_FIXTURES'] = str(FIXTURES)
        flutter_failed = parity.flutter_capture(chosen, a.cases, a.shards) or 0
    if not a.frozen:
        context = reference_contract.validate_flutter_metadata(
            chosen, parity.RESULTS / 'android', override)
        (OUT / 'comparison-context.json').write_text(json.dumps(context, indent=2) + '\n')
        if context['errors']:
            sys.exit('extension comparison INADMISSIBLE: ' + '; '.join(context['errors']))
    log = OUT / 'cli.log'
    log.write_text('')
    cli('diff', '--pairs', parity.PAIR, log=log)
    stamp = dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    shutil.rmtree(parity.SITE, ignore_errors=True)
    cli('site', '--pairs', parity.PAIR, '--skip-analysis', '--site-dir', str(parity.SITE),
        '--run-id', f'{stamp}-flutter-ext-{parity.git(ROOT, "rev-parse", "--short", "HEAD") or "local"}',
        '--commit-subject', 'raft-flutter parity EXTENSION suite (not the official case set)', log=log)
    (OUT / 'site-stamp.txt').write_text(stamp)
    summary = summarize({c['id'] for c in chosen} if a.cases else None)
    shutil.copy(OUT / 'summary.json', parity.SITE / 'flutter-parity-summary.json')
    shutil.copy(OUT / 'summary.md', parity.SITE / 'flutter-parity-summary.md')
    t = summary['totals']
    print(f"extension {parity.PAIR}: {t['passing']}/{t['total']} passing = {t['percentage']}% (official 96%); "
          f"geometry pass {t['geometryPass']}/{t['total']} = {t['geometryPercentage']}%")
    # Full runs retain known structural gaps. Explicit selections and references
    # that succeeded in this output directory before must remain capturable.
    missing = t.get('flutterCaptureFailed', 0)
    if not getattr(a, 'allow_structural_gaps', False):
        missing += t.get('reactMissing', 0) + t.get('notCovered', 0)
    lost = {row['id'] for row in summary.get('cases', []) if row['id'] in expected and not row.get('react')}
    no_references = t['total'] > 0 and t.get('reactCaptured', 0) == 0
    if environment_failed or flutter_failed or missing or lost or no_references:
        print(f'extension capture failed: {missing} required capture(s) missing, {len(lost)} previous reference(s) lost; '
              f'capture/provenance failure={environment_failed}, failing Flutter shards={flutter_failed}, '
              f'no references={no_references}', file=sys.stderr)
        sys.exit(1)


def cmd_dom_dump(a):
    OUT.mkdir(parents=True, exist_ok=True)
    chosen = parity.select(ext_cases(), a.cases)
    if not chosen:
        sys.exit(f'no extension cases match {a.cases!r}')
    if react_capture(chosen, False, dom_dump=pathlib.Path(a.out).resolve()) is True:
        sys.exit('React diagnostic capture/preparation failed; see its execution log')


def cmd_publish(a):
    if not (parity.SITE / 'index.html').is_file():
        sys.exit('no site; run `tool/parity-ext/run run` first')
    stamp = (OUT / 'site-stamp.txt').read_text().strip()
    PUBLISH_DIR.mkdir(parents=True, exist_ok=True)
    dest = PUBLISH_DIR / stamp
    if dest.exists():
        sys.exit(f'{dest} exists; runs are immutable')
    shutil.copytree(parity.SITE, dest)
    latest = PUBLISH_DIR / 'latest'
    if latest.is_symlink():
        latest.unlink()
    elif latest.exists():
        sys.exit(f'{latest} is not a symlink; refusing to replace it')
    latest.symlink_to(stamp)
    runs = sorted((p.name for p in PUBLISH_DIR.iterdir() if p.is_dir() and not p.is_symlink()), reverse=True)
    totals = json.loads((OUT / 'summary.json').read_text())['totals']
    items = '\n'.join(f'<li><a href="{r}/">{r}</a></li>' for r in runs)
    (PUBLISH_DIR / 'index.html').write_text(
        '<!doctype html><meta charset="utf-8"><title>raft-flutter parity extension suite</title>'
        '<meta http-equiv="refresh" content="0; url=latest/">'
        '<p>raft-flutter EXTENSION suite (not the official case set; official report: '
        '<a href="../raft_flutter_parity/latest/">raft_flutter_parity</a>).</p>'
        f'<p>Latest: <a href="latest/">latest/</a> ({totals["passing"]}/{totals["total"]} = '
        f'{totals["percentage"]}% passing)</p><ul>{items}</ul>')
    print(f'published {dest} (latest -> {stamp})')
    if a.no_verify:
        return
    base = f'{parity.BASE_URL}/raft_flutter_parity_ext'
    for rel in [f'{stamp}/', 'latest/', 'latest/flutter-parity-summary.json', 'latest/latest/home-cases.json']:
        parity.verify(f'{base}/{rel}')
    home = json.loads(urllib.request.urlopen(f'{base}/latest/latest/home-cases.json').read())
    images = [img for case in home.get('cases', [])
              for img in [*(p.get('image') for p in (case.get('providers') or {}).values()),
                          *(p.get('sideBySideImage') for p in (case.get('pairs') or {}).values())] if img]
    bad = 0
    for img in images:
        try:
            urllib.request.urlopen(f'{base}/latest/{img.lstrip("./")}').read(16)
        except Exception as exc:  # noqa: BLE001
            bad += 1
            print(f'  image FAIL {img}: {exc}')
    print(f'images: {len(images) - bad}/{len(images)} resolve; URL: {base}/latest/')
    if bad:
        sys.exit(1)


def main():
    p = argparse.ArgumentParser(prog='tool/parity-ext/run', description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest='cmd', required=True)
    r = sub.add_parser('run')
    r.add_argument('--cases', help='comma list of extension case ids or globs (default: all)')
    r.add_argument('--refresh-react', action='store_true')
    r.add_argument('--shards', type=int, default=int(os.environ.get('PARITY_SHARDS', '4')))
    r.add_argument('--skip-flutter', action='store_true')
    r.add_argument('--frozen', action='store_true',
                   help='compare against the frozen a57b9dab images (Elegant / Brutal looks) instead of the Web render')
    r.add_argument('--allow-structural-gaps', action='store_true',
                   help='full-suite mode: report known missing Web/frozen surfaces without failing; capture failures still fail')
    r.set_defaults(fn=cmd_run)
    g = sub.add_parser('regress', help='three-level (frame / page / component) x look (raft / elegant / brutal) regression')
    import regress  # noqa: E402  (tool/parity-ext/regress.py)
    regress.add_arguments(g)
    g.set_defaults(fn=regress.command)
    d = sub.add_parser('dom-dump', help='diagnostic: dump the Web DOM geometry/style of the capture target per case')
    d.add_argument('--cases', default='components.search-overlay.*', help='ids or globs (default: search overlay)')
    d.add_argument('--out', default=str(OUT / 'react-dom'))
    d.set_defaults(fn=cmd_dom_dump)
    s = sub.add_parser('summary')
    s.add_argument('--cases', help='report only these ids / globs (default: every manifest case)')
    s.set_defaults(fn=lambda a: summarize({c['id'] for c in parity.select(ext_cases(), a.cases)} if a.cases else None))
    pub = sub.add_parser('publish')
    pub.add_argument('--no-verify', action='store_true')
    pub.set_defaults(fn=cmd_publish)
    a = p.parse_args()
    write_sampled_manifest()
    a.fn(a)


if __name__ == '__main__':
    main()
