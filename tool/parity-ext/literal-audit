#!/usr/bin/env python3
"""Hard-coded geometry / colour / typography literals that bypass the theme contract (docs/parity.md "Theme isolation").

  tool/parity-ext/literal-audit [--out DIR]

A literal in a component is identical in every look: a font size, radius, colour or inset the pack cannot change. This runs
the repository's resolved-AST scanner (tool/ds-audit, rules in docs/ds-migration.md "Audit rules") over packages/raft_ui/lib
and apps/raft_flutter/lib, drops generated files and `// ds-allow` lines, and reports per category the total and the files
with the most. The categories that decide how a look renders: style.color_literal / style.material_colors (colour),
style.font_size / style.font_weight / style.text_style / style.text_metrics (typography), style.border_radius (shape),
style.dimension / style.edge_insets / style.sized_box (geometry), style.material_theme (reads ThemeData instead of the
contract). Writes <out>/literal-audit.md and .json; changes nothing.
"""
import argparse
import collections
import json
import pathlib
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parents[2]
CATEGORIES = [
    ('colour', ['style.color_literal', 'style.material_colors']),
    ('typography', ['style.font_size', 'style.font_weight', 'style.text_style', 'style.text_metrics']),
    ('shape', ['style.border_radius']),
    ('geometry', ['style.dimension', 'style.edge_insets', 'style.sized_box']),
    ('reads ThemeData instead of the contract', ['style.material_theme']),
]


def scan(path):
    r = subprocess.run([sys.executable, str(ROOT / 'tool/ds-audit'), '--json', path], cwd=ROOT, capture_output=True, text=True)
    if r.returncode:
        sys.exit(r.stderr or r.stdout)
    return json.loads(r.stdout)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--out', default=str(ROOT / 'build/literal-audit'))
    a = ap.parse_args()
    out = pathlib.Path(a.out)
    out.mkdir(parents=True, exist_ok=True)
    result, md = {}, ['# Literals that bypass the theme contract', '',
                      'Generated by `tool/parity-ext/literal-audit` (the `tool/ds-audit` scanner; generated files and `// ds-allow` lines excluded). '
                      'A literal renders the same in Raft, Elegant and Brutal.', '']
    for scope in ('packages/raft_ui/lib', 'apps/raft_flutter/lib'):
        doc = scan(scope)
        per = collections.defaultdict(collections.Counter)
        for f in doc['findings']:
            if f['allowed'] or f['file'].endswith('.g.dart'):
                continue
            per[f['file']][f['category']] += 1
        totals = collections.Counter()
        for c in per.values():
            totals.update(c)
        result[scope] = {'files': doc['scannedFiles'], 'totals': dict(totals),
                         'top': {title: sorted(((sum(c[k] for k in keys), f) for f, c in per.items() if any(c[k] for k in keys)), reverse=True)[:8]
                                 for title, keys in CATEGORIES}}
        md += [f'## {scope}', '', '| kind | categories | literals | files with the most |', '| --- | --- | --- | --- |']
        for title, keys in CATEGORIES:
            top = ', '.join(f"`{f.split('/')[-1]}` {n}" for n, f in result[scope]['top'][title][:5])
            md.append(f"| {title} | {', '.join(k.split('.')[1] for k in keys)} | {sum(totals[k] for k in keys)} | {top} |")
        md.append('')
    (out / 'literal-audit.json').write_text(json.dumps(result, indent=1))
    (out / 'literal-audit.md').write_text('\n'.join(md) + '\n')
    print(f'report {out / "literal-audit.md"}')


if __name__ == '__main__':
    main()
