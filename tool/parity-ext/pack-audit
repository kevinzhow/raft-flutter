#!/usr/bin/env python3
"""Static theme-pack audit (docs/parity.md "Theme isolation"): where do Elegant and Brutal silently inherit Raft?

  tool/parity-ext/pack-audit [--out DIR]

The built-in Elegant and Brutal packs `extends: raft` and write only the entries that differ (docs/theme-contract.md), so
every contract name they do not write resolves to the Raft value. That is the mechanism, not a bug; it is a leak exactly
when the original look had a different value (docs/theme-contract/values.json = the a57b9dab values) or when the Raft value
is a new-look surface the original never had. For every pack x mode this reports

  1. per tier (colours, palette, geometry, type, fonts, shadows, case transforms, options): contract names, written
     by the pack, inherited from Raft;
  2. colour roles checked against the original look: exact (written, equal), drift (written, differs), inherited-equal,
     LEAK (inherited from Raft and the original had another value);
  3. inherited colour roles the original never had (the Raft 0.7.1 names), with how many places in packages/raft_ui and
     apps/raft_flutter read them: a read in an Elegant / Brutal screen paints the Raft value;
  4. elevation (shadow) and type metrics against the original values;
  5. inherited type-scale slots and palette ramps.

Output: <out>/pack-audit.json and <out>/pack-audit.md. Reads the generated pack JSON strings; changes nothing.
"""
import argparse
import json
import pathlib
import re
import subprocess

ROOT = pathlib.Path(__file__).resolve().parents[2]
SRC = ROOT / 'packages/raft_theme/lib/src'
VALUES = ROOT / 'docs/theme-contract/values.json'
TIERS = ('colors', 'palette', 'geometry', 'type', 'font', 'fonts', 'shadows', 'case', 'options')


def load_pack(name):
    text = (SRC / f'{name}_pack.g.dart').read_text()
    return json.loads(re.search(r"r'''(.*)'''", text, re.S).group(1))


def rgba(value):
    """'#rrggbb', '#rrggbbaa', 'rgba(r g b / a)' -> (r, g, b, a 0..1) rounded, or None for references."""
    if not isinstance(value, str):
        return None
    m = re.fullmatch(r'#([0-9a-fA-F]{6})([0-9a-fA-F]{2})?', value)
    if m:
        h = m.group(1)
        return (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16), round(int(m.group(2), 16) / 255, 2) if m.group(2) else 1.0)
    m = re.fullmatch(r'rgba?\(\s*([\d.]+)\s+([\d.]+)\s+([\d.]+)\s*(?:/\s*([\d.]+))?\s*\)', value)
    if m:
        return (round(float(m.group(1))), round(float(m.group(2))), round(float(m.group(3))), round(float(m.group(4) or 1), 2))
    return None


def old_rgba(text):
    """values.json: '#141110' or '#141110 / 0.60'."""
    m = re.fullmatch(r'#([0-9a-fA-F]{6})(?:\s*/\s*([\d.]+))?', text.strip())
    if not m:
        return None
    h = m.group(1)
    return (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16), round(float(m.group(2) or 1), 2))


def close(a, b):
    return a is not None and b is not None and all(abs(x - y) <= (0.011 if i == 3 else 1) for i, (x, y) in enumerate(zip(a, b)))


def resolve(value, mode_values, raft_mode):
    """Colour value -> rgba, following a `{palette.x.y}` reference through the pack's then Raft's palette."""
    seen = 0
    while isinstance(value, str) and value.startswith('{') and seen < 6:
        key = value.strip('{}')
        name = 'palette-' + key.split('.', 1)[1].replace('.', '-') if key.startswith('palette.') else key
        value = mode_values.get('palette', {}).get(name) or raft_mode.get('palette', {}).get(name) or mode_values.get('colors', {}).get(name)
        seen += 1
    return rgba(value)


def usage(name):
    """Places that read a contract name: packages/raft_ui/lib + apps/raft_flutter/lib (quoted occurrences)."""
    out = subprocess.run(['grep', '-rlF', f"'{name}'", 'packages/raft_ui/lib', 'apps/raft_flutter/lib', '--include=*.dart'],
                         cwd=ROOT, capture_output=True, text=True).stdout.split()
    return [f for f in out if '.g.dart' not in f]


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--out', default=str(ROOT / 'build/pack-audit'))
    a = ap.parse_args()
    out = pathlib.Path(a.out)
    out.mkdir(parents=True, exist_ok=True)
    raft = load_pack('raft')
    old = json.loads(VALUES.read_text())
    old_roles = {r['role']: r for tier in old['tiers'].values() for r in tier}
    report, md = {}, ['# Theme pack audit: what Elegant and Brutal inherit from Raft', '',
                      'Generated by `tool/parity-ext/pack-audit` from the generated pack JSON '
                      '(`packages/raft_theme/lib/src/*_pack.g.dart`) and `docs/theme-contract/values.json` (the a57b9dab values).', '']
    for name in ('elegant', 'brutal'):
        pack = load_pack(name)
        for mode in ('light', 'dark'):
            pm, rm = pack['modes'][mode], raft['modes'][mode]
            key = f'{name}-{mode}'
            tiers = {}
            for tier in TIERS:
                raft_names, own = set(rm.get(tier, {})), set(pm.get(tier, {}))
                if not raft_names and not own:
                    continue
                tiers[tier] = {'raft': len(raft_names), 'written': len(own & raft_names), 'onlyHere': sorted(own - raft_names),
                               'inherited': sorted(raft_names - own)}
            colors = {'exact': 0, 'drift': [], 'inheritedEqual': 0, 'leak': [], 'unknownOld': 0}
            col = {'elegant-light': 'elegantLight', 'elegant-dark': 'elegantDark', 'brutal-light': 'brutal', 'brutal-dark': 'elegantDark'}[key]
            for role, row in old_roles.items():
                want = old_rgba(row[col])
                have_written = role in pm.get('colors', {})
                have = resolve(pm['colors'][role], pm, rm) if have_written else resolve(rm['colors'].get(role), rm, rm)
                if want is None or have is None:
                    colors['unknownOld'] += 1
                    continue
                same = close(have, want)
                entry = {'role': role, 'original': row[col], 'resolved': list(have)}
                if have_written and same:
                    colors['exact'] += 1
                elif have_written:
                    colors['drift'].append(entry)
                elif same:
                    colors['inheritedEqual'] += 1
                else:
                    colors['leak'].append(entry)
            new_names = sorted(n for n in tiers.get('colors', {}).get('inherited', []) if n not in old_roles)
            report[key] = {'tiers': tiers, 'colors': colors, 'inheritedNewColorRoles': new_names}
            md += [f'## {key}', '', '| tier | Raft names | written by the pack | inherited from Raft | only in the pack |', '| --- | --- | --- | --- | --- |']
            for tier, t in tiers.items():
                md.append(f"| {tier} | {t['raft']} | {t['written']} | {len(t['inherited'])} | {len(t['onlyHere'])} |")
            md += ['', f"Colour roles of the original look ({len(old_roles)} in values.json): exact {colors['exact']}, "
                       f"inherited and equal {colors['inheritedEqual']}, **written but different {len(colors['drift'])}**, "
                       f"**inherited from Raft and different {len(colors['leak'])}**, not comparable {colors['unknownOld']}.", '']
            for title, items in (('Written but differs from the original', colors['drift']), ('Inherited from Raft, original had another value', colors['leak'])):
                if items:
                    md += [f'{title}:', '', '| role | original | pack resolves to (r,g,b,a) |', '| --- | --- | --- |']
                    md += [f"| `{e['role']}` | {e['original']} | {tuple(e['resolved'])} |" for e in items]
                    md.append('')
    # Raft 0.7.1 names the original looks never had: who reads them
    names = sorted(set(report['elegant-light']['inheritedNewColorRoles']) | set(report['brutal-light']['inheritedNewColorRoles']))
    reads = {n: usage(n) for n in names}
    live = {n: f for n, f in reads.items() if f}
    md += ['## Raft-only colour roles (no original value) read by components', '',
           f'{len(names)} colour roles exist only in the Raft pack; Elegant and Brutal inherit all of them. '
           f'{len(live)} are read by at least one file, so a screen in Elegant / Brutal that reads one paints the Raft value:', '',
           '| role | files that read it |', '| --- | --- |']
    plumbing = ('raft_token_mapping.dart', 'ui_tokens.dart')  # the Raft mapping and the token accessors, not screens
    direct = {n: [x for x in f if x.split('/')[-1] not in plumbing] for n, f in live.items()}
    md[-2:] = ['| role | files that read it (accessors and the Raft mapping excluded) | read through accessors / mapping only |', '| --- | --- | --- |']
    md += [f"| `{n}` | {len(direct[n])}: " + ', '.join(f"`{x.split('/')[-1]}`" for x in direct[n][:4]) + (' ...' if len(direct[n]) > 4 else '')
           + f" | {'yes' if not direct[n] else ''} |" for n in sorted(live)]
    direct_readers = {n: fs for n, fs in direct.items() if fs}
    md += ['', 'Unread (inherited but unused): ' + ', '.join(f'`{n}`' for n in names if n not in live) + '', '']
    # elevation and type metrics
    md += ['## Elevation and type metrics against the original', '', 'Original values: `docs/theme-contract/values.json` `extra`.', '']
    for name in ('elegant', 'brutal'):
        pack = load_pack(name)
        for mode in ('light', 'dark'):
            pm = pack['modes'][mode]
            rm = raft['modes'][mode]
            missing_shadow = [k for k in rm.get('shadows', {}) if k not in pm.get('shadows', {})]
            type_missing = [k for k in rm.get('type', {}) if k not in pm.get('type', {})]
            md.append(f"- {name}-{mode}: shadows inherited {missing_shadow or 'none'}; type-scale slots inherited {len(type_missing)} of {len(rm.get('type', {}))} "
                      f"({', '.join(type_missing[:12])})")
    (out / 'pack-audit.json').write_text(json.dumps({'packs': report, 'directReaders': direct_readers}, indent=1))
    (out / 'pack-audit.md').write_text('\n'.join(md) + '\n')
    leaks = sum(len(v['colors']['leak']) + len(v['colors']['drift']) for v in report.values())
    print(f'{leaks} colour leak/drift entries; report {out / "pack-audit.md"}')


if __name__ == '__main__':
    main()
