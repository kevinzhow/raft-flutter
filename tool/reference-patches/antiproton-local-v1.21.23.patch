+/** Local test stack only: plain-http POST to the loopback antiproton (see getLocalAntiprotonOrigin). */
+function postLocalAntiproton(url: URL, input: Parameters<WebhookPost>[0]): Promise<WebhookPostResponse> {
+  const startedAt = performance.now();
+  const timing: WebhookPostTiming = { dnsMs: 0, socketReused: false };
+  return new Promise((resolve, reject) => {
+    const request = httpRequest(url, { method: "POST", headers: input.headers, timeout: input.timeoutMs }, (response) => {
+      timing.ttfbMs = Math.round(performance.now() - startedAt);
+      response.resume();
+      const retryAfter = response.headers["retry-after"];
+      resolve({ status: response.statusCode ?? 0, ...(typeof retryAfter === "string" ? { retryAfter } : {}), timing });
+    });
+    request.on("timeout", () => request.destroy(new Error("Webhook request timed out")));
+    request.on("error", (error) => reject(new WebhookPostError(error, { ...timing }, null)));
+    request.end(input.body);
+  });
+}
