+// Local fixture, state on the container's disk as upstream, tuned for a shared busy disk:
+// - checkpoint_frequency 5: a checkpoint (one fsynced SST per state table group, ~100 with
+//   the 54-object graph) every 5 barriers instead of every barrier. At 1 per barrier the
+//   bootstrap was fsync-bound and each view took minutes longer than the last. Reads see
+//   checkpointed data, so RW lags Postgres by up to ~5 s more.
+// - time_travel_retention_ms 0: nothing here reads AS OF. With the default 10 minutes the meta
+//   store rewrote ~22k hummock_epoch_to_version rows every 30 s.
+export const RISINGWAVE_CONFIG =
+  "[storage]\ncompactor_memory_limit_mb = 768\n[system]\ncheckpoint_frequency = 5\ntime_travel_retention_ms = 0\n";
 
