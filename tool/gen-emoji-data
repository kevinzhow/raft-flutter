#!/usr/bin/env python3
"""Generate the emoji-picker-react 4.19.1 data the Web SidebarSectionEmojiPicker renders.

  tool/gen-emoji-data --raft-source DIR   read the pinned package under
        DIR/node_modules/.pnpm/emoji-picker-react@4.19.1_*/node_modules/emoji-picker-react
        (emojis-en.json + the CategoryNav.svg sprite) and write
          packages/raft_ui/lib/src/emoji_data.g.dart       (categories, emoji, skin tones)
          packages/raft_ui/lib/src/emoji_nav_icons.g.dart  (category nav icons, part of icons.dart)
  tool/gen-emoji-data --check             exit 1 if either file is stale (needs --raft-source)

Stdlib only. The sprite is a 200x80 sheet of 20x20 cells (columns smileys, animals, food,
travel, activities, objects, symbols, flags, suggested, custom); the four rows are painted in
four colours: #868686 normal, #3371B7 dark active (row 1), #C0C0BF dark normal (row 2), #6AA9DD active (row 3).
"""
from __future__ import annotations

import argparse
import glob
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DATA_OUT = ROOT / 'packages/raft_ui/lib/src/emoji_data.g.dart'
ICONS_OUT = ROOT / 'packages/raft_ui/lib/src/emoji_nav_icons.g.dart'
CATEGORIES = ['smileys_people', 'animals_nature', 'food_drink', 'travel_places', 'activities', 'objects',
              'symbols', 'flags']
COLUMN = {'smileys_people': 0, 'animals_nature': 1, 'food_drink': 2, 'travel_places': 3, 'activities': 4,
          'objects': 5, 'symbols': 6, 'flags': 7, 'suggested': 8}
COLORS = {'#868686': 'normal', '#6AA9DD': 'active', '#C0C0BF': 'darkNormal', '#3371B7': 'darkActive'}
ROWS = {'normal': 0, 'darkActive': 1, 'darkNormal': 2, 'active': 3}  # sprite row of each colour
HEADER = '// GENERATED by tool/gen-emoji-data from emoji-picker-react 4.19.1; do not edit.\n'


def package_dir(raft_source: Path) -> Path:
    found = sorted(glob.glob(str(raft_source / 'node_modules/.pnpm/emoji-picker-react@4.19.1_*/node_modules/emoji-picker-react')))
    if not found:
        sys.exit('emoji-picker-react@4.19.1 not found under ' + str(raft_source))
    return Path(found[0])


def q(s: str) -> str:
    return "'" + s.replace('\\', '\\\\').replace("'", "\\'").replace('$', '\\$') + "'"


def emoji_source(pkg: Path) -> str:
    data = json.loads((pkg / 'src/data/emojis-en.json').read_text())['emojis']
    out = [HEADER, "import 'emoji_picker.dart' show RaftEmojiEntry;\n\n",
           '/// Emoji by category (emoji-picker-react order), `unified` code points, search words and\n',
           '/// the five skin-tone variants where the emoji has them.\n',
           'const raftEmojiByCategory = <String, List<RaftEmojiEntry>>{\n']
    for cat in CATEGORIES:
        out.append(f"  '{cat}': [\n")
        for e in data[cat]:
            words = ' '.join(e['n'])
            variants = e.get('v')
            tail = ', [' + ', '.join(q(v) for v in variants) + ']' if variants else ''
            out.append(f"    RaftEmojiEntry({q(e['u'])}, {q(words)}{tail}),\n")
        out.append('  ],\n')
    out.append('};\n')
    return ''.join(out)


def num(s: str) -> float:
    return float(s)


def icons_source(pkg: Path) -> str:
    svg = (pkg / 'src/components/navigation/svg/CategoryNav.svg').read_text()
    elems = []
    for m in re.finditer(r'<(path|ellipse)\b([^>]*?)/?>', svg, re.S):
        attrs = dict(re.findall(r'([\w-]+)="([^"]*)"', m.group(2)))
        kind = m.group(1)
        fill = attrs.get('fill', 'none').upper()
        stroke = attrs.get('stroke', 'none').upper()
        color = fill if fill != 'NONE' else stroke
        if color not in COLORS:
            continue
        if kind == 'ellipse':
            cx, cy, rx, ry = (num(attrs[k]) for k in ('cx', 'cy', 'rx', 'ry'))
            d = (f'M{cx - rx},{cy}a{rx},{ry} 0 1,0 {2 * rx},0a{rx},{ry} 0 1,0 {-2 * rx},0z')
            x, y = cx, cy
        else:
            d = re.sub(r'\s+', ' ', attrs['d']).strip()
            first = re.match(r'M\s*(-?[\d.]+)[ ,]*(-?[\d.]+)', d)
            x, y = num(first.group(1)), num(first.group(2))
        elems.append({'col': int(x // 20), 'row': COLORS[color], 'd': d, 'fill': fill != 'NONE',
                      'stroke': stroke != 'NONE', 'sw': attrs.get('stroke-width', '1')})
    out = [HEADER, "part of 'icons.dart';\n\n",
           '/// Category nav sprite cells of emoji-picker-react: `[column][state]` -> shapes\n',
           '/// `(path data, filled, stroked, stroke width)` in the 20-unit cell (cell-local coordinates).\n',
           'const _emojiNavColumns = <String, int>{\n']
    for name, col in COLUMN.items():
        out.append(f"  '{name}': {col},\n")
    out.append('};\n\n/// Sprite row (y origin / 20) of each state.\nconst _emojiNavRows = <String, int>{\n')
    for state, row in ROWS.items():
        out.append(f"  '{state}': {row},\n")
    out.append('};\n\nconst _emojiNavShapes = <int, Map<String, List<(String, bool, bool, double)>>>{\n')
    for col in range(10):
        out.append(f'  {col}: {{\n')
        for state in ('normal', 'active', 'darkNormal', 'darkActive'):
            shapes = [e for e in elems if e['col'] == col and e['row'] == state]
            if not shapes:
                continue
            out.append(f"    '{state}': [\n")
            for e in shapes:
                out.append(f"      ({q(e['d'])}, {str(e['fill']).lower()}, {str(e['stroke']).lower()}, {e['sw']}),\n")
            out.append('    ],\n')
        out.append('  },\n')
    out.append('};\n')
    return ''.join(out)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--raft-source', type=Path, required=True)
    ap.add_argument('--check', action='store_true')
    args = ap.parse_args()
    pkg = package_dir(args.raft_source)
    files = {DATA_OUT: emoji_source(pkg), ICONS_OUT: icons_source(pkg)}
    stale = [p for p, s in files.items() if not p.exists() or p.read_text() != s]
    if args.check:
        for p in stale:
            print('stale: ' + str(p.relative_to(ROOT)))
        return 1 if stale else 0
    for p, s in files.items():
        p.write_text(s)
        print('wrote ' + str(p.relative_to(ROOT)))
    return 0


if __name__ == '__main__':
    sys.exit(main())
