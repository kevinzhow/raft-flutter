#!/usr/bin/env python3
"""Verified Android deployment; updates preserve data, first installs require an explicit flag."""
import argparse
import datetime
import json
from pathlib import Path
import sys

from android_app import ROOT, SafetyError, sdk_tools, update, update_lock

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--device', required=True, help='explicit ADB serial')
parser.add_argument('--apk', type=Path, required=True, help='built ARM64 release APK')
parser.add_argument('--check-only', action='store_true', help='read-only preflight; do not install or launch')
parser.add_argument('--launch', action='store_true', help='launch only after all preservation checks pass')
parser.add_argument('--first-install', action='store_true', help='explicit first installation; reject any existing or retained package')
args = parser.parse_args()
stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')
receipt = ROOT / '.local/android-installs' / (stamp + '.json')


def record(report):
    receipt.parent.mkdir(parents=True, exist_ok=True)
    temporary = receipt.with_suffix('.tmp')
    temporary.write_text(json.dumps(report, indent=2) + '\n')
    temporary.replace(receipt)


try:
    with update_lock(args.device):
        result = update(args.apk.resolve(), args.device, sdk_tools(), record,
                        check_only=args.check_only, launch=args.launch, first_install=args.first_install)
except (SafetyError, OSError, ValueError) as error:
    report = json.loads(receipt.read_text()) if receipt.exists() else {}
    if report.get('status') != 'failed':
        report.update(status='failed' if report else 'blocked', error=str(error))
        record(report)
    sys.exit(f'STOP: {error}\nNo uninstall, data clear or automatic retry was performed.')
print(f"{result['status']}: version {result['apk']['version']}; receipt: {receipt}")
