# ---------------------------------------------------------------- pure parts


def fmt_duration(seconds):
    seconds = int(round(seconds))
    hours, rest = divmod(seconds, 3600)
    minutes, secs = divmod(rest, 60)
    if hours:
        return f'{hours}h{minutes:02d}m'
    return f'{minutes}m{secs:02d}s' if minutes else f'{secs}s'


def parse_test_events(lines, root=None):
    """Counts and failures from `dart test`'s JSON event stream (`--file-reporter json:`).

    Hidden entries (loading a file, setUpAll, tearDownAll) are never counted as passed, but a
    failing one is a failure: the leak report and a file that does not compile fail that way.
    """
    suites, tests, errors = {}, {}, {}
    passed = skipped = 0
    failed = []
    for raw in lines:
        try:
            event = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(event, dict):
            continue
        kind = event.get('type')
        if kind == 'suite':
            suites[event['suite']['id']] = event['suite'].get('path') or ''
        elif kind == 'testStart':
            test = event['test']
            tests[test['id']] = (test.get('suiteID'), test.get('name', ''))
        elif kind == 'error':
            errors.setdefault(event.get('testID'), (event.get('error') or '').strip())
        elif kind == 'testDone':
            suite_id, name = tests.get(event.get('testID'), (None, '?'))
            result = event.get('result')
            if event.get('skipped'):
                skipped += 1
            elif result == 'success':
                if not event.get('hidden'):
                    passed += 1
            else:
                path = suites.get(suite_id, '')
                if root and path.startswith(str(root)):
                    path = os.path.relpath(path, root)
                failed.append({'file': path.replace('\\', '/'), 'name': name,
                               'error': errors.get(event.get('testID'), '')})
    return {'passed': passed, 'skipped': skipped, 'failed': failed}


def failure_kind(failure):
    """'leak' for a leak_tracker report, 'compile' for a file that did not load, else 'test'."""
    text = failure['error']
    if 'contains leaks' in text or 'leak free' in text:
        return 'leak'
    if failure['name'].startswith('loading '):
        return 'compile'
    return 'test'


def first_line(text, limit=160):
    for line in text.splitlines():
        if line.strip():
            return line.strip()[:limit]
    return ''


def leak_classes(error):
    """Class names from a leak_tracker report: a `Name:` line whose next line is the object's `test:` field."""
    lines = [line.strip() for line in error.splitlines()]
    return [line[:-1] for line, following in zip(lines, lines[1:])
            if following.startswith('test:') and re.match(r'^[A-Za-z_][\w<>?, ]*:$', line)]


def area_of(path):
    """Coarse area of a repo-relative file: `app/features`, `raft_ui/src`, `raft_client/src/proxy`, ..."""
    parts = path.split('/')
    if len(parts) >= 4 and parts[0] == 'apps' and parts[2] == 'lib':
        return f'app/{parts[3]}' if len(parts) > 4 else 'app/(lib root)'
    if len(parts) >= 3 and parts[0] == 'packages' and parts[2] == 'lib':
        if len(parts) >= 5 and parts[3] == 'src':
            return f'{parts[1]}/{parts[4]}' if len(parts) > 5 else f'{parts[1]}/src'
        return f'{parts[1]}/(lib)'
    return None


def is_measured(path):
    """Library code only: lib/ of the app and packages, no tests or generated mirrors."""
    return area_of(path) is not None and not path.endswith('.g.dart')


def area_summary(coverage):
    """`{area: (hit, total)}` plus overall `(hit, total)` over measured files."""
    areas = collections.defaultdict(lambda: [0, 0])
    for path, lines in coverage.items():
        if not is_measured(path):
            continue
        area = area_of(path)
        areas[area][1] += len(lines)
        areas[area][0] += sum(1 for hits in lines.values() if hits > 0)
    total = (sum(v[0] for v in areas.values()), sum(v[1] for v in areas.values()))
    return {k: tuple(v) for k, v in areas.items()}, total


def least_covered_files(coverage, count=8, minimum=40):
    """Files with the most unexecuted lines (at least `minimum` instrumented lines)."""
    rows = []
    for path, lines in coverage.items():
        if is_measured(path) and len(lines) >= minimum:
            missed = sum(1 for hits in lines.values() if hits <= 0)
            rows.append((missed, len(lines), path))
    return sorted(rows, reverse=True)[:count]


def pct(hit, total):
    return '-' if not total else f'{100.0 * hit / total:.1f}%'


def parse_osv(report):
    """`{'packages', 'lockfiles', 'vulns': [{'lock','package','version','ids':[...]}]}` from `--format json --all-packages`."""
    packages, vulns, locks = 0, [], []
    for result in report.get('results') or []:
        lock = (result.get('source') or {}).get('path', '?')
        locks.append(lock)
        for entry in result.get('packages') or []:
            packages += 1
            found = entry.get('vulnerabilities') or []
            if found:
                vulns.append({'lock': lock, 'package': entry['package']['name'], 'version': entry['package']['version'],
                              'ids': sorted({v['id'] for v in found})})
    return {'packages': packages, 'lockfiles': locks, 'vulns': vulns}


OSV_BLIND_SPOTS = [
    ('Podfile.lock', 'macOS/iOS CocoaPods 依赖：osv-scanner 对 Podfile.lock 报 "could not determine extractor"'),
    ('build.gradle*', 'Android Gradle 依赖（build.gradle / build.gradle.kts）：没有 lockfile，不扫描'),
    ('打包进发行物的原生库', 'libmpv / ffmpeg / AppImage、Flatpak、Windows 安装包里的 .so/.dll：不是包管理器依赖，需 SBOM 或手工维护版本清单'),
    ('Dart SDK / Flutter 引擎', '工具链本身的漏洞不在 pubspec.lock 里'),
]


def blind_spot_files(tracked):
    """Dependency inputs in the tree that osv-scanner will not read."""
    pods = [f for f in tracked if f.endswith('Podfile.lock')]
    gradle = [f for f in tracked if re.search(r'(^|/)build\.gradle(\.kts)?$', f)]
    return {'Podfile.lock': pods, 'build.gradle*': gradle}


def pick_previous(base, date):
    """Newest `<date>/summary.json` strictly before `date` (YYYY-MM-DD names), or None."""
    candidates = sorted(p.name for p in pathlib.Path(base).glob('????-??-??') if p.name < date and (p / 'summary.json').is_file())
    return pathlib.Path(base) / candidates[-1] / 'summary.json' if candidates else None


def order_prs(prs, cached):
    """Uncached PRs first (they need a run), then cached; newest number first within each."""
    return sorted(prs, key=lambda p: (cached(p), -p['number']))


def cache_key(pr, base):
    return f"{pr['number']}-{pr['headRefOid'][:12]}-{base[:12]}"


def not_run_reason(data):
    """Why a section has no data. Never "无": a missing section on a run that did not finish is unknown, not nothing."""
    if data.get('skipped'):
        return data['skipped']
    if data.get('aborted'):
        return f"运行被中止，这一项没有跑到或没有跑完（{data['aborted']}）"
    return '原因未记录（运行可能未完成，状态未知）'


def render_summary(data):
    """The Chinese morning summary (markdown) from the run's data dict."""
    out = []
    add = out.append
    add(f"# 夜间质量报告 {data['date']}")
    add('')
    base = data.get('base') or {}
    add(f"- 基线：`{BASE_REF}` @ `{base.get('sha', '?')[:10]}`" + (f" — {base['subject']}" if base.get('subject') else ''))
    add(f"- 随机顺序 seed：`{data['seed']}`；开始 {data['started']}，用时 {fmt_duration(data['seconds'])}"
        + (f"，等 gate 锁 {fmt_duration(data['lock_wait'])}" if data.get('lock_wait') else ''))
    add('')

    tests = data.get('tests')
    cov = data.get('coverage')
    osv = data.get('osv')
    headline = []
    for key in ('skipped', 'aborted'):
        if data.get(key):
            headline.append(f"测试与覆盖率：**{data[key]}**")
    if tests:
        bad = sum(len(t['failed']) for t in tests)
        headline.append('测试全部通过' if not bad and all(t['ok'] for t in tests) else f'**测试有问题：{bad} 个失败**')
    if cov and cov.get('total'):
        delta = f"（较 {cov['previous_date']} {cov['delta']:+.2f} 个百分点）" if cov.get('delta') is not None else ''
        headline.append(f"lib 行覆盖 {pct(*cov['total'])}{delta}")
    if osv:
        headline.append('依赖漏洞：' + ('扫描失败' if osv.get('error') else f"**{len(osv['vulns'])} 个**" if osv['vulns'] else '0'))
    prs = data.get('prs')
    if prs:
        low = [p for p in prs if p.get('executable') and p['covered'] < p['executable']]
        headline.append(f'{len(prs)} 个开放 PR，{len(low)} 个有未执行的改动行')
    add('**一句话：** ' + '；'.join(headline) + '。' if headline else '**一句话：** 没有任务运行。')
    add('')

    add('## 1. 测试（随机顺序）')
    if not tests:
        add(f'- 未运行：{not_run_reason(data)}')
    else:
        add('')
        add('| 套件 | 通过 | 失败 | 跳过 | 用时 | 结果 |')
        add('|---|---|---|---|---|---|')
        for t in tests:
            state = '通过' if t['ok'] else ('**超时**' if t.get('timed_out') else '**失败**')
            add(f"| {t['name']} | {t['passed']} | {len(t['failed'])} | {t['skipped']} | {fmt_duration(t['seconds'])} | {state} |")
        add('')
        for t in tests:
            if t['ok']:
                continue
            if t.get('timed_out'):
                add(f"- {t['name']} 超过 {fmt_duration(t['limit'])} 被终止；日志 `{t['log']}`")
            elif not t['failed']:
                add(f"- {t['name']} 退出码 {t['code']} 但没有解析到失败用例；日志 `{t['log']}`")
            for kind, label in (('leak', '对象泄漏（leak_tracker）'), ('compile', '文件加载/编译失败'), ('test', '用例失败')):
                group = [f for f in t['failed'] if failure_kind(f) == kind]
                if not group:
                    continue
                add(f"- {t['name']} {label}：{len(group)}")
                for f in group[:12]:
                    detail = ', '.join(sorted(set(leak_classes(f['error'])))) if kind == 'leak' else first_line(f['error'])
                    add(f"  - `{f['file']}` {f['name']}" + (f" — {detail}" if detail else ''))
                if len(group) > 12:
                    add(f'  - …另有 {len(group) - 12} 个，见日志')
        if any(not t['ok'] for t in tests):
            add('')
            add(f"- 复现：`cd {APP} && ../../tool/flutter test --test-randomize-ordering-seed {data['seed']} test/`（整套；顺序相关的失败单文件跑不出来），"
                f"单文件用 `--test-randomize-ordering-seed {data['seed']} test/<file>`；seed 相同顺序相同。")
    add('')

    add('## 2. 覆盖率')
    if not cov:
        add(f'- 未运行：{not_run_reason(data)}')
    else:
        add(f"- lib 总行覆盖 **{pct(*cov['total'])}**（{cov['total'][0]}/{cov['total'][1]}；app + raft_ui/raft_client/raft_sync，`*.g.dart` 与测试不计）")
        add('')
        add('| 区域 | 覆盖 | 行 |')
        add('|---|---|---|')
        for area, (hit, total) in sorted(cov['areas'].items()):
            add(f'| {area} | {pct(hit, total)} | {hit}/{total} |')
        if cov.get('least'):
            add('')
            add('未执行行最多的文件：')
            for missed, total, path in cov['least']:
                add(f'- `{path}` 未执行 {missed}/{total}')
    add('')

    add('## 3. 开放 PR 的 diff 覆盖（改动行里没有任何测试执行过的）')
    if data.get('prs_note'):
        add(f"- {data['prs_note']}")
    if prs is None and not data.get('prs_note'):
        add(f'- 未运行：{not_run_reason(data)}')
    for p in prs or []:
        add(f"- **#{p['number']}** {p['title']}（`{p['branch']}` @ `{p['head'][:9]}`）：{p['status']}")
        for line in p.get('lines', []):
            add(f'  - {line}')
    add('')

    add('## 4. 依赖漏洞（osv-scanner）')
    if not osv:
        add('- 未运行' + (f'：{not_run_reason(data)}' if data.get('skipped') or data.get('aborted') else ''))
    elif osv.get('error'):
        add(f"- 扫描失败：{osv['error']}")
    else:
        add(f"- 扫描 {len(osv['lockfiles'])} 个 pubspec.lock，{osv['packages']} 个包：" + (f"**{len(osv['vulns'])} 个有漏洞**" if osv['vulns'] else '未发现漏洞'))
        for v in osv['vulns']:
            add(f"  - `{v['package']}` {v['version']}（{os.path.relpath(v['lock'], data['worktree']) if v['lock'].startswith(data['worktree']) else v['lock']}）：{', '.join(v['ids'])}")
        add('- osv-scanner 看不到：')
        for name, why in OSV_BLIND_SPOTS:
            files = (osv.get('blind') or {}).get(name)
            add(f"  - {name}：{why}" + (f"（树内 {len(files)} 个：{', '.join(files[:4])}{'…' if len(files) > 4 else ''}）" if files else ''))
    add('')

    add('## 5. 视觉回归（框架 / 页面 / 组件三级，快速子集）')
    nightly_visual.render(data.get('visual'), add)
    add('')

    add('## 6. 运行记录')
    for line in data.get('notes', []):
        add(f'- {line}')
    add(f"- 原始输出：`{data['out']}`")
    return '\n'.join(out) + '\n'


# ------------------------------------------------------------ process helpers


def log(message):
    print(f"[{datetime.datetime.now().strftime('%H:%M:%S')}] {message}", flush=True)


def run(cmd, cwd, log_path, timeout, env=None):
    """Run `cmd` in its own process group; on timeout kill that group (only what we started)."""
    started = time.monotonic()
    timed_out = False
    with open(log_path, 'ab') as out:
        out.write(f'$ {" ".join(map(str, cmd))}  (cwd {cwd})\n'.encode())
        out.flush()
        child = subprocess.Popen(cmd, cwd=cwd, env=env, stdout=out, stderr=subprocess.STDOUT, start_new_session=True)
        try:
            code = child.wait(timeout=max(1, timeout))
        except (subprocess.TimeoutExpired, BaseException) as error:
            # Timeout, or this script is being stopped (SIGTERM becomes SystemExit): end the child's group.
            timed_out = isinstance(error, subprocess.TimeoutExpired)
            for sig, grace in ((signal.SIGTERM, 30), (signal.SIGKILL, 10)):
                try:
                    os.killpg(child.pid, sig)
                except ProcessLookupError:
                    break
                try:
                    child.wait(timeout=grace)
                    break
                except subprocess.TimeoutExpired:
                    continue
            if not timed_out:
                raise
            code = child.poll() if child.poll() is not None else -9
    return {'code': code, 'timed_out': timed_out, 'seconds': time.monotonic() - started}


def git(args, cwd=REPO, check=True):
    done = subprocess.run(['git', *args], cwd=cwd, text=True, capture_output=True)
    if check and done.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)}: {done.stderr.strip() or done.stdout.strip()}")
    return done.stdout.strip()


class GateLock:
    """The shared flock the gate holds; polls until `wait_seconds` and gives up."""

    def __init__(self, path=GATE_LOCK):
        self.path = pathlib.Path(path)
        self.handle = None

    def acquire(self, wait_seconds, note, poll=5.0, sleep=time.sleep):
        import fcntl
        self.path.parent.mkdir(parents=True, exist_ok=True)
        handle = self.path.open('a+b')
        deadline = time.monotonic() + wait_seconds
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    handle.seek(0)
                    holder = ' '.join(handle.read().decode('utf-8', 'replace').split())
                    handle.close()
                    return False, holder or 'unknown'
                sleep(poll)
        handle.truncate(0)
        handle.write(note.encode())
        handle.flush()
        self.handle = handle
        return True, ''

    def release(self):
        if self.handle:
            self.handle.truncate(0)
            self.handle.close()
            self.handle = None


# ---------------------------------------------------------------- jobs


class Run:
    def __init__(self, args):
        self.args = args
        self.date = args.date
        self.out = pathlib.Path(args.out_dir) / args.date
        self.out.mkdir(parents=True, exist_ok=True)
        self.worktree = pathlib.Path(args.worktree)
        self.started = time.monotonic()
        self.deadline = self.started + args.max_hours * 3600
        self.tmp = pathlib.Path(f'/tmp/raft-nightly-tmp-{os.getpid()}')
        self.data = {'date': self.date, 'seed': args.seed, 'started': datetime.datetime.now().strftime('%H:%M'), 'worktree': str(self.worktree),
                     'out': str(self.out), 'notes': [], 'seconds': 0, 'lock_wait': 0}
        self.env = None

    def remaining(self):
        return self.deadline - time.monotonic()

    def note(self, text):
        self.data['notes'].append(text)
        log(text)

    # worktree
    def reset_worktree(self):
        log(f'fetch + reset worktree {self.worktree}')
        git(['fetch', '-q', 'origin'])
        registered = str(self.worktree) in git(['worktree', 'list', '--porcelain']).replace('worktree ', '').splitlines()
        if registered:
            git(['worktree', 'remove', '--force', str(self.worktree)])
        elif self.worktree.exists():
            raise RuntimeError(f'{self.worktree} exists but is not a worktree of this repository; remove it by hand')
        git(['worktree', 'prune'])
        git(['worktree', 'add', '--detach', str(self.worktree), BASE_REF])
        sha = git(['rev-parse', 'HEAD'], cwd=self.worktree)
        self.data['base'] = {'sha': sha, 'subject': git(['log', '-1', '--format=%s'], cwd=self.worktree)}
        self.base_sha = sha

    # osv
    def osv(self):
        binary = shutil.which('osv-scanner') or str(HOME / '.local/bin/osv-scanner')
        locks = sorted(f for f in git(['ls-files'], cwd=self.worktree).splitlines() if f.endswith('pubspec.lock'))
        result = {'lockfiles': [], 'packages': 0, 'vulns': []}
        try:
            if not locks:
                raise RuntimeError('no pubspec.lock in the tree')
            report = self.out / 'osv.json'
            cmd = [binary, 'scan', 'source', '--format', 'json', '--all-packages', '--output-file', str(report)]
            for lock in locks:
                cmd += ['-L', str(self.worktree / lock)]
            done = run(cmd, self.worktree, self.out / 'osv.log', 300)
            # osv-scanner exits 1 when it found vulnerabilities, 0 when clean; anything else is an error.
            if done['code'] not in (0, 1) or not report.is_file():
                raise RuntimeError(f"osv-scanner exited {done['code']}; see osv.log")
            result = parse_osv(json.loads(report.read_text()))
        except (RuntimeError, OSError, ValueError) as error:
            result['error'] = str(error)
        result['blind'] = blind_spot_files(git(['ls-files'], cwd=self.worktree).splitlines())
        self.data['osv'] = result

    # tests
    def test_env(self):
        self.tmp.mkdir(parents=True, exist_ok=True)
        env = dict(os.environ)
        env['TMPDIR'] = str(self.tmp)
        env.pop('RAFT_TEST_ALL_THEMES', None)
        # The suites below test the Raft look; the legacy looks (Elegant, Brutal) run in the legacy-looks suite
        # (tool/theme-suite), so nothing loses coverage overnight.
        env.pop('RAFT_TEST_MODES', None)
        env['RAFT_TEST_LOOKS'] = 'raft'
        # The nightly runs what the gate samples: every slow file (it passes test/ whole) and the
        # whole size x theme matrix of the tests that cut it on the gate (raftFullMatrix).
        env['RAFT_TEST_TIER'] = 'full'
        env['PATH'] = os.pathsep.join([str(HOME / '.local/bin'), '/usr/local/bin', '/usr/bin', '/bin', env.get('PATH', '')])
        return env

    def flutter(self, *args):
        return [sys.executable, str(self.worktree / 'tool/flutter'), *args]

    def pub_get(self, name):
        done = run(self.flutter('pub', 'get', '--enforce-lockfile'), self.worktree, self.out / f'{name}-pub-get.log', 900, self.env)
        # tool/raft_lints is outside the pub workspace with its own lockfile (check-project resolves it the same way).
        # The nightly does not run the lint rules, so a failure here is a note, not a stop.
        lints = self.worktree / 'tool/raft_lints'
        if done['code'] == 0 and (lints / 'pubspec.yaml').is_file():
            extra = run(self.flutter('pub', 'get', '--enforce-lockfile'), lints, self.out / f'{name}-raft-lints-pub-get.log', 900, self.env)
            if extra['code'] != 0:
                self.note(f'tool/raft_lints: pub get --enforce-lockfile failed ({name}); lint rules are not part of this run')
        return done['code'] == 0

    def run_suite(self, name, cwd, files, timeout, lcov, coverage_package=False, seed=None):
        events = self.out / f'{name}.events.json'
        log_path = self.out / f'{name}.log'
        for stale in (events, lcov):
            stale.unlink(missing_ok=True)
        cmd = self.flutter('test', '--no-pub', '-j', str(JOBS), '--coverage', '--coverage-path', str(lcov),
                           '--reporter', 'failures-only', '--file-reporter', f'json:{events}')
        if cwd.name != 'raft_theme':  # the engine package runs whole: its look-tagged files are engine tests
            cmd += LEGACY_TAG_EXCLUDES
        if coverage_package:
            cmd += ['--coverage-package', COVERAGE_PACKAGES]
        if seed is not None:
            cmd += ['--test-randomize-ordering-seed', str(seed)]
        cmd += files
        done = run(cmd, cwd, log_path, min(timeout, self.remaining()), self.env)
        lines = events.read_text(errors='replace').splitlines() if events.is_file() else []
        parsed = parse_test_events(lines, self.worktree)
        passed_marker = done['code'] == 0 and not parsed['failed'] and not done['timed_out']
        return {'name': name, 'code': done['code'], 'timed_out': done['timed_out'], 'seconds': done['seconds'], 'limit': timeout,
                'ok': passed_marker, 'log': log_path.name, **parsed, 'lcov': lcov, 'cwd': str(cwd.relative_to(self.worktree)) or '.'}

    def legacy_suite(self):
        """The legacy looks' Dart tests through `tool/theme-suite` (the visual part is job 4); same shape as `run_suite`."""
        out = self.out / 'theme-suite'
        lcov = self.out / 'legacy-looks.lcov'
        log_path = self.out / 'legacy-looks.log'
        lcov.unlink(missing_ok=True)
        limit = self.args.legacy_timeout_minutes * 60
        command = [sys.executable, str(self.worktree / 'tool/theme-suite'), '--look', 'all', '--tests-only', '--out', str(out),
                   '--coverage-path', str(lcov), '--jobs', str(JOBS)]
        done = run(command, self.worktree, log_path, min(limit, self.remaining()), self.env)
        events = out / 'dart-tests.events.json'
        lines = events.read_text(errors='replace').splitlines() if events.is_file() else []
        parsed = parse_test_events(lines, self.worktree)
        ok = done['code'] == 0 and not parsed['failed'] and not done['timed_out']
        return {'name': 'legacy-looks', 'code': done['code'], 'timed_out': done['timed_out'], 'seconds': done['seconds'], 'limit': limit,
                'ok': ok, 'log': log_path.name, **parsed, 'lcov': lcov, 'cwd': APP}

    def package_dirs(self):
        return [p for p in sorted((self.worktree / 'packages').glob('*')) if (p / 'test').is_dir() and (p / 'lib').is_dir()]

    def tests_job(self):
        app = self.worktree / APP
        suites = []
        files = self.args.app_tests or ['test/']
        suites.append(self.run_suite('app', app, files, self.args.app_timeout_minutes * 60, self.out / 'app.lcov', True, self.args.seed))
        if not self.args.skip_packages:
            for package in self.package_dirs():
                if self.remaining() < 120:
                    self.note(f'总时限将到，跳过 {package.name} 的测试')
                    break
                suites.append(self.run_suite(package.name, package, ['test/'], self.args.package_timeout_minutes * 60,
                                             self.out / f'{package.name}.lcov', False, self.args.seed))
        if self.remaining() < 300:
            self.note('总时限将到，跳过 legacy-looks（tool/theme-suite）')
        else:
            suites.append(self.legacy_suite())
        coverage = diff_coverage.load_coverage([f"{s['lcov']}:{s['cwd']}" for s in suites if pathlib.Path(s['lcov']).is_file()], self.worktree)
        areas, total = area_summary(coverage)
        previous, delta, previous_date = pick_previous(self.args.out_dir, self.date), None, None
        if previous:
            try:
                before = json.loads(previous.read_text()).get('coverage') or {}
                if before.get('total') and before['total'][1] and total[1]:
                    delta = 100.0 * total[0] / total[1] - 100.0 * before['total'][0] / before['total'][1]
                    previous_date = previous.parent.name
            except (OSError, ValueError):
                pass
        self.data['tests'] = [{k: v for k, v in s.items() if k not in ('lcov',)} for s in suites]
        self.data['coverage'] = {'total': list(total), 'areas': {k: list(v) for k, v in areas.items()},
                                 'least': least_covered_files(coverage), 'delta': delta, 'previous_date': previous_date}
        self.coverage = coverage

    # pull requests
    def open_prs(self):
        done = subprocess.run(['gh', 'pr', 'list', '--base', BASE_BRANCH, '--state', 'open', '--json', 'number,title,headRefName,headRefOid,isDraft',
                               '--limit', '50'], cwd=REPO, text=True, capture_output=True, timeout=120)
        if done.returncode != 0:
            raise RuntimeError(done.stderr.strip() or 'gh pr list failed')
        return json.loads(done.stdout)

    def prs_job(self):
        cache_dir = pathlib.Path(self.args.out_dir) / 'pr-cache'
        cache_dir.mkdir(parents=True, exist_ok=True)
        try:
            prs = self.open_prs()
        except (RuntimeError, OSError, ValueError, subprocess.TimeoutExpired) as error:
            self.data['prs'] = []
            self.data['prs_note'] = f'无法列出开放 PR：{error}'
            return
        results = []
        budget_end = time.monotonic() + self.args.pr_budget_minutes * 60

        def merge_base(pr):
            return git(['merge-base', BASE_REF, pr['headRefOid']], check=False)

        bases = {p['number']: merge_base(p) for p in prs}
        prs = [p for p in prs if bases[p['number']]]
        prs = order_prs(prs, lambda p: (cache_dir / f'{cache_key(p, bases[p["number"]])}.json').is_file())
        measured = 0
        for pr in prs:
            entry = {'number': pr['number'], 'title': pr['title'], 'branch': pr['headRefName'], 'head': pr['headRefOid']}
            key = cache_dir / f'{cache_key(pr, bases[pr["number"]])}.json'
            if key.is_file():
                try:
                    cached = json.loads(key.read_text())
                    cached['status'] = f"{cached['status']}（沿用 {cached['measured_on']} 的结果：head 与 merge-base 未变）"
                    results.append(cached)
                    continue
                except (OSError, ValueError):
                    pass
            if self.args.max_prs is not None and measured >= self.args.max_prs:
                entry.update(status='本次未测（--max-prs）', lines=[])
            elif budget_end - time.monotonic() < 300 or self.remaining() < 600:
                entry.update(status='本次未测：PR 预算/总时限用尽，明晚优先（未缓存者排前）', lines=[])
            else:
                measured += 1
                try:
                    entry.update(self.measure_pr(pr, bases[pr['number']], min(budget_end - time.monotonic(), self.args.pr_timeout_minutes * 60)))
                    entry['measured_on'] = self.date
                    if entry.get('cacheable'):
                        key.write_text(json.dumps(entry))
                except Exception as error:  # a PR must not end the night
                    entry.update(status=f'测量失败：{type(error).__name__}: {error}', lines=[])
            results.append(entry)
        self.data['prs'] = sorted(results, key=lambda p: p['number'])

    def measure_pr(self, pr, base, seconds):
        sha = pr['headRefOid']
        log(f"PR #{pr['number']} {pr['headRefName']} @ {sha[:9]}")
        git(['checkout', '-q', '--detach', '-f', sha], cwd=self.worktree)
        git(['clean', '-fdq'], cwd=self.worktree)
        diff = diff_coverage.git_diff(self.worktree, base, sha)
        changed = diff_coverage.parse_diff(diff)
        other = [f for f in git(['diff', '--name-only', f'{base}...{sha}'], cwd=self.worktree).splitlines() if not f.endswith('.dart')]
        if not changed:
            return {'status': '没有 Dart 改动', 'lines': [f'非 Dart 改动 {len(other)} 个文件，未被覆盖率衡量'] if other else [],
                    'executable': 0, 'covered': 0, 'cacheable': True}
        if not self.pub_get(f"pr{pr['number']}"):
            return {'status': 'pub get --enforce-lockfile 失败，未测', 'lines': [], 'cacheable': False}
        tests = affected_tests.affected_tests(set(changed), affected_tests.tracked_dart_sources(self.worktree), affected_tests.workspace_packages(self.worktree))
        coverage_parts, suites = [], []
        groups = collections.defaultdict(list)
        for test in tests:
            parts = test.split('/')
            groups[('apps/raft_flutter' if parts[0] == 'apps' else '/'.join(parts[:2]))].append(test)
        started = time.monotonic()
        for index, (package_dir, files) in enumerate(sorted(groups.items())):
            left = seconds - (time.monotonic() - started)
            if left < 120:
                break
            cwd = self.worktree / package_dir
            relative = [os.path.relpath(self.worktree / f, cwd).replace('\\', '/') for f in files]
            lcov = self.out / f"pr{pr['number']}-{index}.lcov"
            suite = self.run_suite(f"pr{pr['number']}-{cwd.name}", cwd, relative, left, lcov, package_dir == APP)
            suites.append(suite)
            if lcov.is_file():
                coverage_parts.append(f'{lcov}:{package_dir}')
        coverage = diff_coverage.load_coverage(coverage_parts, self.worktree) if coverage_parts else {}
        result = diff_coverage.diff_coverage(changed, coverage)
        failed = sum(len(s['failed']) for s in suites)
        incomplete = any(s['timed_out'] for s in suites) or len(suites) < len(groups)
        lines = [f"选中 {len(tests)} 个测试文件（可达改动文件的全部测试），改动 Dart 文件 {len(changed)} 个，可执行改动行 {result['executable']}"]
        if failed:
            lines.append(f'**选中的测试里有 {failed} 个失败**（PR 分支自身，日志 {", ".join(s["log"] for s in suites if s["failed"])}）')
        if incomplete:
            lines.append('**时间不够，部分测试未跑完，下面的“未执行”可能偏多**')
        test_code = [f for f in result['files'] if is_test_code(f['file'])]
        result['files'] = [f for f in result['files'] if not is_test_code(f['file'])]
        if test_code:
            lines.append(f'测试代码改动 {len(test_code)} 个文件（test/、integration_test/），不计入覆盖')
        for f in result['files']:
            if not f['loaded']:
                lines.append(f"`{f['file']}`：没有任何选中测试加载它（{f['changed']} 行改动）")
            elif f['uncovered']:
                lines.append(f"`{f['file']}`：{f['executable'] - len(f['uncovered'])}/{f['executable']}，未执行 {diff_coverage.line_ranges(f['uncovered'])}")
        if other:
            lines.append(f'另有 {len(other)} 个非 Dart 文件改动（资源/脚本/文档），不在覆盖率范围内')
        status = f"diff 覆盖 {result['covered']}/{result['executable']} = {diff_coverage.percent(result['covered'], result['executable']):.1f}%"
        return {'status': status, 'lines': lines, 'executable': result['executable'], 'covered': result['covered'],
                'cacheable': not failed and not incomplete}

    def visual_job(self):
        """Fast subset of the three-level visual suite (tool/nightly_visual.py); never ends the night."""
        source = nightly_visual.source_dir(HOME)
        if source is None:
            self.data['visual'] = {'error': '未运行：没有固定的 Web 源码检出（RAFT_PARITY_SOURCE 或 ~/.cache/raft-flutter/raft-source-23）'}
            return
        out = self.out / 'visual'
        env = nightly_visual.environment(self.env, source)
        env.setdefault('PARITY_TOOLCHAIN_PATHS', str(HOME / 'github/raft-flutter/.local/toolchain-paths.txt'))
        done = run(nightly_visual.command(self.worktree, out), self.worktree, self.out / 'visual.log',
                   min(self.args.visual_timeout_minutes * 60, self.remaining()), env)
        summary = out / 'regress-summary.json'
        if done['timed_out'] or not summary.is_file():
            self.data['visual'] = {'error': f"未完成：退出码 {done['code']}" + ('，超时' if done['timed_out'] else '') + '（见 visual.log）'}
            return
        previous = pick_previous(self.args.out_dir, self.date)
        before = None
        if previous:
            try:
                before = (json.loads(previous.read_text()).get('visual') or {}).get('scores')
            except (OSError, ValueError):
                before = None
        self.data['visual'] = nightly_visual.summarize(summary, before)

    def cleanup(self):
        shutil.rmtree(self.tmp, ignore_errors=True)
        for stale in pathlib.Path('/tmp').glob('raft-nightly-tmp-*'):
            match = re.search(r'-(\d+)$', stale.name)
            if match and not pid_alive(int(match.group(1))):
                shutil.rmtree(stale, ignore_errors=True)

    def write(self):
        self.data['seconds'] = time.monotonic() - self.started
        (self.out / 'summary.json').write_text(json.dumps(self.data, ensure_ascii=False, indent=1, default=str))
        (self.out / 'summary.md').write_text(render_summary(self.data), encoding='utf-8')


def is_test_code(path):
    """Changed lines under test/ or integration_test/ are not library code: never instrumented, never reported."""
    return bool(re.search(r'(^|/)(test|integration_test|test_driver)/', path))


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--date', default=datetime.date.today().isoformat())
    parser.add_argument('--out-dir', default=str(DEFAULT_OUT))
    parser.add_argument('--worktree', default=str(DEFAULT_WORKTREE))
    parser.add_argument('--seed', type=int, default=None)
    parser.add_argument('--lock-wait-minutes', type=float, default=120)
    parser.add_argument('--app-timeout-minutes', type=float, default=90)
    parser.add_argument('--package-timeout-minutes', type=float, default=20)
    parser.add_argument('--pr-budget-minutes', type=float, default=150)
    parser.add_argument('--pr-timeout-minutes', type=float, default=60)
    parser.add_argument('--max-hours', type=float, default=4.5)
    parser.add_argument('--max-prs', type=int, default=None, help='measure at most N uncached PRs')
    parser.add_argument('--app-tests', nargs='+', default=None, metavar='PATH', help='app test paths instead of test/ (reduced run)')
    parser.add_argument('--no-gate-lock', action='store_true', help='manual reduced runs only: do not take the gate lock (cron never passes this)')
    parser.add_argument('--skip-packages', action='store_true')
    parser.add_argument('--skip-prs', action='store_true')
    parser.add_argument('--skip-osv', action='store_true')
    parser.add_argument('--skip-visual', action='store_true', help='skip the visual regression job (tool/nightly_visual.py)')
    parser.add_argument('--visual-timeout-minutes', type=float, default=75)
    parser.add_argument('--legacy-timeout-minutes', type=float, default=60, help='the legacy looks Dart tests (tool/theme-suite --look all --tests-only)')
    args = parser.parse_args(argv)
    if args.seed is None:
        args.seed = random.SystemRandom().randrange(1, 2**31)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))  # run finally: kill the child group, release the lock, write the summary
    run_ = Run(args)
    data = run_.data
    lock = GateLock()
    try:
        run_.reset_worktree()
        if not args.skip_osv:
            run_.osv()
            log('osv done')
        note = f'branch=nightly-quality pid={os.getpid()} started={datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")} wt={run_.worktree}\n'
        log(f'waiting for the gate lock (up to {fmt_duration(args.lock_wait_minutes * 60)})')
        waited = time.monotonic()
        got, holder = (True, '') if args.no_gate_lock else lock.acquire(args.lock_wait_minutes * 60, note)
        data['lock_wait'] = time.monotonic() - waited
        if not got:
            data['skipped'] = f'skipped: gate busy（等了 {fmt_duration(data["lock_wait"])}，锁持有者：{holder}）'
            run_.note(data['skipped'])
        else:
            log('gate lock held')
            run_.env = run_.test_env()
            if not run_.pub_get('workspace'):
                data['skipped'] = 'skipped: pub get --enforce-lockfile 在基线上失败（见 workspace-pub-get.log）'
                run_.note(data['skipped'])
            else:
                run_.tests_job()
                if not args.skip_visual:
                    try:
                        run_.visual_job()
                    except Exception as error:  # the visual job must not end the night
                        data['visual'] = {'error': f'异常：{type(error).__name__}: {error}'}
                if args.skip_prs:
                    data['prs_note'] = '未运行：按参数跳过（--skip-prs）'
                else:
                    run_.prs_job()
    except BaseException as error:  # the summary is still written
        run_.note(f'异常中止：{type(error).__name__}: {error}')
        data['aborted'] = f'异常中止：{type(error).__name__}: {error}'
        if isinstance(error, (KeyboardInterrupt, SystemExit)):
            raise
    finally:
        lock.release()
        run_.cleanup()
        run_.write()
        log(f"summary: {run_.out / 'summary.md'}")


if __name__ == '__main__':
    main()
