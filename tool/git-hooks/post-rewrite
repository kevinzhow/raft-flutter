#!/bin/sh
# After a rebase (a rebase does not fire post-merge; amend is ignored): re-run
# `pub get --enforce-lockfile` where a pubspec.lock differs between the pre-rebase
# tip (ORIG_HEAD) and HEAD. Never fails the rebase. See tool/sync-pub-lock.
[ "$1" = "rebase" ] || exit 0
root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0
git rev-parse -q --verify ORIG_HEAD >/dev/null || exit 0
python=python3
command -v python3 >/dev/null 2>&1 || python=python
"$python" tool/sync-pub-lock ORIG_HEAD HEAD
exit 0
