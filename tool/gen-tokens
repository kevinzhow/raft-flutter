def sha256(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def verify_manifest():
    manifest = json.loads((SRC / 'manifest.json').read_text())
    bad = [rel for rel, meta in manifest['files'].items() if sha256(SRC / rel) != meta['sha256']]
    if bad:
        raise SystemExit(f'gen-tokens: vendored sources differ from manifest: {bad}. '
                         'Re-import with --import-sources instead of editing them.')
    return manifest


def import_sources(args):
    origins = {'raft-ui': args.raft_ui, 'raft-source': args.raft_source, 'tailwind': args.tailwind}
    if not args.tailwind and args.raft_source:
        pnpm = Path(args.raft_source) / 'node_modules/.pnpm'
        hits = sorted(pnpm.glob('tailwindcss@*/node_modules/tailwindcss'))
        origins['tailwind'] = str(hits[-1]) if hits else None
    manifest = json.loads((SRC / 'manifest.json').read_text()) if (SRC / 'manifest.json').exists() else {'files': {}}
    for key, rel in SOURCES.items():
        base, sub = IMPORT_ORIGINS[key]
        if not origins.get(base):
            raise SystemExit(f'gen-tokens: --import-sources needs the {base} directory')
        src = Path(origins[base]) / sub
        shutil.copyfile(src, SRC / rel)
        entry = manifest['files'].setdefault(rel, {})
        entry.update({'origin': f'{base}:{sub}', 'sha256': sha256(SRC / rel)})
    (SRC / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
    print('imported', ', '.join(SOURCES.values()))


