def emit_scale(m: Model):
    tv = m.theme_vars
    lines = ['/// Tailwind 4 @theme scale (tailwindcss 4.2.2 theme.css + raft-ui/product @theme),',
             f'/// converted to logical px at a {fmt_num(ROOT_FONT_SIZE)}px root font size.',
             'abstract final class RaftScale {']
    sp = parse_length(tv['--spacing'])
    lines += [f"  /// `--spacing: {tv['--spacing']}`. Utility `p-N` = N * spacing.",
              f'  static const double spacing = {fmt_double(sp)};',
              '  static double space(num step) => spacing * step;', '']

    def group(prefix):
        return [n for n in tv if n.startswith(prefix) and '--' not in n[len(prefix):]]
    for prefix, label in (('--radius-', 'radius'), ('--breakpoint-', 'breakpoint'), ('--container-', 'container'),
                          ('--blur-', 'blur')):
        names = group(prefix)
        lines.append(f'  static const Map<String, double> {label} = {{')
        for n in names:
            lines.append(f"    '{n[len(prefix):]}': {fmt_double(parse_length(tv[n]))}, // {tv[n]}")
        lines.append('  };')
    # text sizes with line heights
    lines.append('  /// `--text-{size}` font size and `--text-{size}--line-height` (absolute px).')
    lines.append('  static const Map<String, RaftTextStep> text = {')
    for n in [n for n in tv if re.fullmatch(r'--text-[a-z0-9]+', n)]:
        v = tv[n]
        if 'var(' in v:
            continue  # field/card-title metrics: per theme, see RaftThemeMetrics
        size = parse_length(v)
        lh_raw = tv.get(n + '--line-height')
        lh = eval_number(lh_raw) * size if lh_raw else None
        lines.append(f"    '{n[7:]}': RaftTextStep({fmt_double(size)}, {fmt_double(lh) if lh is not None else 'null'}), "
                     f"// {v} / {lh_raw}")
    lines.append('  };')
    lines.append('  static const Map<String, int> fontWeight = {')
    for n in [n for n in tv if n.startswith('--font-weight-') and 'var(' not in tv[n]]:
        lines.append(f"    '{n[14:]}': {int(float(tv[n]))},")
    lines.append('  };')
    lines.append('  /// `--leading-*` unitless line-height factors.')
    lines.append('  static const Map<String, double> leading = {')
    for n in [n for n in tv if n.startswith('--leading-')]:
        lines.append(f"    '{n[10:]}': {fmt_double(float(tv[n]))},")
    lines.append('  };')
    lines.append('  /// `--tracking-*` letter-spacing in em (multiply by font size).')
    lines.append('  static const Map<String, double> trackingEm = {')
    for n in [n for n in tv if n.startswith('--tracking-')]:
        lines.append(f"    '{n[11:]}': {fmt_double(parse_length(tv[n]))},")
    lines.append('  };')
    lines.append('  /// `--ease-*` timing functions.')
    lines.append('  static const Map<String, Cubic> ease = {')
    for n in [n for n in tv if n.startswith('--ease-')]:
        mm = re.fullmatch(r'cubic-bezier\(([^)]*)\)', tv[n])
        a = [fmt_double(float(x)) for x in mm.group(1).split(',')]
        lines.append(f"    '{n[7:]}': Cubic({', '.join(a)}),")
    lines.append('  };')
    d = tv['--default-transition-duration']
    mm = re.fullmatch(r'cubic-bezier\(([^)]*)\)', tv['--default-transition-timing-function'])
    lines.append(f'  /// `--default-transition-duration: {d}`')
    lines.append(f'  static const Duration defaultTransitionDuration = Duration(milliseconds: {int(float(d[:-2]))});')
    lines.append(f"  /// `--default-transition-timing-function: {tv['--default-transition-timing-function']}`")
    lines.append(f"  static const Cubic defaultTransitionCurve = Cubic({', '.join(fmt_double(float(x)) for x in mm.group(1).split(','))});")
    lines.append(f"  /// `--border-width-3: {tv['--border-width-3']}` (product @theme)")
    lines.append(f"  static const double borderWidth3 = {fmt_double(parse_length(tv['--border-width-3']))};")
    lines.append('}')
    lines += ['', '/// A Tailwind text step: font size and absolute line height (px).', '@immutable',
              'class RaftTextStep {', '  const RaftTextStep(this.fontSize, this.lineHeight);',
              '  final double fontSize;', '  final double? lineHeight;',
              '  /// Flutter `TextStyle.height` factor.', '  double? get height => lineHeight == null ? null : lineHeight! / fontSize;',
              '}']
    return lines


