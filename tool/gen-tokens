              '  /// `--sans-font` CSS stack.', '  final List<String> sansFontStack;',
              '  /// `--mono-font` CSS stack.', '  final List<String> monoFontStack;',
              '  final String headingFont;', '  final String sansFont;', '  final String monoFont;']
