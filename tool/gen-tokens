def readback(rgb, alpha):
    """Simulate a canvas getImageData() readback: premultiplied 8-bit storage."""
    a8 = int(math.floor(alpha * 255 + 0.5))
    if a8 == 255:
        return list(rgb), a8
    if a8 == 0:
        return [0, 0, 0], 0
    pm = [int(math.floor(c * a8 / 255 + 0.5)) for c in rgb]
    return [min(255, int(math.floor(p * 255 / a8 + 0.5))) for p in pm], a8


def oracle_report(m: Model = None):
    m = m or Model()
    rows = []
    for theme in THEMES:
        data = json.loads((ORACLE / f'{THEME_CSS[theme]}.json').read_text())
        for key, entry in data['tokens'].items():
            name = '--' + key
            if name not in m.scopes[theme].decls:
                rows.append({'theme': theme, 'token': key, 'status': 'missing'})
                continue
            c = m.color(theme, name)
            gen = list(c.bytes())
            want = entry['rgba']
            raw = max(abs(a - b) for a, b in zip(gen, want[:3]))
            sim, a8 = readback(gen, c.alpha)
            simd = max(abs(a - b) for a, b in zip(sim, want[:3]))
            rows.append({'theme': theme, 'token': key, 'generated': gen, 'alpha': c.alpha, 'oracle': want,
                         'rawDelta': raw, 'readbackDelta': simd, 'alphaByteDelta': abs(a8 - want[3]),
                         'srgb255': [round(v * 255, 3) for v in c.srgb()]})
    return rows


