def emit_metrics(m: Model):
    lines = [header(['foundation', 'fonts', 'styles', 'tailwind']),
             "import 'package:flutter/animation.dart';", "import 'package:flutter/foundation.dart';", '']
    metric = m.metric_names()
    lines += ['/// Per-theme non-colour axes: field + card-title metrics (foundation.css) and',
              '/// font stacks (fonts.css). [headingFont]/[sansFont]/[monoFont] are the bundled',
              '/// Flutter asset families for the first face of each CSS stack.',
              '@immutable', 'class RaftThemeMetrics {', '  const RaftThemeMetrics({']
    lines += [f'    required this.{camel(n)},' for n in metric]
    lines += ['    required this.headingFontStack,', '    required this.sansFontStack,', '    required this.monoFontStack,',
              '    required this.headingFont,', '    required this.sansFont,', '    required this.monoFont,', '  });']
    for n in metric:
