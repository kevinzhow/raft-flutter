    consumed by tool/recipes/gen_dart.mjs. Backdrops: every sampled surface of
    every theme scope (deduplicated), white/black/dark canvas required."""
    out = {}
    for src, scopes in sorted(m.oracle.get('literals', {}).items()):
        try:
            c = parse_color(src)
        except (ValueError, KeyError):
            continue
        if not 0 < c.alpha < 1:
            continue
        targets, seen = [], set()
        order = [*LITERAL_FIT_ORDER, *((t, b) for t, _ in ORACLE_SCOPES for b in ORACLE_BACKDROPS)]
        for t, b in order:
            d = m.backdrop_bytes(t)[b]
            if d in seen:
                continue
            seen.add(d)
            targets.append((d, scopes[t][b]))
        css_rgb = [min(255.0, max(0.0, v * 255)) for v in c.srgb()]
        misses, margin, a, chans = fit_translucent(targets, c.alpha, len(LITERAL_FIT_ORDER), css_rgb)
        out[src] = {'alpha': a, 'rgb': [round(x / 255, 6) for x in chans], 'cssAlpha': c.alpha,
                    'requiredMisses': misses[0], 'otherMisses': misses[1]}
    lines = ['{', '  "_comment": "GENERATED by tool/gen-tokens from tool/design-source/chrome-oracle.json — do not edit",']
    items = list(out.items())
    lines += [f'  {json.dumps(k)}: {json.dumps(v)}' + (',' if i < len(items) - 1 else '') for i, (k, v) in enumerate(items)]
    lines.append('}')
    return '\n'.join(lines) + '\n'


