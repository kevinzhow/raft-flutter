<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch window: the page-body colour of the theme (system day/night:
         white Brutal light, Elegant dark) so nothing jumps when the first
         Flutter frame replaces it. The chosen app icon
         is shown as a centred tile by the per-icon entry themes
         (raft_icon_styles.xml). -->
    <style name="RaftLaunchWindow" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:colorBackground">@color/raft_canvas_system_brutal</item>
        <item name="android:statusBarColor">@color/raft_canvas_system_brutal</item>
        <item name="android:navigationBarColor">@color/raft_canvas_system_brutal</item>
        <item name="android:windowLightStatusBar">@bool/raft_launch_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/raft_launch_light_bars</item>
    </style>
    <style name="LaunchTheme" parent="RaftLaunchWindow" />
    <!-- Flutter owns the final page and system-bar colors after first paint. -->
    <style name="NormalTheme" parent="RaftLaunchWindow" />
</resources>
