<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ renders its own launch window; windowBackground alone
         cannot configure it. Canvas background; the icon is the launching
         component's own icon (the active alias, or the application icon). -->
    <style name="RaftSystemSplash" parent="RaftLaunchWindow">
        <item name="android:windowSplashScreenBackground">@color/raft_canvas_system_brutal</item>
    </style>
    <style name="LaunchTheme" parent="RaftSystemSplash" />
</resources>
