# Build both genuine optional plugins, but do not link them into the runner.
function(raft_prepare_optional_registrant output)
  find_package(Python3 REQUIRED COMPONENTS Interpreter)
  set(generated "${CMAKE_BINARY_DIR}/raft_generated_plugin_registrant.cc")
  set(original "${CMAKE_SOURCE_DIR}/flutter/generated_plugin_registrant.cc")
  set(script "${CMAKE_SOURCE_DIR}/runner/generate_optional_registrant.py")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${script}")
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${script}" "${original}" "${generated}"
    RESULT_VARIABLE result ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Optional plugin registrant generation failed: ${error}")
  endif()
  set(${output} "${generated}" PARENT_SCOPE)
endfunction()

function(raft_unlink_optional_plugins runner)
  get_target_property(links ${runner} LINK_LIBRARIES)
  foreach(plugin IN ITEMS raft_system_webview_plugin media_kit_video_plugin)
    if(NOT TARGET ${plugin})
      message(FATAL_ERROR "The real optional backend is missing: ${plugin}")
    endif()
    list(FIND links ${plugin} index)
    if(index EQUAL -1)
      message(FATAL_ERROR "Generated optional plugin linkage drifted: ${plugin}")
    endif()
    list(REMOVE_ITEM links ${plugin})
    # A link-free runner still builds and installs the full original backend.
    add_dependencies(${runner} ${plugin})
  endforeach()
  set_property(TARGET ${runner} PROPERTY LINK_LIBRARIES "${links}")
  target_link_libraries(${runner} PRIVATE ${CMAKE_DL_LIBS})
endfunction()
